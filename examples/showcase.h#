fn fizzbuzz(n: int) -> string is
    if n % 15 == 0 is return "FizzBuzz" end
    if n % 3  == 0 is return "Fizz"     end
    if n % 5  == 0 is return "Buzz"     end
    return to_string(n)
end

fn collatz(n: int) -> int is
    let mut x:     int = n
    let mut steps: int = 0
    while x != 1 is
        if x % 2 == 0 is
            x = x / 2
        else is
            x = x * 3 + 1
        end
        steps += 1
    end
    return steps
end

fn is_prime(n: int) -> bool is
    if n < 2 is return false end
    let mut i: int = 2
    while i * i <= n is
        if n % i == 0 is return false end
        i += 1
    end
    return true
end

fn sum_range(lo: int, hi: int) -> int is
    let mut s: int = 0
    for i in lo..=hi is
        s += i
    end
    return s
end

fn demo_flow() is
    write("── 5. Kontrola przepływu ────────────────────────────")

    let mut line: string = "  "
    for i in 1..=20 is
        line = line + fizzbuzz(i) + " "
    end
    write(line)

    write("  collatz(27) = " + to_string(collatz(27)) + " kroków")
    write("  Σ(1..100)   = " + to_string(sum_range(1, 100)))

    ;; pierwsze 10 liczb pierwszych
    let mut primes: string = "  pierwsze: "
    let mut found: int = 0
    let mut n:     int = 2
    while found < 10 is
        if is_prime(n) is
            primes = primes + to_string(n) + " "
            found += 1
        end
        n += 1
    end
    write(primes)

    ;; match tuple
    let x: int = 7
    let y: int = 3
    let rel: string = match (x > y, x == y) is
        (true,  false) => "x > y"
        (false, false) => "x < y"
        (false, true)  => "x == y"
        _              => "?"
    end
    write("  7 vs 3: " + rel)

    write("")
end

