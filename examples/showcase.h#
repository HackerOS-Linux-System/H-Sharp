enum Color is
    Red
    Green
    Blue
    Rgb(int, int, int)
    Named(string)
end

fn color_hex(c: Color) -> string is
    match c is
        Color::Red           => "#FF0000"
        Color::Green         => "#00FF00"
        Color::Blue          => "#0000FF"
        Color::Rgb(r, g, b)  => "#" + to_hex(r) + to_hex(g) + to_hex(b)
        Color::Named(s)      => s
    end
end

enum Maybe<T> is
    Some(T)
    None
end

fn safe_div(a: f64, b: f64) -> Maybe<f64> is
    if b == 0.0 is
        return Maybe::None
    end
    return Maybe::Some(a / b)
end

fn demo_enums() is
    write("── 3. Enums i match ─────────────────────────────────")

    write("  Red          : " + color_hex(Color::Red))
    write("  Rgb(64,0,128): " + color_hex(Color::Rgb(64, 0, 128)))
    write("  Named(#abc)  : " + color_hex(Color::Named("#aabbcc")))

    let r1: Maybe<f64> = safe_div(10.0, 3.0)
    let r2: Maybe<f64> = safe_div(10.0, 0.0)

    match r1 is
        Maybe::Some(v) => write("  10/3 = " + to_string(v))
        Maybe::None    => write("  10/3 = błąd")
    end

    match r2 is
        Maybe::Some(v) => write("  10/0 = " + to_string(v))
        Maybe::None    => write("  10/0 = dzielenie przez zero")
    end

    write("")
end

