struct Pair<A, B> is
    pub first:  A
    pub second: B
end

fn pair<A, B>(a: A, b: B) -> Pair<A, B> is
    return Pair { first: a, second: b }
end

fn pair_str_int(p: Pair<string, int>) -> string is
    return "(" + p.first + ", " + to_string(p.second) + ")"
end

fn clamp(val: f64, lo: f64, hi: f64) -> f64 is
    if val < lo is return lo end
    if val > hi is return hi end
    return val
end

fn lerp(a: f64, b: f64, t: f64) -> f64 is
    return a + (b - a) * clamp(t, 0.0, 1.0)
end

fn demo_generics() is
