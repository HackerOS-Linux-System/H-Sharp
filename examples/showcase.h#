;; 10. OPERACJE BITOWE I CRYPTO
;; ══════════════════════════════════════════════════════════════

fn rol64(x: u64, n: int) -> u64 is
    return (x << n) | (x >> (64 - n))
end

fn xor_byte(data: bytes, key: u8) -> bytes is
    unsafe arena(4096) is
        let mut res: bytes = data
        let n: int = bytes_len(data)
        let mut i: int = 0
        while i < n is
            res[i] = data[i] ^ key
            i += 1
        end
        return res
    end
end

fn demo_bitwise() is
    write("── 10. Bitowe i crypto ──────────────────────────────")

    let a: u64 = 0xDEAD_BEEF_0000_0001
    let b: u64 = 0x1234_5678_9ABC_DEF0

    write("  a XOR b   = 0x" + to_hex(a ^ b))
    write("  a AND b   = 0x" + to_hex(a & b))
    write("  a OR  b   = 0x" + to_hex(a | b))
    write("  a << 4    = 0x" + to_hex(a << 4))
    write("  ROL64(a,8)= 0x" + to_hex(rol64(a, 8)))

    let plain:  bytes = b"H# crypto v0.8"
    let cipher: bytes = xor_byte(plain, 0x42)
    let back:   bytes = xor_byte(cipher, 0x42)
    write("  XOR 0x42: encrypt+decrypt OK")

    let hash: string = sha::sha256_hex("HackerOS v0.8")
    write("  SHA-256('HackerOS v0.8'):")
    write("    " + hash)

    write("")
end

