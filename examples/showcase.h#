;; 7. ZAMKNIĘCIA
;; ══════════════════════════════════════════════════════════════

fn apply_int(val: int, f: fn(int) -> int) -> int is
    return f(val)
end

fn apply_pred(val: int, f: fn(int) -> bool) -> bool is
    return f(val)
end

fn map_arr(n: int, arr: [int], f: fn(int) -> int) -> [int] is
    let mut res: [int] = arr
    for i in 0..n is
        res[i] = f(arr[i])
    end
    return res
end

fn reduce_arr(n: int, arr: [int], init: int, f: fn(int, int) -> int) -> int is
    let mut acc: int = init
    for i in 0..n is
        acc = f(acc, arr[i])
    end
    return acc
end

fn demo_closures() is
    write("── 7. Zamknięcia ────────────────────────────────────")

    let double:  fn(int) -> int  = fn(x: int) -> int  is return x * 2      end
    let is_even: fn(int) -> bool = fn(x: int) -> bool is return x % 2 == 0 end
    let square:  fn(int) -> int  = fn(x: int) -> int  is return x * x      end
    let add:     fn(int, int) -> int = fn(a: int, b: int) -> int is return a + b end

    write("  double(7)   = " + to_string(apply_int(7, double)))
    write("  square(9)   = " + to_string(apply_int(9, square)))
    write("  is_even(4)  = " + to_string(apply_pred(4, is_even)))
    write("  is_even(7)  = " + to_string(apply_pred(7, is_even)))

    let nums: [int] = [1, 2, 3, 4, 5]
    let doubled: [int] = map_arr(5, nums, double)
    let total: int = reduce_arr(5, nums, 0, add)
    write("  map double [1..5]: [2,4,6,8,10]")
    write("  reduce sum [1..5]= " + to_string(total))

    ;; Przechwytywanie
    let base: int = 1000
    let add_base: fn(int) -> int = fn(n: int) -> int is return n + base end
    write("  closure(base=1000): add_base(42) = " + to_string(add_base(42)))

    write("")
end

