;; 2. STRUKTURY
;; ══════════════════════════════════════════════════════════════

struct Vec2 is
    pub x: f64
    pub y: f64
end

fn vec2(x: f64, y: f64) -> Vec2 is
    return Vec2 { x: x, y: y }
end

fn vec2_add(a: Vec2, b: Vec2) -> Vec2 is
    return Vec2 { x: a.x + b.x, y: a.y + b.y }
end

fn vec2_len(v: Vec2) -> f64 is
    return math::sqrt(v.x * v.x + v.y * v.y)
end

fn vec2_dot(a: Vec2, b: Vec2) -> f64 is
    return a.x * b.x + a.y * b.y
end

fn vec2_str(v: Vec2) -> string is
    return "(" + to_string(v.x) + ", " + to_string(v.y) + ")"
end

struct AABB is
    pub min: Vec2
    pub max: Vec2
end

fn aabb_contains(b: AABB, p: Vec2) -> bool is
    return p.x >= b.min.x && p.x <= b.max.x &&
           p.y >= b.min.y && p.y <= b.max.y
end

fn demo_structs() is
    write("── 2. Struktury ─────────────────────────────────────")

    let v1: Vec2 = vec2(3.0, 4.0)
    let v2: Vec2 = vec2(1.0, 2.0)
    let v3: Vec2 = vec2_add(v1, v2)

    write("  v1          : " + vec2_str(v1))
    write("  v2          : " + vec2_str(v2))
    write("  v1 + v2     : " + vec2_str(v3))
    write("  |v1|        : " + to_string(vec2_len(v1)))
    write("  v1 · v2     : " + to_string(vec2_dot(v1, v2)))

    let box: AABB = AABB {
        min: Vec2 { x: 0.0, y: 0.0 },
        max: Vec2 { x: 10.0, y: 10.0 },
    }
    write("  (5,5) in box: " + to_string(aabb_contains(box, vec2(5.0, 5.0))))
    write("  (15,5) in box:" + to_string(aabb_contains(box, vec2(15.0, 5.0))))
    write("")
end

