[package]
-> name        => editions-demo
-> version     => 0.1.0
-> description => Project-level edition + minimum toolchain
-> license     => MIT
-> lang        => h#

! Read ONLY because `lang => h#` (ignored for hl / hs).
!   edition   : default edition for files without `using "<year>"`
!   toolchain : minimum H#  — `h# --version` must report this or NEWER (older = error)
[edition]
-> edition   => 2026
-> toolchain => 0.9

[layout]
-> src => src

[dependencies]
! The library keeps ITS OWN [edition] (see libs/shapes/Bit.hk) — it is not
! forced onto this project's edition, nor the other way round.
-> shapes => path libs/shapes
