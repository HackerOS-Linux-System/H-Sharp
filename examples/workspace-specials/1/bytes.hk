! H# SPECIAL workspace — eiv scanner suite
! ─────────────────────────────────────────────────
! Budowanie:   bytes build          (z katalogu workspace-special/)
! Uruchomienie: bytes run --file eiv/src/main.h#
!
! Kolejność: shared-types (.a) → core-net (.so) → analysis (.so) → web3 → eiv

[workspace]
-> name    => eiv-suite
-> version => 0.8.0
-> mode    => special
-> members => ["shared-types", "core-net", "analysis", "web3", "eiv"]
-> languages
--> eiv          => h#
--> shared-types => h#
--> core-net     => c++
--> analysis     => rust
--> web3         => odin

[build]
-> parallel    => false
-> cache       => .cache/
-> build-order => ["shared-types", "core-net", "analysis", "web3", "eiv"]

[meta]
-> description => "eiv — specialized recon scanner for SCADA/IoT/Web3"
-> author      => "HackerOS"
