#!/usr/bin/hl
/// Ustawianie środowiska Rusta (rustup + wasm target)
using <gen 2>

~> ==> Ustawianie ścieżek dla Rusta...

;; Załaduj cargo env jeśli istnieje
> test -f /home/mkaczmarzyk/.cargo/env
? ok
    > . /home/mkaczmarzyk/.cargo/env
done

;; Dodaj cargo do PATH
=> PATH = /home/mkaczmarzyk/.cargo/bin:$PATH

;; Sprawdź czy rustup jest dostępny
::which rustup
? err
    ~> BŁĄD: Narzędzie rustup nadal nie jest dostępne w PATH.
    > exit 1
done

~> ==> Ustawianie domyślnego toolchaina (stable)...
> rustup default stable
? err
    ~> Błąd podczas ustawiania toolchaina stable
    > exit 1
done

~> ==> Dodawanie targetu wasm32-unknown-unknown...
> rustup target add wasm32-unknown-unknown
? err
    ~> Błąd podczas dodawania targetu wasm32-unknown-unknown
    > exit 1
done

~> ==> Gotowe! Możesz teraz uruchomić kompilację projektu.
