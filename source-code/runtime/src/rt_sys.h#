use "std -> env" from "env"

mod rt_os
mod rt_num
mod rt_ptr

extern static [c] is
    fn getpid() -> int
    fn getppid() -> int
    fn getuid() -> int
    fn getgid() -> int
    fn isatty(fd: int) -> int
    fn sysconf(name: int) -> int
    fn time(t: int) -> int
    fn uname(buf: int) -> int
    fn statvfs(path: string, buf: int) -> int
    fn getpwuid(uid: int) -> int
    fn clock_gettime(clk: int, buf: int) -> int
