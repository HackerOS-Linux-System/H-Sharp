;; hsh_getpid / hsh_proc_id
pub fn pid() -> int is return getpid() end
;; hsh_sys_get_ppid / get_uid / get_gid
pub fn ppid() -> int is return getppid() end
pub fn uid() -> int is return getuid() end
pub fn gid() -> int is return getgid() end
;; hsh_os_is_root
pub fn is_root() -> bool is return getuid() == 0 end

;; hsh_sys_page_size: sysconf(_SC_PAGE_SIZE) (30 on Linux), 4096 when unknown
pub fn page_size() -> int is
    let sz: int = sysconf(30)
    if sz > 0 is return sz end
    return 4096
end

;; hsh_sys_is_64bit / hsh_sys_is_little_endian: H# targets are 64-bit little-endian only (int is 64-bit, no BE target)
pub fn is_64bit() -> bool is return true end
pub fn is_little_endian() -> bool is return true end

;; hsh_env_home / hsh_os_home_dir
pub fn home_dir() -> string is
    return env::get("HOME")
end

;; hsh_os_temp_dir: $TMPDIR, else /tmp
pub fn temp_dir() -> string is
    let t: string = env::get("TMPDIR")
    if t.len() == 0 is return "/tmp" end
    return t
end

;; hsh_term_is_tty (stdout)
pub fn stdout_is_tty() -> bool is return isatty(1) != 0 end

;; hsh_now_unix
pub fn now_unix() -> int is return time(0) end

;; ── /proc and uname based information (core.c hsh_sys_*) ──
;; value of the first line starting with `key`, parsed like strtoll (leading blanks, digits); 0 when absent
fn meminfo_kb(key: string) -> int is
    let lines: [string] = __builtin_str_split(rt_os::read_stream("/proc/meminfo"), "\n")
    let mut i: int = 0
    while i < lines.len() is
        if rt_str::starts_with(lines[i], key) is
            let rest: string = lines[i][key.len()..lines[i].len()]
            let mut j: int = 0
            while j < rest.len() && (byte_at(rest, j) == 32 || byte_at(rest, j) == 9) is j += 1 end
            let mut v: int = 0
            while j < rest.len() && byte_at(rest, j) >= 48 && byte_at(rest, j) <= 57 is
                v = v * 10 + (byte_at(rest, j) - 48)
                j += 1
            end
            return v
        end
        i += 1
    end
    return 0
end

;; core.c hsh_sys_memory_total / hsh_sys_memory_free (MemAvailable), in bytes
pub fn memory_total() -> int is return meminfo_kb("MemTotal:") * 1024 end
pub fn memory_free() -> int is return meminfo_kb("MemAvailable:") * 1024 end

;; core.c hsh_sys_cpu_count: lines of /proc/cpuinfo starting with "processor" (at least 1)
pub fn cpu_count() -> int is
    let lines: [string] = __builtin_str_split(rt_os::read_stream("/proc/cpuinfo"), "\n")
    let mut n: int = 0
    let mut i: int = 0
    while i < lines.len() is
        if rt_str::starts_with(lines[i], "processor") is n += 1 end
        i += 1
    end
    if n > 0 is return n end
    return 1
end

;; first whitespace-delimited field of a /proc file ("" if unreadable)
fn first_field(path: string) -> string is
    let t: string = rt_os::read_stream(path)
    let mut i: int = 0
    while i < t.len() && (byte_at(t, i) == 32 || byte_at(t, i) == 9 || byte_at(t, i) == 10) is i += 1 end
    let mut e: int = i
    while e < t.len() && byte_at(t, e) != 32 && byte_at(t, e) != 9 && byte_at(t, e) != 10 is e += 1 end
    return t[i..e]
end

;; core.c hsh_sys_uptime: whole seconds of /proc/uptime's first field (0 when unreadable)
pub fn uptime() -> int is
    let f: string = first_field("/proc/uptime")
    let mut v: int = 0
    let mut i: int = 0
    while i < f.len() && byte_at(f, i) >= 48 && byte_at(f, i) <= 57 is
        v = v * 10 + (byte_at(f, i) - 48)
        i += 1
    end
    return v
end

;; core.c hsh_sys_load_avg: 1-minute load average (0.0 when unreadable)
pub fn load_avg() -> f64 is
    let f: string = first_field("/proc/loadavg")
    if f.len() == 0 is return 0.0 end
    return rt_num::to_float(f)
end

;; uname(2): struct utsname = 6 fields of 65 bytes (sysname, nodename, release, version, machine, domainname)
fn uname_field(which: int) -> string is
    let buf: int = rt_ptr::buf_new(390)
    let mut out: string = ""
    if uname(buf) == 0 is out = strdup(buf + which * 65) end
    rt_ptr::buf_free(buf)
    return out
end

;; core.c hsh_sys_sysname / machine / kernel_version (release); hsh_hostname = gethostname = the nodename field
pub fn sysname() -> string is return uname_field(0) end
pub fn machine() -> string is return uname_field(4) end
pub fn kernel_version() -> string is return uname_field(2) end
pub fn hostname() -> string is return uname_field(1) end

;; statvfs: f_frsize at 8, f_blocks 16, f_bavail 32 (x86-64 Linux, glibc and musl)
fn statvfs_field(path0: string, off: int) -> int is
    let mut path: string = path0
    if path.len() == 0 is path = "/" end
    let buf: int = rt_ptr::buf_new(112)
    let mut out: int = 0
    if statvfs(path, buf) == 0 is
        out = rt_ptr::ptr_read_i64(buf, off) * rt_ptr::ptr_read_i64(buf, 8)
    end
    rt_ptr::buf_free(buf)
    return out
end
;; core.c hsh_sys_disk_free (f_bavail * f_frsize) / hsh_sys_disk_total (f_blocks * f_frsize); 0 on error, "" means "/"
pub fn disk_free(path: string) -> int is return statvfs_field(path, 32) end
pub fn disk_total(path: string) -> int is return statvfs_field(path, 16) end

;; core.c hsh_username: $USER, else $LOGNAME, else the passwd name of the uid ("" if none)
pub fn username() -> string is
    let u: int = getenv("USER")
    if u != 0 && rt_ptr::peek_byte(u) != 0 is return strdup(u) end
    let l: int = getenv("LOGNAME")
    if l != 0 && rt_ptr::peek_byte(l) != 0 is return strdup(l) end
    let pw: int = getpwuid(getuid())
    if pw == 0 is return "" end
    let name: int = rt_ptr::ptr_read_ptr(pw, 0)
    if name == 0 is return "" end
    return strdup(name)
end

;; core.c hsh_now_ms: CLOCK_REALTIME as milliseconds (struct timespec: tv_sec at 0, tv_nsec at 8)
pub fn now_ms() -> int is
    let buf: int = rt_ptr::buf_new(16)
    clock_gettime(0, buf)
    let ms: int = rt_ptr::ptr_read_i64(buf, 0) * 1000 + rt_ptr::ptr_read_i64(buf, 8) / 1000000
    rt_ptr::buf_free(buf)
    return ms
end

;; core.c hsh_getcwd ("" on error)
pub fn getcwd_s() -> string is
    let buf: int = rt_ptr::buf_new(4096)
    let mut out: string = ""
    if getcwd(buf, 4096) != 0 is out = strdup(buf) end
    rt_ptr::buf_free(buf)
    return out
end

;; core.c hsh_term_width / hsh_term_height: TIOCGWINSZ (0x5413) on /dev/tty; 80x24 without a terminal.  winsize = u16 row, col, ...
fn term_size() -> [int] is
    let mut out: [int] = [24, 80]
    let fd: int = open("/dev/tty", 0)
    if fd >= 0 is
        let ws: int = rt_ptr::buf_new(8)
        if ioctl(fd, 21523, ws) == 0 is
            let row: int = rt_ptr::ptr_read_i16(ws, 0)
            let col: int = rt_ptr::ptr_read_i16(ws, 2)
            if row > 0 && col > 0 is
                out[0] = row
                out[1] = col
            end
        end
        rt_ptr::buf_free(ws)
        close(fd)
    end
    return out
end
pub fn term_width() -> int is return term_size()[1] end
pub fn term_height() -> int is return term_size()[0] end

;; core.c hsh_env_args: the process arguments, program name first.  The C hands out argv; on Linux /proc/self/cmdline is the same
;; NUL-separated list, so it is read from there (as bytes: an empty argument is two NULs in a row).
pub fn env_args() -> [string] is
    let mut out: [string] = []
    let f: int = fopen("/proc/self/cmdline", "rb")
    if f == 0 is return out end
    let buf: int = rt_ptr::buf_new(4097)
    let mut all: [int] = []
    let mut n: int = fread(buf, 1, 4096, f)
    while n > 0 is
        let mut i: int = 0
        while i < n is
            all.push(rt_ptr::peek_byte(buf + i))
            i += 1
        end
        n = fread(buf, 1, 4096, f)
    end
    fclose(f)
    rt_ptr::buf_free(buf)
    let mut start: int = 0
    let mut j: int = 0
    while j < all.len() is
        if all[j] == 0 is
            let len: int = j - start
            let tmp: int = rt_ptr::buf_new(len + 1)
            let mut k: int = 0
            while k < len is
                rt_ptr::ptr_write_i8(tmp, k, all[start + k])
                k += 1
            end
            out.push(strdup(tmp))
            rt_ptr::buf_free(tmp)
            start = j + 1
        end
        j += 1
    end
    return out
end
