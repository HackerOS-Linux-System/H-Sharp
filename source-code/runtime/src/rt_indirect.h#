mod rt_ptr

;; rt_indirect — the part of the H# runtime that needs a raw *function address*: closure_call1/2, sort_by_raw, sort_by_key.
;; It is built on the compiler builtins `call_ptr0..call_ptr4` (call an int as a function), which exist in the self-hosted
;; compiler (source-code/compiler, typecheck/src/tc_builtins.h#) but NOT in the h# 0.9.0 binary.  Everything else in
;; source-code/runtime builds with 0.9.0 — see RUNTIME_STATUS.md.  Tests: src/rt_test_indirect.h#.

fn rd(p: int, off: int) -> int is return rt_ptr::ptr_read_i64(p, off) end

;; core.c hsh_closure_call1 / hsh_closure_call2: call the function at c->fn_ptr with the arguments, then the captures (n_caps 0, 1 or 2; any
;; other count calls it with the bare arguments); a NULL closure gives 0.  The closure block is { fn_ptr @0, n_caps @8, caps @16.. } (closure_create).
pub fn closure_call1(c: int, a0: int) -> int is
    if c == 0 is return 0 end
    let f: int = rd(c, 0)
    let n: int = rd(c, 8)
    if n == 1 is return call_ptr2(f, a0, rd(c, 16)) end
    if n == 2 is return call_ptr3(f, a0, rd(c, 16), rd(c, 24)) end
    return call_ptr1(f, a0)
end

pub fn closure_call2(c: int, a0: int, a1: int) -> int is
    if c == 0 is return 0 end
    let f: int = rd(c, 0)
    let n: int = rd(c, 8)
    if n == 1 is return call_ptr3(f, a0, a1, rd(c, 16)) end
    if n == 2 is return call_ptr4(f, a0, a1, rd(c, 16), rd(c, 24)) end
    return call_ptr2(f, a0, a1)
end

;; core.c hsh_sort_by with a raw comparator address (what hsharp_rt.hpp's cmp_tramp passes): same stable merge sort and the same sequence of
;; comparator calls as `sort_by`, but `cmp` is an address called through `call_ptr2`; NULL cmp or fewer than 2 elements leaves the array alone.
fn msort_raw(d: [int], tmp: [int], off: int, n: int, f: int) is
    if n < 2 is return end
    let m: int = n / 2
    msort_raw(d, tmp, off, m, f)
    msort_raw(d, tmp, off + m, n - m, f)
    let mut i: int = 0
    let mut j: int = m
    let mut k: int = 0
    while i < m && j < n is
        if call_ptr2(f, d[off + i], d[off + j]) > 0 is
            tmp[k] = d[off + j]
            j += 1
        else
            tmp[k] = d[off + i]
            i += 1
        end
        k += 1
    end
    while i < m is
        tmp[k] = d[off + i]
        i += 1
        k += 1
    end
    while j < n is
        tmp[k] = d[off + j]
        j += 1
        k += 1
    end
    let mut c: int = 0
    while c < n is
        d[off + c] = tmp[c]
        c += 1
    end
end

pub fn sort_by_raw(a: [int], cmp: int) -> [int] is
    let n: int = a.len()
    if cmp == 0 || n < 2 is return a end
    let mut tmp: [int] = []
    let mut i: int = 0
    while i < n is
        tmp.push(0)
        i += 1
    end
    msort_raw(a, tmp, 0, n, cmp)
    return a
end

extern static [c] is
    fn strcmp(a: int, b: int) -> int
end

fn looks_ptr(v: int) -> bool is return v > 65536 && v < 140737488355326 end

;; core.c hsh_sort_by_key(arr, key_fn): `key` is a raw address called through `call_ptr1`; keys are compared as C strings when both look like
;; pointers and as signed ints otherwise; stable insertion sort on an index array; NULL key or fewer than 2 elements leaves the array alone.
pub fn sort_by_key(a: [int], key: int) -> [int] is
    let n: int = a.len()
    if key == 0 || n < 2 is return a end
    let mut keys: [int] = []
    let mut idx: [int] = []
    let mut i: int = 0
    while i < n is
        keys.push(call_ptr1(key, a[i]))
        idx.push(i)
        i += 1
    end
    i = 1
    while i < n is
        let cur: int = idx[i]
        let mut j: int = i
        while j > 0 is
            let k1: int = keys[idx[j - 1]]
            let k2: int = keys[cur]
            let mut gt: bool = k1 > k2
            if looks_ptr(k1) && looks_ptr(k2) is gt = cint(strcmp(k1, k2)) > 0 end
            if !gt is break end
            idx[j] = idx[j - 1]
            j -= 1
        end
        idx[j] = cur
        i += 1
    end
    let mut out: [int] = []
    i = 0
    while i < n is
        out.push(a[idx[i]])
        i += 1
    end
    i = 0
    while i < n is
        a[i] = out[i]
        i += 1
    end
    return a
end

;; C `int` results arrive as the low 32 bits of a 64-bit register; sign-extend them
fn cint(x: int) -> int is
    let v: int = x & 4294967295
    if v >= 2147483648 is return v - 4294967296 end
    return v
end
