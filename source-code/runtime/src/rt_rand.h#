mod rt_os

;; unsigned 64-bit comparison a < b
fn ult(a: int, b: int) -> bool is
    let m: int = -9223372036854775807 - 1
    return (a ^ m) < (b ^ m)
end

;; r % m for r, m read as UNSIGNED 64-bit (m != 0), by binary long division
pub fn umod64(r: int, m: int) -> int is
    let mut rem: int = 0
    let mut i: int = 63
    while i >= 0 is
        let carry: bool = rem < 0
        rem = (rem << 1) | ((r >> i) & 1)
        if carry || !ult(rem, m) is rem = rem - m end
        i -= 1
    end
    return rem
end

;; core.c hsh_random_int(min, max): min + (urandom64 % (max - min)); min when max <= min (or when urandom is unreadable: r = 0)
pub fn random_int(min: int, max: int) -> int is
    let b: [int] = rt_os::urandom(8)
    let mut r: int = 0
    let mut i: int = 7
    while i >= 0 is
        r = (r << 8) | b[i]
        i -= 1
    end
    if max <= min is return min end
    return min + umod64(r, max - min)
end

;; core.c hsh_random_hex(n): n random bytes as 2n lowercase hex digits ("" for n <= 0)
pub fn random_hex(n: int) -> string is
    if n <= 0 is return "" end
    let digits: string = "0123456789abcdef"
    let b: [int] = rt_os::urandom(n)
    let mut out: string = ""
    let mut i: int = 0
    while i < b.len() is
        out += digits[b[i] / 16..b[i] / 16 + 1]
        out += digits[b[i] % 16..b[i] % 16 + 1]
        i += 1
    end
    return out
end

;; core.c hsh_random_string(n): n characters of [a-zA-Z0-9], byte % 62
pub fn random_string(n: int) -> string is
    if n <= 0 is return "" end
    let cs: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    let b: [int] = rt_os::urandom(n)
    let mut out: string = ""
    let mut i: int = 0
    while i < b.len() is
        out += cs[b[i] % 62..b[i] % 62 + 1]
        i += 1
    end
    return out
end

;; core.c hsh_uuid_v4: 16 random bytes, version nibble 4, variant 10xx, printed 8-4-4-4-12
pub fn uuid_v4() -> string is
    let b: [int] = rt_os::urandom(16)
    b[6] = (b[6] & 15) | 64
    b[8] = (b[8] & 63) | 128
    let digits: string = "0123456789abcdef"
    let mut out: string = ""
    let mut i: int = 0
    while i < 16 is
        if i == 4 || i == 6 || i == 8 || i == 10 is out += "-" end
        out += digits[b[i] / 16..b[i] / 16 + 1]
        out += digits[b[i] % 16..b[i] % 16 + 1]
        i += 1
    end
    return out
end

;; core.c hsh_crypto_random_bytes(n): n random bytes, [] for n <= 0
pub fn crypto_random_bytes(n: int) -> [int] is
    return rt_os::urandom(n)
end
