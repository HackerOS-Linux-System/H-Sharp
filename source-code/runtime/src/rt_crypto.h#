mod rt_bytes

fn w32(x: int) -> int is return x & 4294967295 end
fn rol32(x: int, n: int) -> int is return w32((x << n) | (x >> (32 - n))) end
fn ror32(x: int, n: int) -> int is return w32((x >> n) | (x << (32 - n))) end
;; logical shift right of a 64-bit word
fn lsr64(x: int, n: int) -> int is
    if n == 0 is return x end
    return (x >> n) & ((1 << (64 - n)) - 1)
end
fn ror64(x: int, n: int) -> int is return lsr64(x, n) | (x << (64 - n)) end

fn str_bytes(s: string) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < s.len() is
        out.push(byte_at(s, i))
        i += 1
    end
    return out
end

fn mask8(x: int) -> int is return ((x % 256) + 256) % 256 end

fn bytes8(a: [int]) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < a.len() is
        out.push(mask8(a[i]))
        i += 1
    end
    return out
end

;; message || 0x80 || zeros || bit length (lenbytes bytes), total a multiple of `block`
fn pad(msg: [int], block: int, lenbytes: int, big: bool) -> [int] is
    let mut p: [int] = []
    let mut i: int = 0
    while i < msg.len() is
        p.push(msg[i])
        i += 1
    end
    p.push(128)
    while p.len() % block != block - lenbytes is p.push(0) end
    let bits: int = msg.len() * 8
    if big is
        let mut j: int = lenbytes - 1
        while j >= 0 is
            if j < 8 is p.push((bits >> (8 * j)) & 255) else p.push(0) end
            j -= 1
        end
    else
        let mut j2: int = 0
        while j2 < lenbytes is
            if j2 < 8 is p.push((bits >> (8 * j2)) & 255) else p.push(0) end
            j2 += 1
        end
    end
    return p
end

fn words_be32(h: [int]) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < h.len() is
        out.push((h[i] >> 24) & 255)
        out.push((h[i] >> 16) & 255)
        out.push((h[i] >> 8) & 255)
        out.push(h[i] & 255)
        i += 1
    end
    return out
end

fn sha256_raw(msg: [int]) -> [int] is
    let k: [int] = k256()
    let mut h: [int] = h256()
    let p: [int] = pad(msg, 64, 8, true)
    let mut off: int = 0
    while off < p.len() is
        let mut w: [int] = []
        let mut i: int = 0
        while i < 16 is
            w.push((p[off + 4 * i] << 24) | (p[off + 4 * i + 1] << 16) | (p[off + 4 * i + 2] << 8) | p[off + 4 * i + 3])
            i += 1
        end
        while i < 64 is
            let s0: int = ror32(w[i - 15], 7) ^ ror32(w[i - 15], 18) ^ (w[i - 15] >> 3)
            let s1: int = ror32(w[i - 2], 17) ^ ror32(w[i - 2], 19) ^ (w[i - 2] >> 10)
            w.push(w32(w[i - 16] + s0 + w[i - 7] + s1))
            i += 1
        end
        let mut a: int = h[0]
        let mut b: int = h[1]
        let mut c: int = h[2]
        let mut d: int = h[3]
        let mut e: int = h[4]
        let mut f: int = h[5]
        let mut g: int = h[6]
        let mut hh: int = h[7]
        let mut r: int = 0
        while r < 64 is
            let bs1: int = ror32(e, 6) ^ ror32(e, 11) ^ ror32(e, 25)
            let ch: int = (e & f) ^ ((~e) & g)
            let t1: int = w32(hh + bs1 + ch + k[r] + w[r])
            let bs0: int = ror32(a, 2) ^ ror32(a, 13) ^ ror32(a, 22)
            let mj: int = (a & b) ^ (a & c) ^ (b & c)
            let t2: int = w32(bs0 + mj)
            hh = g
            g = f
            f = e
            e = w32(d + t1)
            d = c
            c = b
            b = a
            a = w32(t1 + t2)
            r += 1
        end
        h[0] = w32(h[0] + a)
        h[1] = w32(h[1] + b)
        h[2] = w32(h[2] + c)
        h[3] = w32(h[3] + d)
        h[4] = w32(h[4] + e)
        h[5] = w32(h[5] + f)
        h[6] = w32(h[6] + g)
        h[7] = w32(h[7] + hh)
        off += 64
    end
    return words_be32(h)
end

fn sha512_raw(msg: [int]) -> [int] is
    let k: [int] = k512()
    let mut h: [int] = h512()
    let p: [int] = pad(msg, 128, 16, true)
    let mut off: int = 0
    while off < p.len() is
        let mut w: [int] = []
        let mut i: int = 0
        while i < 16 is
            let mut x: int = 0
            let mut j: int = 0
            while j < 8 is
                x = (x << 8) | p[off + 8 * i + j]
                j += 1
            end
            w.push(x)
            i += 1
        end
        while i < 80 is
            let s0: int = ror64(w[i - 15], 1) ^ ror64(w[i - 15], 8) ^ lsr64(w[i - 15], 7)
            let s1: int = ror64(w[i - 2], 19) ^ ror64(w[i - 2], 61) ^ lsr64(w[i - 2], 6)
            w.push(w[i - 16] + s0 + w[i - 7] + s1)
            i += 1
        end
        let mut a: int = h[0]
        let mut b: int = h[1]
        let mut c: int = h[2]
        let mut d: int = h[3]
        let mut e: int = h[4]
        let mut f: int = h[5]
        let mut g: int = h[6]
        let mut hh: int = h[7]
        let mut r: int = 0
        while r < 80 is
            let bs1: int = ror64(e, 14) ^ ror64(e, 18) ^ ror64(e, 41)
            let ch: int = (e & f) ^ ((~e) & g)
            let t1: int = hh + bs1 + ch + k[r] + w[r]
            let bs0: int = ror64(a, 28) ^ ror64(a, 34) ^ ror64(a, 39)
            let mj: int = (a & b) ^ (a & c) ^ (b & c)
            let t2: int = bs0 + mj
            hh = g
            g = f
            f = e
            e = d + t1
            d = c
            c = b
            b = a
            a = t1 + t2
            r += 1
        end
        h[0] = h[0] + a
        h[1] = h[1] + b
        h[2] = h[2] + c
        h[3] = h[3] + d
        h[4] = h[4] + e
        h[5] = h[5] + f
        h[6] = h[6] + g
        h[7] = h[7] + hh
        off += 128
    end
    let mut out: [int] = []
    let mut n: int = 0
    while n < 8 is
        let mut j: int = 0
        while j < 8 is
            out.push(lsr64(h[n], 56 - 8 * j) & 255)
            j += 1
        end
        n += 1
    end
    return out
end

fn sha1_raw(msg: [int]) -> [int] is
    let mut h: [int] = [1732584193, 4023233417, 2562383102, 271733878, 3285377520]
    let p: [int] = pad(msg, 64, 8, true)
    let mut off: int = 0
    while off < p.len() is
        let mut w: [int] = []
        let mut i: int = 0
        while i < 16 is
            w.push((p[off + 4 * i] << 24) | (p[off + 4 * i + 1] << 16) | (p[off + 4 * i + 2] << 8) | p[off + 4 * i + 3])
            i += 1
        end
        while i < 80 is
            w.push(rol32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1))
            i += 1
        end
        let mut a: int = h[0]
        let mut b: int = h[1]
        let mut c: int = h[2]
        let mut d: int = h[3]
        let mut e: int = h[4]
        let mut r: int = 0
        while r < 80 is
            let mut f: int = 0
            let mut kk: int = 0
            if r < 20 is
                f = (b & c) | ((~b) & d)
                kk = 1518500249
            elsif r < 40 is
                f = b ^ c ^ d
                kk = 1859775393
            elsif r < 60 is
                f = (b & c) | (b & d) | (c & d)
                kk = 2400959708
            else
                f = b ^ c ^ d
                kk = 3395469782
            end
            let t: int = w32(rol32(a, 5) + (f & 4294967295) + e + kk + w[r])
            e = d
            d = c
            c = rol32(b, 30)
            b = a
            a = t
            r += 1
        end
        h[0] = w32(h[0] + a)
        h[1] = w32(h[1] + b)
        h[2] = w32(h[2] + c)
        h[3] = w32(h[3] + d)
        h[4] = w32(h[4] + e)
        off += 64
    end
    return words_be32(h)
end

fn md5_raw(msg: [int]) -> [int] is
    let t: [int] = md5_t()
    let s: [int] = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
                    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
    let mut h: [int] = [1732584193, 4023233417, 2562383102, 271733878]
    let p: [int] = pad(msg, 64, 8, false)
    let mut off: int = 0
    while off < p.len() is
        let mut m: [int] = []
        let mut i: int = 0
        while i < 16 is
            m.push(p[off + 4 * i] | (p[off + 4 * i + 1] << 8) | (p[off + 4 * i + 2] << 16) | (p[off + 4 * i + 3] << 24))
            i += 1
        end
        let mut a: int = h[0]
        let mut b: int = h[1]
        let mut c: int = h[2]
        let mut d: int = h[3]
        let mut r: int = 0
        while r < 64 is
            let mut f: int = 0
            let mut g: int = 0
            if r < 16 is
                f = (b & c) | ((~b) & d)
                g = r
            elsif r < 32 is
                f = (d & b) | ((~d) & c)
                g = (5 * r + 1) % 16
            elsif r < 48 is
                f = b ^ c ^ d
                g = (3 * r + 5) % 16
            else
                f = c ^ (b | ((~d) & 4294967295))
                g = (7 * r) % 16
            end
            f = w32(w32(f) + a + t[r] + m[g])
            a = d
            d = c
            c = b
            b = w32(b + rol32(f, s[r]))
            r += 1
        end
        h[0] = w32(h[0] + a)
        h[1] = w32(h[1] + b)
        h[2] = w32(h[2] + c)
        h[3] = w32(h[3] + d)
        off += 64
    end
    let mut out: [int] = []
    let mut n: int = 0
    while n < 4 is
        out.push(h[n] & 255)
        out.push((h[n] >> 8) & 255)
        out.push((h[n] >> 16) & 255)
        out.push((h[n] >> 24) & 255)
        n += 1
    end
    return out
end

;; hsh_digest2: algo 0 = sha256, 1 = sha512, 2 = sha1, 3 = md5
fn digest(algo: int, msg: [int]) -> [int] is
    if algo == 0 is return sha256_raw(msg) end
    if algo == 1 is return sha512_raw(msg) end
    if algo == 2 is return sha1_raw(msg) end
    return md5_raw(msg)
end

;; hsh_hmac
fn hmac(algo: int, key: [int], msg: [int]) -> [int] is
    let mut bs: int = 64
    if algo == 1 is bs = 128 end
    let mut k: [int] = []
    if key.len() > bs is k = digest(algo, key) else k = bytes8(key) end
    let mut inner: [int] = []
    let mut outer: [int] = []
    let mut i: int = 0
    while i < bs is
        let mut kb: int = 0
        if i < k.len() is kb = k[i] end
        inner.push(kb ^ 54)
        outer.push(kb ^ 92)
        i += 1
    end
    let mut j: int = 0
    while j < msg.len() is
        inner.push(msg[j])
        j += 1
    end
    let ih: [int] = digest(algo, inner)
    let mut x: int = 0
    while x < ih.len() is
        outer.push(ih[x])
        x += 1
    end
    return digest(algo, outer)
end

;; ── BLAKE3 (default hash mode, 32-byte output): the structure of hsh_b3_hash, chunk by chunk ──
fn b3_perm() -> [int] is return [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8] end

fn b3_g(s: [int], a: int, b: int, c: int, d: int, mx: int, my: int) is
    s[a] = w32(s[a] + s[b] + mx)
    s[d] = ror32(s[d] ^ s[a], 16)
    s[c] = w32(s[c] + s[d])
    s[b] = ror32(s[b] ^ s[c], 12)
    s[a] = w32(s[a] + s[b] + my)
    s[d] = ror32(s[d] ^ s[a], 8)
    s[c] = w32(s[c] + s[d])
    s[b] = ror32(s[b] ^ s[c], 7)
end

fn b3_round(s: [int], m: [int]) is
    b3_g(s, 0, 4, 8, 12, m[0], m[1])
    b3_g(s, 1, 5, 9, 13, m[2], m[3])
    b3_g(s, 2, 6, 10, 14, m[4], m[5])
    b3_g(s, 3, 7, 11, 15, m[6], m[7])
    b3_g(s, 0, 5, 10, 15, m[8], m[9])
    b3_g(s, 1, 6, 11, 12, m[10], m[11])
    b3_g(s, 2, 7, 8, 13, m[12], m[13])
    b3_g(s, 3, 4, 9, 14, m[14], m[15])
end

fn take(a: [int], off: int, n: int) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < n is
        out.push(a[off + i])
        i += 1
    end
    return out
end

fn b3_compress(cv: [int], blk: [int], ctr: int, blen: int, flags: int) -> [int] is
    let iv: [int] = h256()
    let mut s: [int] = take(cv, 0, 8)
    let mut i: int = 0
    while i < 4 is
        s.push(iv[i])
        i += 1
    end
    s.push(w32(ctr))
    s.push(w32(ctr >> 32))
    s.push(blen)
    s.push(flags)
    let mut m: [int] = take(blk, 0, 16)
    let perm: [int] = b3_perm()
    let mut r: int = 0
    while r < 7 is
        b3_round(s, m)
        if r < 6 is
            let mut t: [int] = []
            let mut q: int = 0
            while q < 16 is
                t.push(m[perm[q]])
                q += 1
            end
            m = t
        end
        r += 1
    end
    let mut k: int = 0
    while k < 8 is
        s[k] = s[k] ^ s[k + 8]
        s[k + 8] = s[k + 8] ^ cv[k]
        k += 1
    end
    return s
end

;; 16 little-endian words of d[off .. off+n), zero padded
fn b3_words(d: [int], off: int, n: int) -> [int] is
    let mut w: [int] = []
    let mut i: int = 0
    while i < 16 is
        let mut x: int = 0
        let mut j: int = 3
        while j >= 0 is
            let idx: int = 4 * i + j
            let mut byte: int = 0
            if idx < n is byte = d[off + idx] end
            x = (x << 8) | byte
            j -= 1
        end
        w.push(x)
        i += 1
    end
    return w
end

;; an "Out": cv[0..8) blk[8..24) ctr[24] blen[25] flags[26]
fn b3_chunk_out(d: [int], j: int) -> [int] is
    let start: int = j * 1024
    let mut clen: int = d.len() - start
    if clen > 1024 is clen = 1024 end
    let mut nb: int = (clen + 63) / 64
    if nb == 0 is nb = 1 end
    let mut cv: [int] = h256()
    let mut bi: int = 0
    while bi < nb - 1 is
        let w: [int] = b3_words(d, start + 64 * bi, 64)
        let mut fl: int = 0
        if bi == 0 is fl = 1 end
        cv = take(b3_compress(cv, w, j, 64, fl), 0, 8)
        bi += 1
    end
    let lastn: int = clen - 64 * (nb - 1)
    let lw: [int] = b3_words(d, start + 64 * (nb - 1), lastn)
    let mut flags: int = 2
    if nb == 1 is flags = 3 end
    let mut out: [int] = cv
    let mut i: int = 0
    while i < 16 is
        out.push(lw[i])
        i += 1
    end
    out.push(j)
    out.push(lastn)
    out.push(flags)
    return out
end

fn b3_out_cv(o: [int]) -> [int] is
    return take(b3_compress(take(o, 0, 8), take(o, 8, 16), o[24], o[25], o[26]), 0, 8)
end

fn b3_parent_out(l: [int], r: [int]) -> [int] is
    let mut out: [int] = h256()
    let mut i: int = 0
    while i < 8 is
        out.push(l[i])
        i += 1
    end
    i = 0
    while i < 8 is
        out.push(r[i])
        i += 1
    end
    out.push(0)
    out.push(64)
    out.push(4)
    return out
end

fn b3_hash(d: [int]) -> [int] is
    let mut nchunks: int = (d.len() + 1023) / 1024
    if nchunks == 0 is nchunks = 1 end
    let mut stack: [int] = []
    let mut z: int = 0
    while z < 8 * 64 is
        stack.push(0)
        z += 1
    end
    let mut sp: int = 0
    let mut j: int = 0
    while j < nchunks - 1 is
        let mut cv: [int] = b3_out_cv(b3_chunk_out(d, j))
        let mut total: int = j + 1
        while (total & 1) == 0 is
            sp -= 1
            cv = b3_out_cv(b3_parent_out(take(stack, sp * 8, 8), cv))
            total = total >> 1
        end
        let mut q: int = 0
        while q < 8 is
            stack[sp * 8 + q] = cv[q]
            q += 1
        end
        sp += 1
        j += 1
    end
    let mut o: [int] = b3_chunk_out(d, nchunks - 1)
    while sp > 0 is
        let cv2: [int] = b3_out_cv(o)
        sp -= 1
        o = b3_parent_out(take(stack, sp * 8, 8), cv2)
    end
    let w: [int] = b3_compress(take(o, 0, 8), take(o, 8, 16), 0, o[25], o[26] | 8)
    let mut out: [int] = []
    let mut n: int = 0
    while n < 8 is
        out.push(w[n] & 255)
        out.push((w[n] >> 8) & 255)
        out.push((w[n] >> 16) & 255)
        out.push((w[n] >> 24) & 255)
        n += 1
    end
    return out
end

;; ── public API (names of the hsh_crypto_* functions they replace) ──
;; core.c hsh_crypto_sha256 / sha512 / sha1 / md5 / blake3 / sha256_bytes: lowercase hex of the digest
pub fn sha256(s: string) -> string is return rt_bytes::hex_encode_bytes(sha256_raw(str_bytes(s))) end
pub fn sha512(s: string) -> string is return rt_bytes::hex_encode_bytes(sha512_raw(str_bytes(s))) end
pub fn sha1(s: string) -> string is return rt_bytes::hex_encode_bytes(sha1_raw(str_bytes(s))) end
pub fn md5(s: string) -> string is return rt_bytes::hex_encode_bytes(md5_raw(str_bytes(s))) end
pub fn blake3(s: string) -> string is return rt_bytes::hex_encode_bytes(b3_hash(str_bytes(s))) end
pub fn sha256_bytes(b: [int]) -> string is return rt_bytes::hex_encode_bytes(sha256_raw(bytes8(b))) end

;; core.c hsh_crypto_hmac_sha256 / hmac_sha512
pub fn hmac_sha256(key: string, msg: string) -> string is
    return rt_bytes::hex_encode_bytes(hmac(0, str_bytes(key), str_bytes(msg)))
end
pub fn hmac_sha512(key: string, msg: string) -> string is
    return rt_bytes::hex_encode_bytes(hmac(1, str_bytes(key), str_bytes(msg)))
end

;; core.c hsh_crypto_pbkdf2: PBKDF2-HMAC-SHA256 (password, salt bytes, iterations, key length) -> bytes; [] for klen/iters <= 0
pub fn pbkdf2(pw: string, salt: [int], iters: int, klen: int) -> [int] is
    let mut dk: [int] = []
    if klen <= 0 || iters <= 0 is return dk end
    let key: [int] = str_bytes(pw)
    let s: [int] = bytes8(salt)
    let blocks: int = (klen + 31) / 32
    let mut b: int = 1
    while b <= blocks is
        let mut sb: [int] = bytes8(s)
        sb.push((b >> 24) & 255)
        sb.push((b >> 16) & 255)
        sb.push((b >> 8) & 255)
        sb.push(b & 255)
        let mut u: [int] = hmac(0, key, sb)
        let mut t: [int] = bytes8(u)
        let mut i: int = 1
        while i < iters is
            u = hmac(0, key, u)
            let mut j: int = 0
            while j < 32 is
                t[j] = t[j] ^ u[j]
                j += 1
            end
            i += 1
        end
        let mut j2: int = 0
        while j2 < 32 is
            dk.push(t[j2])
            j2 += 1
        end
        b += 1
    end
    let mut out: [int] = []
    let mut n: int = 0
    while n < klen is
        out.push(dk[n])
        n += 1
    end
    return out
end

;; core.c hsh_crypto_bytes_eq: equal length and equal bytes (the C does not short-circuit; the result is what matters)
pub fn bytes_eq(a: [int], b: [int]) -> bool is
    let la: int = a.len()
    let lb: int = b.len()
    let mut diff: int = 0
    if la != lb is diff = 1 end
    let mut m: int = la
    if lb > la is m = lb end
    let mut i: int = 0
    while i < m is
        let mut x: int = 0
        let mut y: int = 0
        if i < la is x = mask8(a[i]) end
        if i < lb is y = mask8(b[i]) end
        diff = diff | (x ^ y)
        i += 1
    end
    return diff == 0
end

;; core.c hsh_crypto_xor_bytes: [] unless both have the same non-zero length
pub fn xor_bytes(a: [int], b: [int]) -> [int] is
    let mut out: [int] = []
    if a.len() != b.len() || a.len() == 0 is return out end
    let mut i: int = 0
    while i < a.len() is
        out.push(mask8(a[i]) ^ mask8(b[i]))
        i += 1
    end
