fn main() is
    let args: [string] = env::args()
    let lines: [string] = fs::read_lines(args[1])
    let mut i: int = 0
    while i < lines.len() is
        let parts: [string] = __builtin_str_split(lines[i], "\t")
        if parts.len() > 0 && parts[0].len() > 0 is
            let r: string = run_op(parts[0], arg(parts, 1), arg(parts, 2), arg(parts, 3))
            if r.len() > 0 && (byte_at(r, 0) == 35 || byte_at(r, 0) == 33) is
                write(parts[0] + "\t" + r[1..r.len()])
            else
                write(parts[0] + "\t" + r)
            end
        end
        i += 1
    end
end

;; hsh_task_spawn_shell stays in C (it needs a C-callable entry point); both sides of the parity run spawn with it
extern static [c] is
    fn strdup(p: int) -> string
end
fn spawn_shell(cmd: string) -> int is return rt_task::task_spawn_shell(cmd) end

;; the named functions of the closure / spawn vectors (parity_c.c has the same ones as pf_*)
fn pf_dbl(x: int) -> int is return x * 2 end
fn pf_add3(a: int, b: int, c: int) -> int is return a * 100 + b * 10 + c end
fn pf_add4(a: int, b: int, c: int, d: int) -> int is return a * 1000 + b * 100 + c * 10 + d end
fn pf_sub2(a: int, b: int) -> int is return a - b end
fn pf_neg(x: int) -> int is return -x end
fn pf_sq(x: int) -> int is return x * x end
fn fn_addr_of(name: string) -> int is
    if name == "dbl" is return fn_addr(pf_dbl) end
    if name == "add3" is return fn_addr(pf_add3) end
    if name == "add4" is return fn_addr(pf_add4) end
    if name == "neg" is return fn_addr(pf_neg) end
    if name == "sq" is return fn_addr(pf_sq) end
    return fn_addr(pf_sub2)
end
fn c_str(p: int) -> string is
    if p == 0 is return "" end
    return strdup(p)
end

;; named comparators of the sort_by vectors (the same functions exist in parity_c.c)
fn cmp_asc(a: int, b: int) -> int is
    if a > b is return 1 end
    if a < b is return -1 end
    return 0
end
fn cmp_desc(a: int, b: int) -> int is
    if b > a is return 1 end
    if b < a is return -1 end
    return 0
end
fn cmp_mod3(a: int, b: int) -> int is return (a % 3) - (b % 3) end
fn cmp_mod4(a: int, b: int) -> int is return (a % 4) - (b % 4) end
fn cmp_abs(a: int, b: int) -> int is
    let mut x: int = a
    let mut y: int = b
    if x < 0 is x = -x end
    if y < 0 is y = -y end
    if x > y is return 1 end
    if x < y is return -1 end
    return 0
end
fn cmp_parity(a: int, b: int) -> int is return (a & 1) - (b & 1) end
fn pick_cmp(name: string) -> fn(int, int) -> int is
    if name == "asc" is return cmp_asc end
    if name == "desc" is return cmp_desc end
    if name == "mod3" is return cmp_mod3 end
    if name == "mod4" is return cmp_mod4 end
    if name == "abs" is return cmp_abs end
    return cmp_parity
end
