;; decimal text of an int read as UNSIGNED 64-bit
fn utext(v: int) -> string is
    if v >= 0 is return to_string(v) end
    let q: int = ((v >> 1) & 9223372036854775807) / 5
    let r: int = v - q * 10
    return to_string(q) + to_string(r)
end

fn ok_bad(b: bool) -> string is
    if b is return "ok" end
    return "bad"
end

fn is_hex_n(s: string, n: int) -> bool is
    if s.len() != n is return false end
    let mut i: int = 0
    while i < n is
        let c: int = byte_at(s, i)
        if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) is return false end
        i += 1
    end
    return true
end

fn is_alnum(c: int) -> bool is
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
end

fn prop_rhex(n: int) -> string is
    if n <= 0 is return ok_bad(rt_rand::random_hex(n).len() == 0) end
    let a: string = rt_rand::random_hex(n)
    let b: string = rt_rand::random_hex(n)
    if !is_hex_n(a, n * 2) is return "bad" end
    if n >= 8 && a == b is return "bad" end
    return "ok"
end

fn prop_rstr(n: int) -> string is
    if n <= 0 is return ok_bad(rt_rand::random_string(n).len() == 0) end
    let a: string = rt_rand::random_string(n)
    let b: string = rt_rand::random_string(n)
    if a.len() != n is return "bad" end
    let mut i: int = 0
    while i < n is
        if !is_alnum(byte_at(a, i)) is return "bad" end
        i += 1
    end
    if n >= 8 && a == b is return "bad" end
    return "ok"
end

fn prop_rint(lo: int, hi: int) -> string is
    let mut i: int = 0
    while i < 300 is
        let v: int = rt_rand::random_int(lo, hi)
        if hi <= lo is
            if v != lo is return "bad" end
        else
            if v < lo || v >= hi is return "bad" end
        end
        i += 1
    end
    return "ok"
end

fn prop_uuid() -> string is
    let a: string = rt_rand::uuid_v4()
    let b: string = rt_rand::uuid_v4()
    if a.len() != 36 || a == b is return "bad" end
    let mut i: int = 0
    while i < 36 is
        let c: int = byte_at(a, i)
        if i == 8 || i == 13 || i == 18 || i == 23 is
            if c != 45 is return "bad" end
        elsif !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) is
            return "bad"
        end
        i += 1
    end
    if byte_at(a, 14) != 52 is return "bad" end
    let v: int = byte_at(a, 19)
    if !(v == 56 || v == 57 || v == 97 || v == 98) is return "bad" end
    return "ok"
end

fn prop_rbytes(n: int) -> string is
    let a: [int] = rt_rand::crypto_random_bytes(n)
    if n <= 0 is return ok_bad(a.len() == 0) end
    if a.len() != n is return "bad" end
    let mut same: bool = true
    let mut i: int = 0
    while i < n is
        if a[i] < 0 || a[i] > 255 is return "bad" end
        if a[i] != a[0] is same = false end
        i += 1
    end
    if n >= 16 && same is return "bad" end
    return "ok"
end

fn prop_sys(w: string) -> string is
    if w == "uptime" is return ok_bad(rt_sys::uptime() > 0) end
    if w == "loadavg" is
        let l: f64 = rt_sys::load_avg()
        return ok_bad(l >= 0.0 && l < 100000.0)
    end
    if w == "memfree" is
        let f: int = rt_sys::memory_free()
        return ok_bad(f > 0 && f <= rt_sys::memory_total())
    end
    if w == "diskfree" is
        return ok_bad(rt_sys::disk_free("") <= rt_sys::disk_total("") && rt_sys::disk_free("/tmp") <= rt_sys::disk_total("/tmp") && rt_sys::disk_total("") > 0)
    end
    if w == "nowms" is
        let d: int = rt_sys::now_ms() - rt_sys::now_unix() * 1000
        return ok_bad(d > -5000 && d < 5000)
    end
    return "?"
end

fn rows_tok(rows: [[string]]) -> string is
    if rows.len() == 0 is return "-" end
    let mut out: string = ""
    let mut i: int = 0
    while i < rows.len() is
        if i > 0 is out += "/" end
        out += strs_tok(rows[i])
        i += 1
    end
    return out
end

fn spawnkill(cmd: string) -> string is
    let pid: int = rt_proc::process_spawn(cmd)
    let ok1: bool = pid > 0
    let mut ok2: bool = false
    if ok1 is ok2 = rt_proc::process_kill(pid) end
    let none: bool = rt_proc::process_kill(99999999)
    return nb(ok1) + "," + nb(ok2) + "," + nb(none)
end

fn dump_arr(a: int, strs: bool) -> string is
    if a == 0 is return "-" end
    let n: int = rt_mem::array_len(a)
    let mut out: string = to_string(n) + ":"
    let mut i: int = 0
    while i < n is
        if i > 0 is out += "." end
        let v: int = rt_mem::array_get(a, i)
        if strs is
            let t: string = rt_mem::text_at(v)
            if t.len() == 0 is out += "_" else out += rt_str::hex_encode(t) end
        else
            out += to_string(v)
        end
        i += 1
    end
    return out
end

fn same(a: int, b: int) -> string is
    if a == b is return "1" end
    return "0"
end

fn run_mem(script: string) -> string is
    let mut out: string = ""
    let mut r: [int] = [0, 0, 0, 0, 0, 0, 0, 0]
    let mut skf: [int] = [0, 0, 0, 0, 0, 0, 0, 0]
    let cmds: [string] = __builtin_str_split(script, ";")
    let mut i: int = 0
    while i < cmds.len() is
        let f: [string] = __builtin_str_split(cmds[i], ",")
        let c: string = f[0]
        if c == "clr" is
            r[to_int(f[1])] = 0
        elsif c == "anew" is
            r[to_int(f[1])] = rt_mem::array_new()
        elsif c == "apush" is
            let k: int = to_int(f[1])
            let nr: int = rt_mem::array_push(r[k], to_int(f[2]))
            out = tok_add(out, same(nr, r[k]))
            r[k] = nr
        elsif c == "apushn" is
            r[to_int(f[1])] = rt_mem::array_push(0, to_int(f[2]))
            out = tok_add(out, "n")
        elsif c == "apushs" is
            let k: int = to_int(f[1])
            r[k] = rt_mem::array_push_str(r[k], rt_mem::c_string(f[2]))
        elsif c == "agets" is
            out = tok_add(out, tok_h(rt_mem::text_at(rt_mem::array_get(r[to_int(f[1])], to_int(f[2])))))
        elsif c == "aget" is
            out = tok_add(out, to_string(rt_mem::array_get(r[to_int(f[1])], to_int(f[2]))))
        elsif c == "aset" is
            let k: int = to_int(f[1])
            out = tok_add(out, same(rt_mem::array_set(r[k], to_int(f[2]), to_int(f[3])), r[k]))
        elsif c == "alen" is
            out = tok_add(out, to_string(rt_mem::array_len(r[to_int(f[1])])))
        elsif c == "acat" is
            let ra: int = r[to_int(f[1])]
            let rb: int = r[to_int(f[2])]
            let rr: int = rt_mem::array_concat(ra, rb)
            if rr == ra && rr != 0 is
                out = tok_add(out, "1")
            elsif rr == rb && rr != 0 is
                out = tok_add(out, "2")
            else
                out = tok_add(out, "0")
            end
            r[to_int(f[3])] = rr
        elsif c == "acont" is
            out = tok_add(out, to_string(rt_mem::array_contains(r[to_int(f[1])], to_int(f[2]))))
        elsif c == "arem" is
            out = tok_add(out, to_string(rt_mem::array_remove(r[to_int(f[1])], to_int(f[2]))))
        elsif c == "aslice" is
            r[to_int(f[4])] = rt_mem::array_slice(r[to_int(f[1])], to_int(f[2]), to_int(f[3]))
        elsif c == "adump" is
            out = tok_add(out, dump_arr(r[to_int(f[1])], false))
        elsif c == "adumps" is
            out = tok_add(out, dump_arr(r[to_int(f[1])], true))
        elsif c == "adrop" is
            rt_mem::array_drop(r[to_int(f[1])])
            r[to_int(f[1])] = 0
        elsif c == "afree" is
            rt_mem::array_free(r[to_int(f[1])])
            r[to_int(f[1])] = 0
        elsif c == "arenanew" is
            r[to_int(f[1])] = rt_mem::arena_new_kind(to_int(f[2]), to_int(f[3]))
        elsif c == "arenapush" is
            rt_mem::arena_push_current(r[to_int(f[1])])
        elsif c == "arenapop" is
            out = tok_add(out, same(rt_mem::arena_pop_current(), r[to_int(f[1])]))
        elsif c == "aalloc" is
            let a: int = r[to_int(f[1])]
            let p: int = rt_mem::arena_alloc(a, to_int(f[2]))
            r[to_int(f[3])] = p
            if a != 0 is out = tok_add(out, to_string(p - rt_ptr::ptr_read_i64(a, 0))) else out = tok_add(out, "m") end
        elsif c == "ainfo" is
            let a: int = r[to_int(f[1])]
            out = tok_add(out, to_string(rt_ptr::ptr_read_i64(a, 16)))
            out = tok_add(out, to_string(rt_ptr::ptr_read_i64(a, 8)))
            out = tok_add(out, to_string(rt_ptr::ptr_read_i64(a, 24)))
            let mut n: int = 0
            let mut b: int = rt_ptr::ptr_read_i64(a, 32)
            while b != 0 is
                n += 1
                b = rt_ptr::ptr_read_i64(b, 32)
            end
            out = tok_add(out, to_string(n))
        elsif c == "arenafree" is
            rt_mem::arena_free(r[to_int(f[1])])
            r[to_int(f[1])] = 0
        elsif c == "chk" is
            out = tok_add(out, to_string(rt_mem::arena_checkpoint()))
        elsif c == "rew" is
            rt_mem::arena_rewind(to_int(f[1]))
        elsif c == "used" is
            out = tok_add(out, to_string(rt_mem::arena_used()))
        elsif c == "capa" is
            out = tok_add(out, to_string(rt_mem::arena_capacity()))
        elsif c == "alloc" is
            let u0: int = rt_mem::arena_used()
            rt_mem::alloc_ex(to_int(f[1]))
            out = tok_add(out, to_string(rt_mem::arena_used() - u0))
        elsif c == "snew" is
            let sp: int = rt_mem::struct_new(to_int(f[2]))
            let mut sum: int = 0
            let mut j: int = 0
            while j < to_int(f[2]) is
                sum += rt_ptr::ptr_read_i64(sp, j * 8)
                j += 1
            end
            out = tok_add(out, to_string(sum))
            rt_ptr::ptr_write_i64(sp, 0, 7)
            r[to_int(f[1])] = sp
        elsif c == "mnew" is
            r[to_int(f[1])] = rt_mem::map_new(to_int(f[2]))
            skf[to_int(f[1])] = to_int(f[2])
        elsif c == "mset" is
            let k: int = to_int(f[1])
            if skf[k] != 0 is rt_mem::map_set(r[k], rt_mem::c_string(f[2]), to_int(f[3])) else rt_mem::map_set(r[k], to_int(f[2]), to_int(f[3])) end
        elsif c == "mget" is
            let k: int = to_int(f[1])
            if skf[k] != 0 is out = tok_add(out, to_string(rt_mem::map_get(r[k], rt_mem::c_string(f[2])))) else out = tok_add(out, to_string(rt_mem::map_get(r[k], to_int(f[2])))) end
        elsif c == "mhas" is
            let k: int = to_int(f[1])
            if skf[k] != 0 is out = tok_add(out, to_string(rt_mem::map_has(r[k], rt_mem::c_string(f[2])))) else out = tok_add(out, to_string(rt_mem::map_has(r[k], to_int(f[2])))) end
        elsif c == "mrem" is
            let k: int = to_int(f[1])
            if skf[k] != 0 is out = tok_add(out, to_string(rt_mem::map_remove(r[k], rt_mem::c_string(f[2])))) else out = tok_add(out, to_string(rt_mem::map_remove(r[k], to_int(f[2])))) end
        elsif c == "mlen" is
            out = tok_add(out, to_string(rt_mem::map_len(r[to_int(f[1])])))
        elsif c == "mclear" is
            rt_mem::map_clear(r[to_int(f[1])])
        elsif c == "mcap" is
            let m: int = r[to_int(f[1])]
            if m == 0 is out = tok_add(out, "0") else out = tok_add(out, to_string(rt_ptr::ptr_read_i64(m, 8))) end
        elsif c == "mkeys" is
            out = tok_add(out, dump_arr(rt_mem::map_keys(r[to_int(f[1])]), skf[to_int(f[1])] != 0))
        elsif c == "mvals" is
            out = tok_add(out, dump_arr(rt_mem::map_values(r[to_int(f[1])]), false))
        elsif c == "mnull" is
            out = tok_add(out, to_string(rt_mem::map_len(0)))
            out = tok_add(out, to_string(rt_mem::map_get(0, 5)))
            out = tok_add(out, to_string(rt_mem::map_has(0, 5)))
            out = tok_add(out, to_string(rt_mem::map_remove(0, 5)))
            rt_mem::map_set(0, 1, 2)
            rt_mem::map_clear(0)
            out = tok_add(out, dump_arr(rt_mem::map_keys(0), false))
            out = tok_add(out, dump_arr(rt_mem::map_values(0), false))
        elsif c == "rc" is
            r[to_int(f[1])] = rt_ptr::rc_alloc(to_int(f[2]))
        elsif c == "retain" is
            rt_mem::rc_retain(r[to_int(f[1])])
        elsif c == "release" is
            rt_mem::rc_release(r[to_int(f[1])])
        elsif c == "count" is
            out = tok_add(out, to_string(rt_mem::rc_count(r[to_int(f[1])])))
        elsif c == "down" is
            out = tok_add(out, same(rt_mem::arc_downgrade(r[to_int(f[1])]), r[to_int(f[1])]))
        elsif c == "up" is
            let p: int = r[to_int(f[1])]
            let u: int = rt_mem::arc_upgrade(p)
            if u == p && p != 0 is out = tok_add(out, "1") else out = tok_add(out, "0") end
        elsif c == "wcount" is
            out = tok_add(out, to_string(rt_mem::arc_weak_count(r[to_int(f[1])])))
        elsif c == "wrel" is
            rt_mem::arc_weak_release(r[to_int(f[1])])
        elsif c == "rcnull" is
            out = tok_add(out, to_string(rt_mem::rc_count(0)))
            rt_mem::rc_retain(0)
            rt_mem::rc_release(0)
            out = tok_add(out, to_string(rt_mem::arc_downgrade(0)))
            out = tok_add(out, to_string(rt_mem::arc_upgrade(0)))
            out = tok_add(out, to_string(rt_mem::arc_weak_count(0)))
            rt_mem::arc_weak_release(0)
        elsif c == "args" is
            r[to_int(f[1])] = rt_mem::args_alloc(to_int(f[2]))
            if r[to_int(f[1])] != 0 is out = tok_add(out, "1") else out = tok_add(out, "0") end
        elsif c == "argset" is
            rt_mem::args_set(r[to_int(f[1])], to_int(f[2]), to_int(f[3]))
        elsif c == "argget" is
            out = tok_add(out, to_string(rt_mem::args_get(r[to_int(f[1])], to_int(f[2]))))
        elsif c == "argfree" is
            rt_mem::args_free(r[to_int(f[1])])
            r[to_int(f[1])] = 0
        elsif c == "argnull" is
            out = tok_add(out, to_string(rt_mem::args_get(0, 0)))
            rt_mem::args_set(0, 0, 1)
            rt_mem::args_free(0)
        elsif c == "clo" is
            let n: int = to_int(f[2])
            let mut cp: [int] = [0, 0, 0, 0, 0, 0, 0, 0]
            let mut j: int = 0
            while j < 8 && 3 + j < f.len() is
                cp[j] = to_int(f[3 + j])
                j += 1
            end
            let p: int = rt_mem::closure_create(to_int(f[1]), n, cp[0], cp[1], cp[2], cp[3], cp[4], cp[5], cp[6], cp[7])
            out = tok_add(out, to_string(rt_ptr::ptr_read_i64(p, 0)))
            out = tok_add(out, to_string(rt_ptr::ptr_read_i64(p, 8)))
            let mut q: int = 0
            while q < n && q < 8 is
                out = tok_add(out, to_string(rt_ptr::ptr_read_i64(p, 16 + q * 8)))
                q += 1
            end
        elsif c == "v2s" is
            out = tok_add(out, tok_h(rt_mem::val_to_str(to_int(f[1]))))
        elsif c == "v2ss" is
            out = tok_add(out, tok_h(rt_mem::val_to_str(rt_mem::c_string(f[1]))))
        end
        i += 1
    end
    return out
end

fn lm_tok(t: string) -> string is
    return to_string(t.len()) + "," + rt_crypto::md5(t)
end

fn fld(f: string) -> string is
    if f.len() >= 2 && f[0..2] == "x:" is return rt_bytes::hex_decode(f[2..f.len()]) end
    return f
end

fn dparams(f: [string], from: int) -> int is
    let mut a: int = rt_mem::array_new()
    let mut i: int = from
    while i < f.len() is
        if f[i][0..1] == "i" is
            a = rt_mem::array_push(a, to_int(f[i][1..f[i].len()]))
        else
            a = rt_mem::array_push(a, rt_mem::c_string(fld(f[i][1..f[i].len()])))
        end
        i += 1
    end
    return a
end

fn dump_rows(q: int) -> string is
    let n: int = rt_mem::array_len(q)
    if n == 0 is return "0:" end
    let mut out: string = to_string(n) + ":"
    let mut i: int = 0
    while i < n is
        let r: int = rt_mem::array_get(q, i)
        if i > 0 is out += "/" end
        let m: int = rt_mem::array_len(r)
        let mut j: int = 0
        while j < m is
            if j > 0 is out += "." end
            let t: string = rt_mem::text_at(rt_mem::array_get(r, j))
            if t.len() == 0 is out += "_" else out += rt_str::hex_encode(t) end
            j += 1
        end
        i += 1
    end
    return out
end

fn run_db(script: string) -> string is
    let dir: string = "/tmp/hsfs_parity_" + to_string(rt_sys::pid()) + "_db" + rt_crypto::md5(script)
    rt_os::mkdir_all(dir)
    rt_os::change_dir(dir)
    let mut out: string = ""
    let mut hs: [string] = ["", "", "", "", "", "", "", ""]
    let mut q: int = 0
    let cmds: [string] = __builtin_str_split(script, ";")
    let mut i: int = 0
    while i < cmds.len() is
        let f: [string] = __builtin_str_split(cmds[i], ",")
        let c: string = f[0]
        let mut k: int = 0
        if f.len() > 1 is k = to_int(f[1]) end
        if c == "open" is
            hs[k] = rt_db::sqlite_open(f[2])
            out = tok_add(out, tok_h(hs[k]))
        elsif c == "exec" is
            out = tok_add(out, to_string(rt_db::sqlite_exec(hs[k], fld(f[2]))))
        elsif c == "query" is
            q = rt_db::sqlite_query(hs[k], fld(f[2]))
            out = tok_add(out, dump_rows(q))
        elsif c == "execp" is
            out = tok_add(out, to_string(rt_db::sqlite_exec_params(hs[k], fld(f[2]), dparams(f, 3))))
        elsif c == "queryp" is
            q = rt_db::sqlite_query_params(hs[k], fld(f[2]), dparams(f, 3))
            out = tok_add(out, dump_rows(q))
        elsif c == "ping" is
            out = tok_add(out, to_string(rt_db::sqlite_ping(hs[k])))
        elsif c == "begin" is
            let t: string = rt_mem::text_at(rt_db::sqlite_begin(hs[k]))
            hs[to_int(f[2])] = t
            out = tok_add(out, tok_h(t))
        elsif c == "commit" is
            out = tok_add(out, to_string(rt_db::sqlite_commit(hs[k])))
        elsif c == "rollback" is
            out = tok_add(out, to_string(rt_db::sqlite_rollback(hs[k])))
        elsif c == "close" is
            rt_db::sqlite_close(hs[k])
        elsif c == "qb1" is
            out = tok_add(out, tok_h(rt_db::sqlite_query_bind1(fld(f[1]), fld(f[2]), fld(f[3]))))
        elsif c == "qb2" is
            out = tok_add(out, tok_h(rt_db::sqlite_query_bind2(fld(f[1]), fld(f[2]), fld(f[3]), fld(f[4]))))
        elsif c == "qb3" is
            out = tok_add(out, tok_h(rt_db::sqlite_query_bind3(fld(f[1]), fld(f[2]), fld(f[3]), fld(f[4]), fld(f[5]))))
        elsif c == "cs" || c == "ci" || c == "cf" || c == "cb" || c == "cn" is
            let mut row: int = 0
            if q != 0 && k >= 0 is row = rt_mem::array_get(q, k) end
            let mut col: string = ""
            if f.len() > 2 is col = f[2] end
            if c == "cs" is
                out = tok_add(out, tok_h(rt_db::db_col_str(row, col)))
            elsif c == "ci" is
                out = tok_add(out, to_string(rt_db::db_col_int(row, col)))
            elsif c == "cf" is
                out = tok_add(out, to_string(rt_ptr::f64_bits(rt_db::db_col_float(row, col))))
            elsif c == "cb" is
                out = tok_add(out, to_string(rt_db::db_col_bool(row, col)))
            else
                out = tok_add(out, to_string(rt_db::db_col_is_null(row, col)))
            end
        end
        i += 1
    end
    rt_os::change_dir("/")
    return out
end

fn run_op(op: string, a: string, b: string, c: string) -> string is
    if op == "trim" is return rt_str::hex_encode(rt_str::trim(a)) end
    if op == "trim_start" is return rt_str::hex_encode(rt_str::trim_start(a)) end
    if op == "trim_end" is return rt_str::hex_encode(rt_str::trim_end(a)) end
    if op == "upper" is return rt_str::hex_encode(rt_str::to_upper(a)) end
    if op == "lower" is return rt_str::hex_encode(rt_str::to_lower(a)) end
    if op == "hexe" is return rt_str::hex_encode(rt_str::hex_encode(a)) end
    if op == "indexof" is return "#" + to_string(rt_str::index_of(a, b)) end
    if op == "starts" is return "#" + bool_n(rt_str::starts_with(a, b)) end
    if op == "ends" is return "#" + bool_n(rt_str::ends_with(a, b)) end
    if op == "replace" is return rt_str::hex_encode(rt_str::replace(a, b, c)) end
    if op == "repeat" is return rt_str::hex_encode(rt_str::repeat(a, to_int(b))) end
    if op == "pad" is return rt_str::hex_encode(rt_str::pad_right(a, to_int(b))) end
    if op == "join" is return rt_str::hex_encode(rt_path::join(a, b)) end
    if op == "filename" is return rt_str::hex_encode(rt_path::filename(a)) end
    if op == "stem" is return rt_str::hex_encode(rt_path::stem(a)) end
    if op == "ext" is return rt_str::hex_encode(rt_path::extension(a)) end
    if op == "parent" is return rt_str::hex_encode(rt_path::parent(a)) end
    if op == "norm" is return rt_str::hex_encode(rt_path::normalize(a)) end
    if op == "withext" is return rt_str::hex_encode(rt_path::with_extension(a, b)) end
    if op == "isabs" is return "#" + bool_n(rt_path::is_absolute(a)) end
    if op == "b64e" is return rt_str::hex_encode(rt_codec::base64_encode(a)) end
    if op == "b64d" is return rt_str::hex_encode(rt_codec::base64_decode(a)) end
    if op == "urle" is return rt_str::hex_encode(rt_codec::url_encode(a)) end
    if op == "urld" is return rt_str::hex_encode(rt_codec::url_decode(a)) end
    if op == "toint" is return "#" + to_string(rt_conv::to_int(a)) end
    if op == "tointhex" is return "#" + to_string(rt_conv::to_int_from_hex(a)) end
    if op == "charcode" is return "#" + to_string(rt_conv::char_code(a)) end
    if op == "dyear" is return "#" + to_string(rt_date::year(to_int(a))) end
    if op == "dmonth" is return "#" + to_string(rt_date::month(to_int(a))) end
    if op == "dday" is return "#" + to_string(rt_date::day(to_int(a))) end
    if op == "dweekday" is return rt_str::hex_encode(rt_date::weekday(to_int(a))) end
    if op == "daddd" is return "#" + to_string(rt_date::add_days(to_int(a), to_int(b))) end
    if op == "daddh" is return "#" + to_string(rt_date::add_hours(to_int(a), to_int(b))) end
    if op == "ddiff" is return "#" + to_string(rt_date::diff_days(to_int(a), to_int(b))) end
    if op == "dparse" is return "#" + to_string(rt_date::parse(a)) end
    if op == "find" is return "#" + to_string(rt_str::find(a, b)) end
    if op == "rfind" is return "#" + to_string(rt_str::rfind(a, b)) end
    if op == "at" is return rt_str::hex_encode(rt_str::at(a, to_int(b))) end
    if op == "slice" is return rt_str::hex_encode(rt_str::slice(a, to_int(b), to_int(c))) end
    if op == "trimr" is return rt_str::hex_encode(rt_str::trim_right(a)) end
    if op == "splitc" is return "#" + to_string(rt_str::split_count(a, b)) end
    if op == "splitp" is return rt_str::hex_encode(rt_str::split_part(a, b, to_int(c))) end
    if op == "absi" is return "#" + to_string(rt_num::abs_i(to_int(a))) end
    if op == "mini" is return "#" + to_string(rt_num::min_i(to_int(a), to_int(b))) end
    if op == "maxi" is return "#" + to_string(rt_num::max_i(to_int(a), to_int(b))) end
    if op == "atoll" is return "#" + to_string(rt_num::atoll(a)) end
    if op == "f2i" is return "#" + to_string(rt_num::float_to_int(dd(a))) end
    if op == "f_tofloat" is return "!" + rt_num::fmt6(rt_num::to_float(a)) end
    if starts_f(op) is return "!" + run_float(op, dd(a), dd(b)) end
    if op == "hexd" is return rt_str::hex_encode(rt_bytes::hex_decode(a)) end
    if op == "hexx" is return rt_str::hex_encode(rt_bytes::hex_xor(a, b)) end
    if op == "hexeb" is return rt_str::hex_encode(rt_bytes::hex_encode_bytes(ints(a))) end
    if op == "bfrom" is return rt_str::hex_encode(list_s(rt_bytes::bytes_from_ints(ints(a)))) end
    if op == "bto" is return rt_str::hex_encode(list_s(rt_bytes::bytes_to_ints(ints(a)))) end
    if op == "bcat" is return rt_str::hex_encode(list_s(rt_bytes::bytes_concat(ints(a), ints(b)))) end
    if op == "blen" is return "#" + to_string(rt_bytes::bytes_len(ints(a))) end
    if op == "bstr" is return rt_str::hex_encode(rt_bytes::bytes_to_str_lossy(ints(a))) end
    if op == "slower" is return rt_str::hex_encode(rt_str::string_lower(a)) end
    if op == "supper" is return rt_str::hex_encode(rt_str::string_upper(a)) end
    if op == "strim" is return rt_str::hex_encode(rt_str::string_trim(a)) end
