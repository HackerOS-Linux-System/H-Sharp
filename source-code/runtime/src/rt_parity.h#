fn run_fs(script: string) -> string is
    let dir: string = "/tmp/hsfs_parity_" + to_string(rt_sys::pid()) + "_" + rt_crypto::md5(script)
    rt_os::mkdir_all(dir)
    rt_os::change_dir(dir)
    let mut out: string = ""
    let cmds: [string] = __builtin_str_split(script, ";")
    let mut i: int = 0
    while i < cmds.len() is
        let f: [string] = __builtin_str_split(cmds[i], ",")
        let c: string = f[0]
        let mut x: string = ""
        let mut y: string = ""
        if f.len() > 1 is x = f[1] end
        if f.len() > 2 is y = f[2] end
        if c == "mkd" is
            out = tok_add(out, nb(rt_os::dir_create(x)))
        elsif c == "mkall" is
            out = tok_add(out, nb(rt_os::mkdir_all(x)))
        elsif c == "wf" is
            out = tok_add(out, nb(rt_os::write_file(x, y)))
        elsif c == "af" is
            out = tok_add(out, nb(rt_os::append_file(x, y)))
        elsif c == "rf" is
            out = tok_add(out, tok_h(rt_os::read_file(x)))
        elsif c == "ex" is
            out = tok_add(out, nb(rt_os::file_exists(x)))
        elsif c == "isf" is
            out = tok_add(out, nb(rt_os::is_file(x)))
        elsif c == "isd" is
            out = tok_add(out, nb(rt_os::is_dir(x)))
        elsif c == "de" is
            out = tok_add(out, nb(rt_os::dir_exists(x)))
        elsif c == "sz" is
            out = tok_add(out, to_string(rt_os::file_size(x)))
        elsif c == "del" is
            out = tok_add(out, nb(rt_os::file_delete(x)))
        elsif c == "rm" is
            out = tok_add(out, nb(rt_os::remove_file(x)))
        elsif c == "mv" is
            out = tok_add(out, nb(rt_os::rename_file(x, y)))
        elsif c == "rmd" is
            out = tok_add(out, nb(rt_os::fs_rmdir(x)))
        elsif c == "cd" is
            out = tok_add(out, nb(rt_os::change_dir(x)))
        elsif c == "cp" is
            out = tok_add(out, nb(rt_os::fs_copy(x, y)))
        elsif c == "ls" is
            out = tok_add(out, strs_tok(rt_sort::sort_strings(rt_os::fs_list_dir(x))))
        elsif c == "walk" is
            out = tok_add(out, strs_tok(rt_sort::sort_strings(rt_os::fs_walk(x))))
        elsif c == "mtime" is
            let m: int = rt_os::fs_modified_time(x)
            if m == -1 is
                out = tok_add(out, "-1")
            else
                let d: int = m - rt_sys::now_unix()
                if d > -100 && d < 100 is out = tok_add(out, "ok") else out = tok_add(out, "bad") end
            end
        elsif c == "rb" is
            out = tok_add(out, ints_tok(rt_os::fs_read_bytes(x)))
        elsif c == "wb" is
            out = tok_add(out, nb(rt_os::fs_write_bytes(x, dints(y))))
        elsif c == "rl" is
            out = tok_add(out, strs_tok(rt_os::fs_read_lines(x)))
        elsif c == "tmpf" is
            let t: string = rt_os::fs_temp_file(x)
            let mut ok: bool = t.len() > 0 && rt_os::file_exists(t)
            if ok is
                let parts: [string] = __builtin_str_split(t, "/")
                let base: string = parts[parts.len() - 1]
                ok = rt_str::starts_with(base, x) && base.len() == x.len() + 6
            end
            if t.len() > 0 is rt_os::file_delete(t) end
            if ok is out = tok_add(out, "ok") else out = tok_add(out, "bad") end
        elsif c == "rmall" is
            out = tok_add(out, nb(rt_os::dir_remove_all(x)))
        elsif c == "rmrec" is
            out = tok_add(out, nb(rt_os::remove_dir_recursive(x)))
        end
        i += 1
    end
    rt_os::change_dir("/")
    return out
end

fn run_env(script: string) -> string is
    let mut out: string = ""
    let cmds: [string] = __builtin_str_split(script, ";")
    let mut i: int = 0
    while i < cmds.len() is
        let f: [string] = __builtin_str_split(cmds[i], ",")
        let c: string = f[0]
        let mut x: string = ""
        let mut y: string = ""
        if f.len() > 1 is x = f[1] end
        if f.len() > 2 is y = f[2] end
        if c == "set" is
            out = tok_add(out, nb(rt_os::setenv_s(x, y)))
        elsif c == "get" is
            out = tok_add(out, tok_h(rt_os::getenv_s(x)))
        elsif c == "eget" is
            out = tok_add(out, tok_h(rt_os::env_get(x)))
        elsif c == "rm" is
            out = tok_add(out, nb(rt_os::env_remove(x)))
        elsif c == "vars" is
            let a: int = rt_env::env_vars()
            let mut joined: string = ""
            let mut cnt: int = 0
            let mut j: int = 0
            while j < rt_mem::array_len(a) is
                let e: string = rt_mem::text_at(rt_mem::array_get(a, j))
                if !(e.len() >= 2 && e[0..2] == "_=") is
                    joined += e + "\n"
                    cnt += 1
                end
                j += 1
            end
            out = tok_add(out, to_string(cnt))
            out = tok_add(out, rt_crypto::md5(joined))
        end
        i += 1
    end
    return out
end

