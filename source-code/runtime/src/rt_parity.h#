fn run_ptrs(script: string) -> string is
    let buf: int = rt_ptr::buf_new(64)
    let mut out: string = ""
    let cmds: [string] = __builtin_str_split(script, ";")
    let mut i: int = 0
    while i < cmds.len() is
        let f: [string] = __builtin_str_split(cmds[i], ",")
        let c: string = f[0]
        if c == "w8" is
            rt_ptr::ptr_write_i8(buf, to_int(f[1]), to_int(f[2]))
        elsif c == "w16" is
            rt_ptr::ptr_write_i16(buf, to_int(f[1]), to_int(f[2]))
        elsif c == "w32" is
            rt_ptr::ptr_write_i32(buf, to_int(f[1]), to_int(f[2]))
        elsif c == "w64" is
            rt_ptr::ptr_write_i64(buf, to_int(f[1]), to_int(f[2]))
        elsif c == "wp" is
            rt_ptr::ptr_write_ptr(buf, to_int(f[1]), to_int(f[2]))
        elsif c == "r8" is
            out = tok_add(out, to_string(rt_ptr::ptr_read_i8(buf, to_int(f[1]))))
        elsif c == "r16" is
            out = tok_add(out, to_string(rt_ptr::ptr_read_i16(buf, to_int(f[1]))))
        elsif c == "r32" is
            out = tok_add(out, to_string(rt_ptr::ptr_read_i32(buf, to_int(f[1]))))
        elsif c == "r64" is
            out = tok_add(out, to_string(rt_ptr::ptr_read_i64(buf, to_int(f[1]))))
        elsif c == "rp" is
            out = tok_add(out, to_string(rt_ptr::ptr_read_ptr(buf, to_int(f[1]))))
        elsif c == "fill" is
            rt_ptr::ptr_fill(buf + to_int(f[1]), to_int(f[2]), to_int(f[3]))
        elsif c == "zero" is
            rt_ptr::ptr_zero(buf + to_int(f[1]), to_int(f[2]))
        elsif c == "copy" is
            rt_ptr::ptr_copy(buf + to_int(f[1]), buf + to_int(f[2]), to_int(f[3]))
        elsif c == "cmp" is
            out = tok_add(out, to_string(sgn(rt_ptr::ptr_compare(buf + to_int(f[1]), buf + to_int(f[2]), to_int(f[3])))))
        elsif c == "null" is
            out = tok_add(out, nb(rt_ptr::ptr_is_null(buf)))
            out = tok_add(out, nb(rt_ptr::ptr_is_null(0)))
        elsif c == "add" is
            out = tok_add(out, to_string(rt_ptr::ptr_add(buf, to_int(f[1])) - buf))
        elsif c == "addnull" is
            out = tok_add(out, to_string(rt_ptr::ptr_add(0, 5)))
        elsif c == "rnull" is
            out = tok_add(out, to_string(rt_ptr::ptr_read_i64(0, 0)))
            out = tok_add(out, to_string(rt_ptr::ptr_read_i8(0, 3)))
            out = tok_add(out, to_string(rt_ptr::ptr_read_ptr(0, 0)))
        elsif c == "wnull" is
            rt_ptr::ptr_write_i64(0, 0, 1)
            rt_ptr::ptr_write_i8(0, 2, 3)
            rt_ptr::ptr_fill(0, 1, 4)
            rt_ptr::ptr_zero(0, 4)
            rt_ptr::ptr_copy(0, buf, 4)
            rt_ptr::ptr_copy(buf, 0, 4)
            out = tok_add(out, "ok")
        elsif c == "wd" is
            rt_ptr::ptr_write_f64(buf, to_int(f[1]), rt_num::to_float(f[2]))
        elsif c == "rd" is
            out = tok_add(out, to_string(rt_ptr::f64_bits(rt_ptr::ptr_read_f64(buf, to_int(f[1])))))
        elsif c == "wf" is
            rt_ptr::ptr_write_f32(buf, to_int(f[1]), rt_num::to_float(f[2]))
        elsif c == "rf" is
            out = tok_add(out, to_string(rt_ptr::f64_bits(rt_ptr::ptr_read_f32(buf, to_int(f[1])))))
        elsif c == "fnull" is
            out = tok_add(out, to_string(rt_ptr::f64_bits(rt_ptr::ptr_read_f64(0, 0))))
            out = tok_add(out, to_string(rt_ptr::f64_bits(rt_ptr::ptr_read_f32(0, 0))))
            rt_ptr::ptr_write_f64(0, 0, 1.5)
            rt_ptr::ptr_write_f32(0, 0, 1.5)
        elsif c == "sset" is
            out = tok_add(out, to_string(rt_ptr::struct_set(buf, to_int(f[1]), to_int(f[2])) - buf))
        elsif c == "sget" is
            out = tok_add(out, to_string(rt_ptr::struct_get(buf, to_int(f[1]))))
        elsif c == "snull" is
            out = tok_add(out, to_string(rt_ptr::struct_get(0, 3)))
            out = tok_add(out, to_string(rt_ptr::struct_set(0, 1, 2)))
        elsif c == "rc" is
            let blk: int = rt_ptr::rc_alloc(to_int(f[1]))
            out = tok_add(out, to_string(rt_ptr::ptr_alloc_size(blk)))
            out = tok_add(out, to_string(rt_ptr::ptr_alloc_size(0)))
        elsif c == "sfree" is
            rt_ptr::string_free("x")
            out = tok_add(out, "ok")
        elsif c == "cmpn" is
            out = tok_add(out, to_string(sgn(rt_ptr::ptr_compare(0, buf, 4))))
            out = tok_add(out, to_string(sgn(rt_ptr::ptr_compare(buf, 0, 4))))
            out = tok_add(out, to_string(sgn(rt_ptr::ptr_compare(0, 0, 4))))
            out = tok_add(out, to_string(sgn(rt_ptr::ptr_compare(buf, buf, 4))))
            out = tok_add(out, to_string(sgn(rt_ptr::ptr_compare(buf, buf + 1, 0))))
        end
        i += 1
    end
    rt_ptr::buf_free(buf)
    return out
end

fn strs_tok(a: [string]) -> string is
    if a.len() == 0 is return "-" end
    let mut out: string = ""
    let mut i: int = 0
    while i < a.len() is
        if i > 0 is out += "." end
        if a[i].len() == 0 is out += "_" else out += rt_str::hex_encode(a[i]) end
        i += 1
    end
    return out
end

