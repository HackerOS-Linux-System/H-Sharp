;; ── script ops (see tests/parity_c.c): "cmd,arg,arg;cmd,arg" -> one comma separated token per command ──
fn tok_h(s: string) -> string is
    if s.len() == 0 is return "-" end
    return rt_str::hex_encode(s)
end

fn tok_add(acc: string, t: string) -> string is
    if acc.len() == 0 is return t end
    return acc + "," + t
end

fn sgn(v: int) -> int is
    if v < 0 is return -1 end
    if v > 0 is return 1 end
    return 0
end

