mod rt_raw
fn is_ws4(c: int) -> bool is
    return c == 32 || c == 9 || c == 10 || c == 13
end

fn is_ws6(c: int) -> bool is
    return is_ws4(c) || c == 11 || c == 12
end

;; core.c hsh_trim
pub fn trim(s: string) -> string is
    let mut a: int = 0
    let mut b: int = s.len()
    while a < b && is_ws4(byte_at(s, a)) is a += 1 end
    while b > a && is_ws4(byte_at(s, b - 1)) is b -= 1 end
    return s[a..b]
end

;; core.c hsh_trim_start
pub fn trim_start(s: string) -> string is
    let mut a: int = 0
    while a < s.len() && is_ws6(byte_at(s, a)) is a += 1 end
    return s[a..s.len()]
end

;; core.c hsh_trim_end
pub fn trim_end(s: string) -> string is
    let mut b: int = s.len()
    while b > 0 && is_ws6(byte_at(s, b - 1)) is b -= 1 end
    return s[0..b]
end

;; core.c hsh_str_index_of: byte offset of the first occurrence, -1 when absent, 0 for an empty `sub` (strstr)
pub fn index_of(s: string, sub: string) -> int is
    let n: int = s.len()
    let m: int = sub.len()
    if m == 0 is return 0 end
    let mut i: int = 0
    while i + m <= n is
        let mut j: int = 0
        while j < m && byte_at(s, i + j) == byte_at(sub, j) is j += 1 end
        if j == m is return i end
        i += 1
    end
    return -1
end

;; core.c hsh_str_contains
pub fn contains_h(s: string, sub: string) -> bool is
    return index_of(s, sub) >= 0
end

;; core.c hsh_to_upper / hsh_to_lower
pub fn to_upper_h(s: string) -> string is
    ;; bytes collected in an int array and turned into a string once (an `out += ..` per byte was quadratic and never freed: OOM near 100 KB)
    let n: int = s.len()
    let mut out: [int] = []
    let mut i: int = 0
    while i < n is
        let c: int = byte_at(s, i)
        if c >= 97 && c <= 122 is out.push(c - 32) else out.push(c) end
        i += 1
    end
    return rt_raw::string_from_ints(out)
end

pub fn to_lower_h(s: string) -> string is
    let n: int = s.len()
    let mut out: [int] = []
    let mut i: int = 0
    while i < n is
        let c: int = byte_at(s, i)
        if c >= 65 && c <= 90 is out.push(c + 32) else out.push(c) end
        i += 1
    end
    return rt_raw::string_from_ints(out)
end

;; core.c hsh_hex_encode: lowercase hex of every byte
pub fn hex_encode_h(s: string) -> string is
    ;; one allocation: the digits go into an int array and become the string at the end (appending to a string per byte allocates
    ;; a new string each time, quadratic for large inputs)
    let mut out: [int] = []
    let mut i: int = 0
    while i < s.len() is
        let c: int = byte_at(s, i)
        let hi: int = c / 16
        let lo: int = c % 16
        if hi < 10 is out.push(48 + hi) else out.push(87 + hi) end
        if lo < 10 is out.push(48 + lo) else out.push(87 + lo) end
        i += 1
    end
    return rt_raw::string_from_ints(out)
end

;; core.c hsh_starts_with / hsh_ends_with
pub fn starts_with_h(s: string, p: string) -> bool is
    return s.len() >= p.len() && s[0..p.len()] == p
end

pub fn ends_with_h(s: string, p: string) -> bool is
    return s.len() >= p.len() && s[s.len() - p.len()..s.len()] == p
end

;; core.c hsh_str_replace: every non-overlapping occurrence, left to right; an empty `from` changes nothing
pub fn replace_h(s: string, from: string, to: string) -> string is
    let m: int = from.len()
    if m == 0 is return s end
    let n: int = s.len()
    let f0: int = byte_at(from, 0)
    let mut tb: [int] = []
    let mut q: int = 0
    while q < to.len() is
        tb.push(byte_at(to, q))
        q += 1
    end
    ;; one pass, bytes appended to an int array: linear time and memory (the old version re-sliced the whole remainder per hit)
    let mut out: [int] = []
    let mut hit: bool = false
    let mut i: int = 0
    while i < n is
        let c: int = byte_at(s, i)
        let mut ok: bool = false
        if c == f0 && i + m <= n is
            ok = true
            let mut k: int = 1
            while k < m && ok is
                if byte_at(s, i + k) != byte_at(from, k) is ok = false end
                k += 1
            end
        end
        if ok is
            hit = true
            let mut j: int = 0
            while j < tb.len() is
                out.push(tb[j])
                j += 1
            end
            i += m
        else
            out.push(c)
            i += 1
        end
    end
    if !hit is return s end
    return rt_raw::string_from_ints(out)
end

;; core.c hsh_string_repeat: "" for n <= 0
pub fn repeat(s: string, n: int) -> string is
    let l: int = s.len()
    if n <= 0 || l == 0 is return "" end
    ;; one allocation (the old `out += s` loop copied the whole result n times: quadratic, and it exhausted memory for large n)
    let buf: int = malloc(l * n + 1)
    if buf == 0 is return "" end
    let mut i: int = 0
    while i < n is
        memcpy(buf + i * l, s, l)
        i += 1
    end
    memset(buf + l * n, 0, 1)
    let r: string = strdup(buf)
    free(buf)
    return r
end

;; core.c hsh_string_pad_right: pads with spaces up to `width` BYTES; longer strings are returned unchanged
pub fn pad_right(s: string, width: int) -> string is
    if s.len() >= width is return s end
    return s + repeat(" ", width - s.len())
end

;; core.c hsh_string_find (strstr: "" matches at 0) / hsh_string_rfind (last occurrence; "" -> len)
pub fn find(s: string, sub: string) -> int is
    return index_of(s, sub)
end

pub fn rfind(s: string, sub: string) -> int is
    let n: int = s.len()
    let m: int = sub.len()
    if m > n is return -1 end
    let mut i: int = n - m
    while i >= 0 is
        if s[i..i + m] == sub is return i end
        i -= 1
    end
    return -1
end

;; core.c hsh_string_at: the single BYTE at idx, "" when out of range (a UTF-8 lead byte alone is not valid text)
pub fn at(s: string, idx: int) -> string is
    if idx < 0 || idx >= s.len() is return "" end
    return s[idx..idx + 1]
end

;; core.c hsh_string_slice: byte range [start, end), clamped; "" when empty
pub fn slice(s: string, start0: int, stop0: int) -> string is
    let mut start: int = start0
    let mut stop: int = stop0
    if start < 0 is start = 0 end
    if stop > s.len() is stop = s.len() end
    if start >= stop is return "" end
    return s[start..stop]
end

;; core.c hsh_string_trim_right (isspace: also \v \f)
pub fn trim_right(s: string) -> string is
    return trim_end(s)
end

;; core.c hsh_str_split_count / hsh_str_split_part: split on a separator; "" separates every byte
pub fn split_count(s: string, sep: string) -> int is
    if sep.len() == 0 is
        if s.len() == 0 is return 1 end
        return s.len()
    end
    let mut count: int = 1
    let mut at_: int = 0
    while true is
        let k: int = index_of(s[at_..s.len()], sep)
        if k < 0 is return count end
        count += 1
        at_ += k + sep.len()
    end
    return count
end

pub fn split_part(s: string, sep: string, index: int) -> string is
    if index < 0 is return "" end
    if sep.len() == 0 is
        if index >= s.len() is return "" end
        return s[index..index + 1]
    end
    let mut at_: int = 0
    let mut cur: int = 0
    while true is
        let rest: string = s[at_..s.len()]
        let k: int = index_of(rest, sep)
        if cur == index is
            if k < 0 is return rest end
            return rest[0..k]
        end
        if k < 0 is return "" end
        at_ += k + sep.len()
        cur += 1
    end
    return ""
end

;; ── thin aliases in core.c (hsh_string_* / hsh_strlen / hsh_strcat): the C bodies just call the function ported above ──
;; core.c hsh_string_contains -> hsh_str_contains; hsh_string_starts_with/ends_with -> hsh_starts_with/ends_with;
;; hsh_string_trim -> hsh_trim; hsh_string_replace -> hsh_str_replace; hsh_string_lower/upper = ASCII tolower/toupper
pub fn string_contains(s: string, sub: string) -> bool is return rt_str::contains_h(s, sub) end
pub fn string_starts_with(s: string, p: string) -> bool is return rt_str::starts_with_h(s, p) end
pub fn string_ends_with(s: string, p: string) -> bool is return rt_str::ends_with_h(s, p) end
pub fn string_trim(s: string) -> string is return trim(s) end
pub fn string_replace(s: string, from: string, to: string) -> string is return rt_str::replace_h(s, from, to) end
pub fn string_lower(s: string) -> string is return rt_str::to_lower_h(s) end
pub fn string_upper(s: string) -> string is return rt_str::to_upper_h(s) end

;; core.c hsh_string_len / hsh_strlen: length in BYTES (NULL -> 0)
pub fn string_len(s: string) -> int is return s.len() end
pub fn strlen(s: string) -> int is return s.len() end

;; core.c hsh_strcat. The compiler lowers every string `+` to a call of hsh_strcat, so this function must not use `+` itself (it would
;; recurse forever once hsh_strcat is exported under its C name): bytes are glued in a malloc'd scratch buffer and copied out with strdup.
extern static [c] is
    fn malloc(n: int) -> int
    fn free(p: int) -> int
    fn memcpy(dst: int, src: string, n: int) -> int
    fn memset(p: int, c: int, n: int) -> int
    fn strdup(p: int) -> string
end

pub fn strcat(a: string, b: string) -> string is
    let la: int = a.len()
    let lb: int = b.len()
    let buf: int = malloc(la + lb + 1)
    if buf == 0 is return "" end
    memcpy(buf, a, la)
    memcpy(buf + la, b, lb)
    memset(buf + la + lb, 0, 1)
    let r: string = strdup(buf)
    free(buf)
    return r
end

;; core.c hsh_substr: byte range [start, end); start < 0 -> 0, end < 0 or end > len -> len (NOT clamped to 0 like string_slice);
;; "" when start >= end
pub fn substr(s: string, start0: int, end0: int) -> string is
    let n: int = s.len()
    let mut start: int = start0
    let mut e: int = end0
    if start < 0 is start = 0 end
    if e < 0 || e > n is e = n end
    if start >= e is return "" end
    return s[start..e]
end

;; core.c hsh_str_split_whitespace: runs of isspace (' ', \t \n \v \f \r) separate tokens, no empty tokens
pub fn split_whitespace(s: string) -> [string] is
    let mut out: [string] = []
    let n: int = s.len()
    let mut i: int = 0
    while i < n is
        while i < n && is_ws6(byte_at(s, i)) is i += 1 end
        if i < n is
            let start: int = i
            while i < n && !is_ws6(byte_at(s, i)) is i += 1 end
            out.push(s[start..i])
        end
    end
    return out
end

;; core.c hsh_string_chars: one string per UTF-8 character.  Length from the lead byte (1 for ASCII/continuation/invalid, 2 for
;; C0.., 3 for E0.., 4 for F0..), cut short at the end of the string or at the first byte that is not a continuation byte.
pub fn string_chars(s: string) -> [string] is
    let mut out: [string] = []
    let n: int = s.len()
    let mut i: int = 0
    while i < n is
        let b: int = byte_at(s, i)
        let mut len: int = 1
        if b >= 240 is
            len = 4
        elsif b >= 224 is
            len = 3
        elsif b >= 192 is
            len = 2
        end
        if b < 128 is len = 1 end
        if i + len > n is len = n - i end
        let mut k: int = 1
        while k < len is
            if (byte_at(s, i + k) & 192) != 128 is
                len = k
                k = len + 1
            else
                k += 1
            end
        end
        out.push(s[i..i + len])
        i += len
    end
    return out
end

;; core.c hsh_string_split: split on every occurrence of `sep` (non-overlapping, left to right, empty parts kept); an empty `sep`
;; gives [str]
pub fn string_split(str: string, sep: string) -> [string] is
    let mut out: [string] = []
    if sep.len() == 0 is
        out.push(str)
        return out
    end
    ;; scan with an offset: the old version re-sliced the whole remainder per separator (quadratic, OOM at ~200k parts)
    let n: int = str.len()
    let m: int = sep.len()
    let f0: int = byte_at(sep, 0)
    let mut start: int = 0
    let mut i: int = 0
    while i + m <= n is
        let mut ok: bool = false
        if byte_at(str, i) == f0 is
            ok = true
            let mut k: int = 1
            while k < m && ok is
                if byte_at(str, i + k) != byte_at(sep, k) is ok = false end
                k += 1
            end
        end
        if ok is
            out.push(str[start..i])
            i += m
            start = i
        else
            i += 1
        end
    end
    out.push(str[start..n])
    return out
end

;; core.c hsh_array_join (array of strings): parts glued with `sep`; "" for an empty array
pub fn array_join(a: [string], sep: string) -> string is
    let cnt: int = a.len()
    if cnt == 0 is return "" end
    if cnt == 1 is return a[0] end
    let sl: int = sep.len()
    let mut total: int = sl * (cnt - 1)
    let mut i: int = 0
    while i < cnt is
        total += a[i].len()
        i += 1
    end
    ;; one buffer, every part copied once (appending to a string per part was quadratic and never freed)
    let buf: int = malloc(total + 1)
    if buf == 0 is return "" end
    let mut w: int = 0
    i = 0
    while i < cnt is
        if i > 0 && sl > 0 is
            memcpy(buf + w, sep, sl)
            w += sl
        end
        let el: string = a[i]
        let el_len: int = el.len()
        if el_len > 0 is
            memcpy(buf + w, el, el_len)
            w += el_len
        end
        i += 1
    end
    memset(buf + w, 0, 1)
    let r: string = strdup(buf)
    free(buf)
    return r
end
