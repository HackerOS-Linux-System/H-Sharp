extern static [c] is
    fn pthread_mutex_lock(m: int) -> int
    fn pthread_mutex_unlock(m: int) -> int
    fn pthread_mutex_destroy(m: int) -> int
    fn pthread_cond_wait(c: int, m: int) -> int
    fn pthread_cond_timedwait(c: int, m: int, ts: int) -> int
    fn pthread_cond_destroy(c: int) -> int
    fn pthread_join(t: int, ret: int) -> int
    fn clock_gettime(clk: int, ts: int) -> int
    fn hsh_task_spawn(fn_ptr: int, args: int) -> int
    fn hsh_task_spawn_shell(cmd: string) -> int
end

fn magic() -> int is return 79522532966739 end

;; a C int returned in a 64-bit register: low 32 bits, sign-extended
fn cint(x: int) -> int is
    let v: int = x & 4294967295
    if v >= 2147483648 is return v - 4294967296 end
    return v
end

;; hsh_looks_like_task_ptr + the magic check: true when `h` points at a task descriptor
fn is_task(h: int) -> bool is
    if h == 0 || h < 65536 is return false end
    return rt_ptr::ptr_read_i64(h, 0) == magic()
end

;; core.c hsh_task_wait
pub fn task_wait(handle: int) -> int is
    if handle == 0 is return 0 end
    if !is_task(handle) is return handle end
    let mu: int = handle + 48
    let cv: int = handle + 88
    pthread_mutex_lock(mu)
    while rt_ptr::ptr_read_i32(handle, 40) == 0 is
        pthread_cond_wait(cv, mu)
    end
    let result: int = rt_ptr::ptr_read_i64(handle, 32)
    pthread_mutex_unlock(mu)
    pthread_join(rt_ptr::ptr_read_i64(handle, 8), 0)
    pthread_mutex_destroy(mu)
    pthread_cond_destroy(cv)
    rt_ptr::buf_free(handle)
    return result
end

;; core.c hsh_task_wait_timeout: 1 = finished within `ms` (or nothing to wait for), 0 = still running
pub fn task_wait_timeout(handle: int, ms0: int) -> int is
    if handle == 0 is return 1 end
    if !is_task(handle) is return 1 end
    let mut ms: int = ms0
    if ms < 0 is ms = 0 end
    let ts: int = rt_ptr::buf_new(16)
    clock_gettime(0, ts)
    let mut sec: int = rt_ptr::ptr_read_i64(ts, 0) + ms / 1000
    let mut nsec: int = rt_ptr::ptr_read_i64(ts, 8) + (ms % 1000) * 1000000
    if nsec >= 1000000000 is
        sec += 1
        nsec -= 1000000000
    end
    rt_ptr::ptr_write_i64(ts, 0, sec)
    rt_ptr::ptr_write_i64(ts, 8, nsec)
    let mu: int = handle + 48
    let cv: int = handle + 88
    pthread_mutex_lock(mu)
    let mut waiting: bool = true
    while waiting && rt_ptr::ptr_read_i32(handle, 40) == 0 is
        let rc: int = cint(pthread_cond_timedwait(cv, mu, ts))
        if rc != 0 is waiting = false end
    end
    let ready: int = rt_ptr::ptr_read_i32(handle, 40)
    pthread_mutex_unlock(mu)
    rt_ptr::buf_free(ts)
    if ready != 0 is return 1 end
    return 0
end

;; core.c hsh_task_join_all(void** handles, int n): a new block of n int64 results (the caller frees it), 0 for n < 0
pub fn task_join_all(handles: int, n: int) -> int is
    if n < 0 is return 0 end
    let results: int = rt_ptr::buf_new(n * 8 + 8)
    let mut i: int = 0
    while i < n is
        rt_ptr::ptr_write_i64(results, i * 8, task_wait(rt_ptr::ptr_read_ptr(handles, i * 8)))
        i += 1
    end
    return results
end


;; ── spawning (core.c / async_rt.c hsh_task_spawn, hsh_task_spawn_shell) ──
;; Starting a thread needs two things H# cannot express without compiler builtins that h# 0.9.0 does not have (`fn_addr` to hand pthread_create the
;; address of an H# function, `call_ptr` to call it indirectly): a C-callable thread entry point and an indirect call.  Both live in the C runtime
;; (compiler/runtime/async_rt.c), which is linked into every program, so spawning is a forward to it.  That also keeps the bounded-concurrency
;; semaphore (HSH_MAX_TASKS, else 64 per core clamped to 64..4096) in one place.  The task descriptor it returns is the block that task_wait,
;; task_wait_timeout and task_join_all above read field by field (magic @0, pthread_t @8, fn @16, args @24, result @32, done @40, mutex @48, cond @88).

;; core.c hsh_task_spawn(fn_ptr, args): a joinable thread running fn_ptr(args); blocks while HSH_MAX_TASKS tasks are in flight; 0 on failure
pub fn task_spawn(fn_ptr: int, args: int) -> int is
    return hsh_task_spawn(fn_ptr, args)
end

;; core.c hsh_task_spawn_shell(cmd): the command is copied (truncated to 4095 bytes) and run on a task thread; the task result is a malloc'd copy
;; of the output (the caller frees it), -1 when popen fails
pub fn task_spawn_shell(cmd: string) -> int is
    return hsh_task_spawn_shell(cmd)
end
