fn magic() -> int is return 79522532966739 end

;; a C int returned in a 64-bit register: low 32 bits, sign-extended
fn cint(x: int) -> int is
    let v: int = x & 4294967295
    if v >= 2147483648 is return v - 4294967296 end
    return v
end

;; hsh_looks_like_task_ptr + the magic check: true when `h` points at a task descriptor
fn is_task(h: int) -> bool is
    if h == 0 || h < 65536 is return false end
    return rt_ptr::ptr_read_i64(h, 0) == magic()
end

;; core.c hsh_task_wait
pub fn task_wait(handle: int) -> int is
    if handle == 0 is return 0 end
    if !is_task(handle) is return handle end
    let mu: int = handle + 48
    let cv: int = handle + 88
    pthread_mutex_lock(mu)
    while rt_ptr::ptr_read_i32(handle, 40) == 0 is
        pthread_cond_wait(cv, mu)
    end
    let result: int = rt_ptr::ptr_read_i64(handle, 32)
    pthread_mutex_unlock(mu)
    pthread_join(rt_ptr::ptr_read_i64(handle, 8), 0)
    pthread_mutex_destroy(mu)
    pthread_cond_destroy(cv)
    rt_ptr::buf_free(handle)
    return result
end

;; core.c hsh_task_wait_timeout: 1 = finished within `ms` (or nothing to wait for), 0 = still running
pub fn task_wait_timeout(handle: int, ms0: int) -> int is
    if handle == 0 is return 1 end
    if !is_task(handle) is return 1 end
    let mut ms: int = ms0
    if ms < 0 is ms = 0 end
    let ts: int = rt_ptr::buf_new(16)
    clock_gettime(0, ts)
    let mut sec: int = rt_ptr::ptr_read_i64(ts, 0) + ms / 1000
    let mut nsec: int = rt_ptr::ptr_read_i64(ts, 8) + (ms % 1000) * 1000000
    if nsec >= 1000000000 is
        sec += 1
        nsec -= 1000000000
    end
    rt_ptr::ptr_write_i64(ts, 0, sec)
    rt_ptr::ptr_write_i64(ts, 8, nsec)
    let mu: int = handle + 48
    let cv: int = handle + 88
    pthread_mutex_lock(mu)
    let mut waiting: bool = true
    while waiting && rt_ptr::ptr_read_i32(handle, 40) == 0 is
        let rc: int = cint(pthread_cond_timedwait(cv, mu, ts))
        if rc != 0 is waiting = false end
    end
    let ready: int = rt_ptr::ptr_read_i32(handle, 40)
    pthread_mutex_unlock(mu)
    rt_ptr::buf_free(ts)
    if ready != 0 is return 1 end
    return 0
end

;; core.c hsh_task_join_all(void** handles, int n): a new block of n int64 results (the caller frees it), 0 for n < 0
pub fn task_join_all(handles: int, n: int) -> int is
    if n < 0 is return 0 end
    let results: int = rt_ptr::buf_new(n * 8 + 8)
    let mut i: int = 0
    while i < n is
        rt_ptr::ptr_write_i64(results, i * 8, task_wait(rt_ptr::ptr_read_ptr(handles, i * 8)))
        i += 1
    end
    return results
end


;; ── spawning (core.c / async_rt.c hsh_task_spawn, hsh_task_spawn_shell) ──
;; The bounded-concurrency semaphore (HSH_MAX_TASKS, else 64 per core clamped to 64..4096) is a global slot: sem_t at 0, pthread_once_t at 48.
;; Like every global slot it must be created by one thread first — the first spawn of a program comes from main in practice.
fn sem_slot() -> int is return rt_state::global_slot("_HSH_RT_TASKSEM", 64) end

fn sem_init_once() -> int is
    let mut cap: int = 0
    let env: int = getenv("HSH_MAX_TASKS")
    if env != 0 && rt_ptr::peek_byte(env) != 0 is cap = atol(env) end
    if cap <= 0 is
        let mut cores: int = sysconf(84)
        if cores < 1 is cores = 1 end
        cap = cores * 64
    end
    if cap < 64 is cap = 64 end
    if cap > 4096 is cap = 4096 end
    sem_init(sem_slot(), 0, cap)
    return 0
end

;; the pthread entry point: run fn_ptr(args), publish the result under the mutex, wake the waiters, free the concurrency slot
fn task_trampoline(arg: int) -> int is
    let r: int = call_ptr(rt_ptr::ptr_read_i64(arg, 16), rt_ptr::ptr_read_i64(arg, 24), 0, 0, 0)
    pthread_mutex_lock(arg + 48)
    rt_ptr::ptr_write_i64(arg, 32, r)
    rt_ptr::ptr_write_i32(arg, 40, 1)
    pthread_cond_broadcast(arg + 88)
    pthread_mutex_unlock(arg + 48)
    sem_post(sem_slot())
    return 0
end

;; core.c hsh_task_spawn(fn_ptr, args): a joinable thread running fn_ptr(args); blocks while HSH_MAX_TASKS tasks are in flight; 0 on failure
pub fn task_spawn(fn_ptr: int, args: int) -> int is
    let slot: int = sem_slot()
    pthread_once(slot + 48, fn_addr(sem_init_once))
    sem_wait(slot)
    let t: int = rt_ptr::buf_new(136)
    if t == 0 is
        sem_post(slot)
        return 0
    end
    rt_ptr::ptr_write_i64(t, 0, magic())
    rt_ptr::ptr_write_i64(t, 16, fn_ptr)
    rt_ptr::ptr_write_i64(t, 24, args)
    rt_ptr::ptr_write_i32(t, 40, 0)
    pthread_mutex_init(t + 48, 0)
    pthread_cond_init(t + 88, 0)
    let attr: int = rt_ptr::buf_new(64)
    pthread_attr_init(attr)
    pthread_attr_setdetachstate(attr, 0)
    let rc: int = cint(pthread_create(t + 8, attr, fn_addr(task_trampoline), t))
    pthread_attr_destroy(attr)
    rt_ptr::buf_free(attr)
    if rc != 0 is
        rt_io::eprint_s("hsh_task_spawn: pthread_create failed (errno=" + to_string(rc) + ")\n")
        pthread_mutex_destroy(t + 48)
        pthread_cond_destroy(t + 88)
        rt_ptr::buf_free(t)
        sem_post(slot)
        return 0
    end
    return t
end

;; the task body of task_spawn_shell: popen(cmd, "r"), read up to 65535 bytes, pclose; the result is a malloc'd copy of the output (the caller frees
;; it), -1 when popen fails; frees the 4096-byte command block
fn shell_task_fn(sa: int) -> int is
    let fp: int = popen(strdup(sa), "r")
    if fp == 0 is
        free(sa)
        return -1
    end
    let buf: int = rt_ptr::buf_new(65536)
    let n: int = fread(buf, 1, 65535, fp)
    pclose(fp)
    let out: int = rt_ptr::buf_new(n + 1)
    memmove(out, buf, n)
    rt_ptr::buf_free(buf)
    free(sa)
    return out
end

;; core.c hsh_task_spawn_shell(cmd): the command is copied (truncated to 4095 bytes) and run on a task thread
pub fn task_spawn_shell(cmd: string) -> int is
    let sa: int = rt_ptr::buf_new(4096)
    strncpy(sa, cmd, 4095)
    return task_spawn(fn_addr(shell_task_fn), sa)
end
