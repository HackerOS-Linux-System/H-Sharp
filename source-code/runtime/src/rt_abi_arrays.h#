pub fn hsh_crypto_bytes_eq(p0: int, p1: int) -> int is
    if rt_crypto::bytes_eq(rt_marshal::ints_from_raw(p0), rt_marshal::ints_from_raw(p1)) is return 1 end
    return 0
end

pub fn hsh_crypto_xor_bytes(p0: int, p1: int) -> int is
