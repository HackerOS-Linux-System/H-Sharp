pub fn hsh_crypto_sha256_bytes(p0: int) -> string is
    return rt_crypto::sha256_bytes(rt_marshal::ints_from_raw(p0))
end

pub fn hsh_crypto_pbkdf2(p0: string, p1: int, p2: int, p3: int) -> int is
    return rt_marshal::ints_to_raw(rt_crypto::pbkdf2(p0, rt_marshal::ints_from_raw(p1), p2, p3))
end

