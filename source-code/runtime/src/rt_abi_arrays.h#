pub fn hsh_sort_strings(p0: int) -> int is
    ;; in place: the `char*` slots of p0 are reordered, no new strings are made (core.c; hpm calls this as a bare statement)
    if p0 == 0 is return rt_marshal::ints_store(p0, []) end
    return rt_marshal::ints_store(p0, rt_sort::sort_ptrs_by_text(rt_marshal::ints_from_raw(p0), rt_marshal::strs_from_raw(p0)))
end

