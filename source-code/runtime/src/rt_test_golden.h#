fn gold_chunk(data: string, name: string) is
    let rows: [string] = __builtin_str_split(data, "\n")
    let mut bad: int = 0
    let mut total: int = 0
    let mut first: string = ""
    let mut i: int = 0
    while i < rows.len() is
        let row: string = rows[i]
        i += 1
        if row.len() == 0 is continue end
        let halves: [string] = __builtin_str_split(row, "\t=>")
        let parts: [string] = __builtin_str_split(halves[0], "\t")
        let got: string = call(parts[0], parts)
        total += 1
        if got != halves[1] is
            bad += 1
            if first == "" is first = parts[0] + " args=" + halves[0] + " expected=" + halves[1] + " got=" + got end
        end
    end
    if bad > 0 is test::fail(name + ": " + to_string(bad) + " of " + to_string(total) + " golden vectors differ; first: " + first) end
end

