;; Golden vectors for the pure part of the C ABI (strings, numbers, dates, paths, hex / base64 / url, hashes, JSON, regex, ...).
;; Every "call => result" line was produced by core.c itself, so a failure here means the H# port no longer behaves like the C runtime.
;; Self-contained: no C code, no external tools.  Arguments / results are encoded as  s:<hex of the bytes> | i:<decimal> | d:<bits of the f64 as decimal>.
;; Left out on purpose: libm transcendental functions (their last bit differs between libc implementations) and date_format (uses the local time zone).
;; Run:  h# test src/rt_test_golden.h#

mod rt_abi
mod rt_abi_arrays
mod rt_abi_indirect
mod rt_raw
mod rt_ptr


fn hexv(c: int) -> int is
    if c >= 97 is return c - 87 end
    return c - 48
end

fn dec(h: string) -> string is
    let mut bs: [int] = []
    let mut i: int = 0
    while i + 1 < h.len() is
        bs.push(hexv(byte_at(h, i)) * 16 + hexv(byte_at(h, i + 1)))
        i += 2
    end
    return rt_raw::string_from_ints(bs)
end

fn enc(s: string) -> string is
    let d: string = "0123456789abcdef"
    let mut out: [string] = []
    let mut i: int = 0
    let mut r: string = "s:"
    while i < s.len() is
        let c: int = byte_at(s, i)
        r += d[c / 16..c / 16 + 1] + d[c % 16..c % 16 + 1]
        i += 1
    end
    return r
end

fn AS(a: [string], i: int) -> string is return dec(a[i][2..a[i].len()]) end
fn AI(a: [string], i: int) -> int is return to_int(a[i][2..a[i].len()]) end
fn AD(a: [string], i: int) -> f64 is return rt_ptr::bits_f64(to_int(a[i][2..a[i].len()])) end

fn RI(v: int) -> string is return "i:" + to_string(v) end
fn RD(v: f64) -> string is
    if v != v is return "d:nan" end
    return "d:" + to_string(rt_ptr::f64_bits(v))
end

