#[test]
fn hex_decode_and_xor() is
    eq_s(rt_bytes::hex_decode("48656c6c6f"), "Hello")
    eq_s(rt_bytes::hex_decode("zz41"), "A")
    eq_s(rt_bytes::hex_decode("414"), "A")
    eq_s(rt_bytes::hex_decode("00"), "")
    eq_s(rt_bytes::hex_decode("4100" + "42"), "A")
    eq_s(rt_bytes::hex_decode("c3a9"), "é")
    ;; invalid UTF-8 -> U+FFFD (maximal subpart): a lone lead byte, a stray continuation, a truncated 4-byte sequence
    eq_s(rt_bytes::hex_decode("ff"), "\u{FFFD}")
    eq_s(rt_bytes::hex_decode("80"), "\u{FFFD}")
    eq_s(rt_bytes::hex_decode("f09f98"), "\u{FFFD}")
    eq_s(rt_bytes::hex_decode("e282ac"), "€")
    eq_s(rt_bytes::hex_xor("ff00", "0f"), "f00f")
    eq_s(rt_bytes::hex_xor("4142", "20"), "6162")
    eq_s(rt_bytes::hex_xor("ff", ""), "")
    eq_s(rt_bytes::hex_xor("0102030405", "ff00"), "fe02fc04fa")
end

