;; ── sort_by (rt_sort): stable, cmp(a, b) > 0 puts a after b ──
fn cmp_asc(a: int, b: int) -> int is
    if a > b is return 1 end
    if a < b is return -1 end
    return 0
end
fn cmp_mod3(a: int, b: int) -> int is return (a % 3) - (b % 3) end

fn join_ints(a: [int]) -> string is
    let mut s: string = ""
    let mut i: int = 0
    while i < a.len() is
        if i > 0 is s = s + "," end
        s = s + to_string(a[i])
        i += 1
    end
    return s
end

#[test]
fn sort_by_is_stable_and_in_place() is
    let a: [int] = [5, 3, 9, 1, 3, 7, 0, -4]
    let r: [int] = rt_sort::sort_by(a, cmp_asc)
    eq_s(join_ints(r), "-4,0,1,3,3,5,7,9")
    eq_s(join_ints(a), "-4,0,1,3,3,5,7,9")
    ;; stability: equal keys (x % 3) keep their input order
    eq_s(join_ints(rt_sort::sort_by([3, 4, 6, 1, 9, 7, 2, 5], cmp_mod3)), "3,6,9,4,1,7,2,5")
    ;; a closure with a captured value, descending
    let sign: int = -1
    let down = |x: int, y: int| -> int is sign * cmp_asc(x, y) end
    eq_s(join_ints(rt_sort::sort_by([2, 8, 1, 9, 4], down)), "9,8,4,2,1")
    eq_s(join_ints(rt_sort::sort_by([], cmp_asc)), "")
    eq_s(join_ints(rt_sort::sort_by([7], cmp_asc)), "7")
end

;; ── function pointers through the compiler builtins fn_addr / call_ptr: closures and spawned tasks ──
fn f_add3(a: int, b: int, c: int) -> int is return a * 100 + b * 10 + c end
fn f_add4(a: int, b: int, c: int, d: int) -> int is return a * 1000 + b * 100 + c * 10 + d end
fn f_dbl(x: int) -> int is return x * 2 end

#[test]
fn closure_call_appends_captures() is
    ;; fn(x) with 0 captures, fn(x, c0) with 1, fn(x, c0, c1) with 2, more than 2 is ignored
    let c0: int = rt_mem::closure_create(fn_addr(f_dbl), 0, 0, 0, 0, 0, 0, 0, 0, 0)
    eq_i(rt_mem::closure_call1(c0, 21), 42)
    let c1: int = rt_mem::closure_create(fn_addr(f_add3), 1, 5, 0, 0, 0, 0, 0, 0, 0)
    eq_i(rt_mem::closure_call2(c1, 1, 2), 125)
    let c2: int = rt_mem::closure_create(fn_addr(f_add4), 2, 3, 4, 0, 0, 0, 0, 0, 0)
    eq_i(rt_mem::closure_call2(c2, 1, 2), 1234)
    let c3: int = rt_mem::closure_create(fn_addr(f_add3), 1, 9, 0, 0, 0, 0, 0, 0, 0)
    eq_i(rt_mem::closure_call1(c3, 7), 790)
    let c4: int = rt_mem::closure_create(fn_addr(f_dbl), 5, 1, 2, 3, 4, 5, 0, 0, 0)
    eq_i(rt_mem::closure_call1(c4, 8), 16)
    eq_i(rt_mem::closure_call1(0, 8), 0)
    eq_i(rt_mem::closure_call2(0, 8, 9), 0)
end

#[test]
fn task_spawn_runs_h_functions_on_threads() is
    let t: int = rt_task::task_spawn(fn_addr(f_dbl), 21)
    eq_i(rt_task::task_wait(t), 42)
    let hs: int = rt_ptr::buf_new(40)
    let mut i: int = 0
    while i < 5 is
        rt_ptr::ptr_write_i64(hs, i * 8, rt_task::task_spawn(fn_addr(f_dbl), i + 1))
        i += 1
    end
    let r: int = rt_task::task_join_all(hs, 5)
    eq_i(rt_ptr::ptr_read_i64(r, 0), 2)
    eq_i(rt_ptr::ptr_read_i64(r, 16), 6)
    eq_i(rt_ptr::ptr_read_i64(r, 32), 10)
    let s: int = rt_task::task_spawn_shell("printf spawned")
    eq_s(strdup(rt_task::task_wait(s)), "spawned")
    let q: int = rt_task::task_spawn_shell("sleep 1; printf slow")
    eq_i(rt_task::task_wait_timeout(q, 20), 0)
    eq_s(strdup(rt_task::task_wait(q)), "slow")
end
