#[test]
fn processes_and_regex() is
    eq_s(rt_proc::exec2("echo", "hi"), "hi\n")
    eq_s(rt_proc::exec1("nonexistent-cmd-xyz"), "")
    eq_s(rt_proc::shell("echo x"), "x\n")
    eq_b(rt_proc::process_which("sh").len() > 0, true)
    eq_s(rt_proc::process_which("nonexistent-xyz"), "")
    eq_b(rt_proc::regex_match("\\d+", "abc123"), true)
    eq_b(rt_proc::regex_match("^\\d+$", "abc"), false)
    eq_s(rt_proc::regex_find("\\d+", "abc 123 def 45"), "123")
    eq_i(rt_proc::regex_find_all("\\d+", "a1b22c333").len(), 3)
    eq_s(rt_proc::regex_replace("[0-9]+", "N", "a1b22"), "aNbN")
    ;; sed -E has no \d: the pattern matches nothing and the text comes back as it was (the C does the same)
