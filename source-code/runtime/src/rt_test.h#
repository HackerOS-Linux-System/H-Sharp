#[test]
fn arrays_maps_arenas() is
    let mut a: int = rt_mem::array_new()
    let mut i: int = 0
    while i < 10 is
        a = rt_mem::array_push(a, i * i)
        i += 1
    end
    eq_i(rt_mem::array_len(a), 10)
    eq_i(rt_mem::array_get(a, 9), 81)
    eq_i(rt_mem::array_remove(a, 0), 1)
    eq_i(rt_mem::array_get(a, 0), 1)
    eq_i(rt_mem::array_len(rt_mem::array_slice(a, 2, 5)), 3)
    let m: int = rt_mem::map_new(1)
    rt_mem::map_set(m, rt_mem::c_string("k"), 7)
    eq_i(rt_mem::map_get(m, rt_mem::c_string("k")), 7)
    eq_i(rt_mem::map_has(m, rt_mem::c_string("zz")), 0)
    let n: int = rt_mem::map_new(0)
    let mut j: int = 0
    while j < 40 is
        rt_mem::map_set(n, j, j * 2)
        j += 1
    end
    eq_i(rt_mem::map_len(n), 40)
    eq_i(rt_mem::map_get(n, 39), 78)
    eq_i(rt_mem::map_remove(n, 5), 1)
    eq_i(rt_mem::map_len(n), 39)
    let ar: int = rt_mem::arena_new(256)
    rt_mem::arena_push_current(ar)
    let before: int = rt_mem::arena_used()
    rt_mem::alloc_ex(10)
    eq_i(rt_mem::arena_used() - before, 16)
    rt_mem::arena_pop_current()
    rt_mem::arena_free(ar)
    let blk: int = rt_ptr::rc_alloc(8)
    rt_mem::rc_retain(blk)
    eq_i(rt_mem::rc_count(blk), 2)
    rt_mem::rc_release(blk)
    eq_i(rt_mem::rc_count(blk), 1)
end

