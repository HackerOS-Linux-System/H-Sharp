#[test]
fn raw_pointers() is
    let p: int = rt_ptr::buf_new(32)
    rt_ptr::ptr_write_i32(p, 0, -2)
    eq_i(rt_ptr::ptr_read_i32(p, 0), -2)
    eq_i(rt_ptr::ptr_read_i8(p, 0), -2)
    eq_i(rt_ptr::ptr_read_i16(p, 2), -1)
    rt_ptr::ptr_write_i64(p, 8, 81985529216486895)
    eq_i(rt_ptr::ptr_read_i64(p, 8), 81985529216486895)
    eq_i(rt_ptr::ptr_read_i8(p, 8), -17)
    rt_ptr::ptr_fill(p, 7, 4)
    eq_i(rt_ptr::ptr_read_i32(p, 0), 117901063)
    rt_ptr::ptr_zero(p, 4)
    eq_i(rt_ptr::ptr_read_i32(p, 0), 0)
    rt_ptr::ptr_copy(p + 16, p + 8, 8)
    eq_i(rt_ptr::ptr_compare(p + 16, p + 8, 8), 0)
    rt_ptr::ptr_write_i8(p + 16, 0, 1)
    eq_b(rt_ptr::ptr_compare(p + 16, p + 8, 8) != 0, true)
    eq_i(rt_ptr::ptr_read_i64(0, 0), 0)
    eq_b(rt_ptr::ptr_is_null(0), true)
    eq_i(rt_ptr::ptr_add(0, 9), 0)
    eq_i(rt_ptr::ptr_add(p, 9) - p, 9)
    rt_ptr::buf_free(p)
end

#[test]
fn files_and_env() is
    let d: string = "/tmp/hs_rt_test_" + to_string(rt_sys::pid())
    eq_b(rt_os::mkdir_all(d + "/a/b"), true)
    eq_b(rt_os::is_dir(d + "/a/b"), true)
    eq_b(rt_os::is_file(d + "/a/b"), false)
    eq_b(rt_os::write_file(d + "/a/b/f.txt", "hello"), true)
    eq_s(rt_os::read_file(d + "/a/b/f.txt"), "hello")
    eq_i(rt_os::file_size(d + "/a/b/f.txt"), 5)
    eq_b(rt_os::append_file(d + "/a/b/f.txt", " world"), true)
    eq_s(rt_os::read_file(d + "/a/b/f.txt"), "hello world")
    eq_b(rt_os::rename_file(d + "/a/b/f.txt", d + "/a/b/g.txt"), true)
    eq_b(rt_os::file_exists(d + "/a/b/f.txt"), false)
    eq_b(rt_os::is_file(d + "/a/b/g.txt"), true)
    eq_i(rt_os::file_size(d + "/nope"), -1)
    eq_s(rt_os::read_file(d + "/nope"), "")
    eq_b(rt_os::fs_rmdir(d + "/a/b"), false)
    eq_b(rt_os::file_delete(d + "/a/b/g.txt"), true)
    eq_b(rt_os::fs_rmdir(d + "/a/b"), true)
    eq_b(rt_os::fs_rmdir(d + "/a"), true)
    eq_b(rt_os::fs_rmdir(d), true)
    eq_b(rt_os::setenv_s("HSH_RT_TEST_VAR", "abc"), true)
    eq_s(rt_os::getenv_s("HSH_RT_TEST_VAR"), "abc")
    eq_s(rt_os::env_get("HSH_RT_TEST_VAR"), "abc")
    eq_b(rt_os::env_remove("HSH_RT_TEST_VAR"), true)
    eq_s(rt_os::getenv_s("HSH_RT_TEST_VAR"), "")
    eq_s(rt_os::platform(), "linux")
end

