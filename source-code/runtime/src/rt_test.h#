;; ── Argon2id / BLAKE2b (rt_argon2): known answers from Python hashlib.blake2b and argon2-cffi (hash_secret_raw, Type.ID, v=19) ──
fn hex_of_bytes(b: [int]) -> string is return rt_bytes::hex_encode_bytes(b) end

fn bytes_of(s: string) -> [int] is
    let mut o: [int] = []
    let mut i: int = 0
    while i < s.len() is
        o.push(byte_at(s, i))
        i += 1
    end
    return o
end

