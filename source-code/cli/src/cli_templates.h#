pub fn template_app() -> string is
    return ";; H# Application\nfn main() is\n    let name: string = \"World\"\n    write(\"Hello, \" + name + \"!\")\n\n    let x: int = 42\n    let y: int = 8\n    write(\"Sum: \" + to_string(x + y))\n\n    for i in 1..=5 is\n        write(to_string(i) + \": \" + repeat(\"*\", i))\n    end\nend\n\nfn repeat(s: string, n: int) -> string is\n    let mut result: string = \"\"\n    let mut i: int = 0\n    while i < n is\n        result = result + s\n        i += 1\n    end\n    return result\nend\n"
end

