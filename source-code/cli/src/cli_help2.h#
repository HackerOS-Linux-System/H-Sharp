pub fn help_compile() -> string is
    return "Compile a H# source file to a native binary\n\nExamples: h# compile src/main.h# h# compile src/main.h# -o build/myapp --release h# compile src/main.h# --target linux-aarch64 --emit-ir\n\nUsage: h# compile [OPTIONS] <FILE>\n\nArguments:\n  <FILE>\n          Source file to compile (e.g. src/main.h#)\n\nOptions:\n      --edition <YEAR>\n          H# edition assumed for files without `using \"<year>\"` (default: the project's `Bit.hk` `[edition]` when `lang => h#`, else the newest edition). Also settable via HSHARP_EDITION. A file's own `using` always wins for that file. Run `h# editions` to list them\n\n  -o, --output <OUTPUT>\n          Output binary path (default: build/<stem>)\n\n  -t, --target <TARGET>\n          Cross-compilation target (linux-x86_64, windows-x86_64, macos-aarch64, …)\n\n      --release\n          Optimise (g++ -O2, gc-sections, strip)\n\n      --no-opt\n          Disable optimisations (-O0)\n\n      --debug\n          Keep DWARF debug info in the binary\n\n      --dynamic\n          Dynamically link output (default: static)\n\n      --emit-cpp\n          Emit the generated C++ source tree (<out>.cpp + runtime) instead of a binary (same as `--emit cpp`; `--emit-ir` is kept as an alias)\n\n      --save-cpp\n          Also save the translated C++ sources (+ runtime) next to the binary (in `build/`); they are otherwise kept only in `/tmp/.h#-cache/`\n\n      --strict-memory\n          Treat every memory-safety warning (static audit + runtime guards) as a hard error\n\n      --emit <KIND>\n          Emit kind: bin (default), obj (.o), so (.so/.dylib/.dll), lib (.a) Example: h# compile src/main.h# --emit so\n\n  -v, --verbose\n          Print every compilation step\n\n      --mem-mode <MODE>\n          Project-wide default MemoryMode fallback (weaker than a function's own @mode and weaker than its file's `@: mode` directive — see CompileOptions::default_mem_mode). Mainly set by the `bit` package manager from the `mem-mode` key of `[build]` in `Bit.hk`, not typed by hand. Valid: default, safety, arc, arena, pointers\n\n  -h, --help\n          Print help (see a summary with '-h')\n"
end

pub fn help_run() -> string is
    return "Compile a file to a temporary binary and run it (there is no interpreter any more)\n\nUsage: h# run [OPTIONS] <FILE> [ARGS]...\n\nArguments:\n  <FILE>     \n  [ARGS]...  Arguments passed to the program\n\nOptions:\n      --edition <YEAR>  H# edition assumed for files without `using \"<year>\"` (default: the project's `Bit.hk` `[edition]` when `lang => h#`, else the newest edition). Also settable via HSHARP_EDITION. A file's own `using` always wins for that file. Run `h# editions` to list them\n  -q, --quiet           Suppress the build banner / progress / summary (diagnostics still go to stderr)\n  -h, --help            Print help\n"
end

