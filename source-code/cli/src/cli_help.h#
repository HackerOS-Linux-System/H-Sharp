pub fn help_main() -> string is
    return "h# — HackerOS-first compiled language\n\nUsage: h# [OPTIONS] <COMMAND>\n\nCommands:\n  compile     Compile a H# source file to a native binary\n  run         Compile a file to a temporary binary and run it (there is no interpreter any more)\n  test        Compile and run every `#[test]` function of a file\n  check       Check syntax and types only (no binary emitted)\n  new         Create a new H# project from a template\n  targets     List available cross-compilation targets\n  fmt         Reformat H# source file(s) (indentation only — see fmt.rs)\n  lsp         Run the H# language server over stdio (for editor integration)\n  docs        Open the H# documentation in your browser\n  editions    List the H# editions this toolchain supports and show which one is the default for files without `using \"<year>\"` (and why)\n  ffi-header  Generate a companion C or Rust header for a file's `extern` blocks — including a real `typedef struct {{ int64_t ...; }}` / `#[repr(C)] struct {{ ... i64 }}` for every H# struct type an extern function references by pointer (`&`/`&mut`), matching H#'s actual field layout (see `compiler::ffi::struct_c_def`'s doc comment). This is the concrete tool the `StructByValueFfi` compile-error's hint points to: it's how you find out what layout your struct actually has on the H# side before hand-writing (or generating) the matching C/Rust definition\n  lib         Build, inspect, verify and sign `.hlib` (HackerOS Lib) archives — H#'s native library format, natively readable by Hacker Lang and HackerScript too. See /HLIB_FORMAT.md at the repo root\n  help        Print this message or the help of the given subcommand(s)\n\nOptions:\n      --edition <YEAR>  H# edition assumed for files without `using \"<year>\"` (default: the project's `Bit.hk` `[edition]` when `lang => h#`, else the newest edition). Also settable via HSHARP_EDITION. A file's own `using` always wins for that file. Run `h# editions` to list them\n  -h, --help            Print help\n  -V, --version         Print version"
end

pub fn help_lib() -> string is
    return "Build, inspect, verify and sign `.hlib` (HackerOS Lib) archives — H#'s native library format, natively readable by Hacker Lang and HackerScript too. See /HLIB_FORMAT.md at the repo root\n\nUsage: h# lib [OPTIONS] <COMMAND>\n\nCommands:\n  build    Compile a H# source file to a shared object and package it, its interface header, and (for any generic/macro export) its AST, into a single `.hlib` archive\n  inspect  Print a `.hlib` archive's manifest and entry listing without verifying checksums or signature (fast — just parses `manifest.json`)\n  verify   Verify a `.hlib` archive's internal SHA-256 checksums, and optionally its Ed25519 signature against a known public key\n  keygen   Generate a fresh Ed25519 keypair for signing `.hlib` archives. Prints the public key; writes the secret key to `--out` (hex, 0600)\n  bind     Extract a `.hlib`'s native artifacts to `--into`, and generate a ready-to-`mod`-include `.h#` stub declaring an `extern` block for every non-generic export in its header — so consuming a `.hlib` from H# is just `mod <name>_hlib_bind;` once this has run\n  help     Print this message or the help of the given subcommand(s)\n\nOptions:\n      --edition <YEAR>  H# edition assumed for files without `using \"<year>\"` (default: the project's `Bit.hk` `[edition]` when `lang => h#`, else the newest edition). Also settable via HSHARP_EDITION. A file's own `using` always wins for that file. Run `h# editions` to list them\n  -h, --help            Print help"
end
