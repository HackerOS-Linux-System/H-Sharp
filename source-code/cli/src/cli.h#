;; clap's short error for an unknown subcommand (`path` = "h#" or "h# lib")
fn unknown_subcommand(name: string, path: string, opts: string) -> string is
    return "error: unrecognized subcommand '" + name + "'\n\nUsage: " + path + " " + opts + "<COMMAND>\n\nFor more information, try '--help'.\n"
end

;; value of `--long X` / `--long=X` / `-s X` at args[i]; returns "" when args[i] is not that option
fn opt_value(args: [string], i: int, long_name: string, short_name: string) -> string is
    let a: string = args[i]
    if a == long_name || (short_name != "" && a == short_name) is
        if i + 1 < args.len() is return args[i + 1] end
        die("a value is required for '" + a + "' but none was supplied")
    end
    if starts_with(a, long_name + "=") is return a[long_name.len() + 1..a.len()] end
    return ""
end

fn is_opt(a: string, long_name: string, short_name: string) -> bool is
    return a == long_name || (short_name != "" && a == short_name) || starts_with(a, long_name + "=")
end

fn banner(info: EditionInfo) is
