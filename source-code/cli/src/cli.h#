    out_line("")
end

;; ── lib build (hlib_cmd.rs::cmd_build) — native ──────────────────────────────
fn cmd_lib_build(rest: [string], year: int) -> int is
    let mut file: string = ""
    let mut output: string = ""
    let mut lib_version: string = "0.1.0"
    let mut target_s: string = ""
    let mut sign: string = ""
    let mut release: bool = false
    let mut i: int = 0
    while i < rest.len() is
        let a: string = rest[i]
        if is_opt(a, "--output", "-o") is
            output = opt_value(rest, i, "--output", "-o")
            if a == "--output" || a == "-o" is i += 1 end
        elsif is_opt(a, "--lib-version", "") is
            lib_version = opt_value(rest, i, "--lib-version", "")
            if a == "--lib-version" is i += 1 end
        elsif is_opt(a, "--target", "-t") is
            target_s = opt_value(rest, i, "--target", "-t")
            if a == "--target" || a == "-t" is i += 1 end
        elsif is_opt(a, "--sign", "") is
            sign = opt_value(rest, i, "--sign", "")
            if a == "--sign" is i += 1 end
        elsif a == "--release" is release = true
        elsif starts_with(a, "-") is return unexpected(a, "Usage: h# lib build [OPTIONS] <FILE>")
        else file = a end
        i += 1
    end
    if file == "" is
        eprint("error: the following required arguments were not provided:\n  <FILE>\n\nUsage: h# lib build [OPTIONS] <FILE>\n\nFor more information, try '--help'.\n")
        return 2
    end
    let stem: string = file_stem(file)
    let mut out_hlib: string = output
    if out_hlib == "" is out_hlib = "build/" + stem + ".hlib" end
    let mut out_parent: string = parent_dir(out_hlib)
    if out_parent == "" is out_parent = "." end
    mkdir_p(out_parent)
    let mut triple: target::TargetTriple = target::host()
    if target_s != "" is
        let tl: target::TargetLookup = target::from_str(target_s)
        if !tl.found is return die_ret("unknown target `" + target_s + "`. Run `h# targets` to list them.") end
        triple = tl.target
    end
    if !fs::exists(file) is return die_ret("cannot read `" + file + "`: No such file or directory (os error 2)") end
    let source: string = fs::read(file)
    let rec: edition::EditionRecorder = edition::new_recorder()
    let st: edition::EditionState = edition::new_state()
    edition::start_recording(rec)
    let r: parser::ParseResult = parser::parse_with_default(source, file, year, rec, st)
    if parser::has_errors(r) is
        eprint(parser::render_errors(r) + "\n")
        return die_ret("parsing failed.")
    end
    let res: modules::Resolver = modules::new_resolver(file, [], rec, st)
    let e: modules::Expanded = modules::expand_program(res, r.module, modules::dir_of(file))
    if !e.ok is return die_ret(e.err) end
    let recs: [edition::EditionRecord] = edition::take_records(rec)
    let mut lib_edition: string = to_string(year)
    if recs.len() > 0 is lib_edition = to_string(recs[0].year) end
    if lib_edition == "0" is lib_edition = latest_edition() end
    let note: string = edition::describe_mix(recs)
    if note != "" is eprint(yellow(trim_s(note)) + "\n") end
    let module: ast::Node = ast::nd("Module", r.module.text, [r.module.kids[0], r.module.kids[1], r.module.kids[2], ast::nd("Items", "", e.items)])

    let tmp_stem: string = out_parent + "/.hlib-" + stem
    let opts: options::CompileOptions = options::CompileOptions { target: triple, optimize: release, static_link: true, debug_info: false,
        output: tmp_stem, output_kind: "SharedLib", default_mem_mode: "", strict_memory: false, save_cpp: false, test_mode: false, verbose: false }
    out_line("  " + green_b("Compiling:") + " " + file + " (target: " + triple.llvm_triple + ")")
    let cr: pipeline::CompileResult = pipeline::compile(module, source, file, opts)
    if !cr.ok is
        if cr.diag is return die_ret("compilation failed (type errors above).") end
        return die_ret(cr.err)
    end
    let so_path: string = tmp_stem + options::file_suffix("SharedLib", triple)
    let mut so_bytes: hlib::Buf = hlib::buf_new(0)
    match hlib::read_file(so_path) is
        option::Result::Ok(b) => is so_bytes = b end
        option::Result::Err(er) => is return die_ret("compiled .so vanished at `" + so_path + "`: " + er) end
    end

    let summary: hlib_export::ExportSummary = hlib_export::summarize_exports(e.items)
    let header_json: string = hlib::exports_json(summary.symbols)
    let ast_json: string = hlib_export::ast_encode(summary.pub_items)
    let mut generic_count: int = 0
    for sy in summary.symbols is
        if sy.generic is generic_count += 1 end
    end
    out_line("  " + green_b("Exports:") + " " + to_string(summary.symbols.len()) + " export(s) (" + to_string(generic_count) + " generic — carried via AST only)")

    let b: hlib::HlibBuilder = hlib::builder_new(stem, lib_version, "hsharp")
    b.language_version = version()
    b.edition = lib_edition
    match hlib::add_shared_object(b, triple.llvm_triple, so_bytes) is
        option::Result::Ok(_) => is end
        option::Result::Err(er) => is return die_ret(er) end
    end
    match hlib::add_header(b, hlib::buf_from_str(header_json)) is
        option::Result::Ok(_) => is end
        option::Result::Err(er) => is return die_ret(er) end
    end
    if summary.pub_items.len() > 0 is
        match hlib::add_ast(b, hlib::buf_from_str(ast_json)) is
            option::Result::Ok(_) => is end
            option::Result::Err(er) => is return die_ret(er) end
        end
    end
    b.exports = summary.symbols
    let mut key_hex: string = ""
    if sign != "" is
        if !fs::exists(sign) is return die_ret("cannot read signing key `" + sign + "`: No such file or directory (os error 2)") end
        key_hex = trim_s(fs::read(sign))
    end
    let mut mf: hlib::Manifest = hlib::empty_manifest()
    match hlib::builder_finish(b, out_hlib, key_hex) is
        option::Result::Ok(m) => is mf = m end
        option::Result::Err(er) => is return die_ret(er) end
    end
    fs::remove(so_path)
    let mut sg: string = ", unsigned"
    if mf.signed is sg = ", signed" end
    out_line(green_b("✓") + " " + file + " → " + bold(out_hlib) + " (" + to_string(mf.artifacts.len()) + " artifact(s)" + sg + ")")
    return 0
end

fn die_ret(msg: string) -> int is
    if print_located(msg, "CODEGEN ERROR") is return 1 end
    eprint(red_b("Error:") + " " + msg + "\n")
    return 1
end

fn run_lib(args: [string], edition_flag: string, info: EditionInfo) -> int is
    if args.len() == 0 || args[0] == "-h" || args[0] == "--help" || args[0] == "help" is
        out_line(lib_usage())
        return if args.len() == 0 is 2 else 0 end
    end
    let sub: string = args[0]
    let mut rest: [string] = []
    let mut i: int = 1
    while i < args.len() is
        rest.push(args[i])
        i += 1
    end
    if sub == "build" is
        let mut y: int = 0
        if info.edition != "" is y = str_to_int_cli(info.edition) end
        return cmd_lib_build(rest, y)
    end
    if sub == "inspect" is
        banner(info)
        if rest.len() != 1 is die("usage: h# lib inspect <file.hlib>") end
        cmd_inspect(rest[0])
        return 0
    end
    if sub == "verify" is
        banner(info)
        let mut file: string = ""
        let mut pubkey: string = ""
        let mut j: int = 0
        while j < rest.len() is
            if is_opt(rest[j], "--pubkey", "") is
                pubkey = opt_value(rest, j, "--pubkey", "")
                if rest[j] == "--pubkey" is j += 1 end
            else
                file = rest[j]
            end
            j += 1
        end
        if file == "" is die("usage: h# lib verify <file.hlib> [--pubkey HEX]") end
        cmd_verify(file, pubkey)
        return 0
    end
    if sub == "keygen" is
        banner(info)
        let mut out: string = "hlib_signing.key"
        let mut j: int = 0
        while j < rest.len() is
            if is_opt(rest[j], "--out", "-o") is
                out = opt_value(rest, j, "--out", "-o")
                if rest[j] == "--out" || rest[j] == "-o" is j += 1 end
            end
            j += 1
        end
        cmd_keygen(out)
        return 0
    end
    if sub == "bind" is
        banner(info)
        let mut file: string = ""
        let mut into: string = "hlibs"
        let mut j: int = 0
        while j < rest.len() is
            if is_opt(rest[j], "--into", "-i") is
                into = opt_value(rest, j, "--into", "-i")
                if rest[j] == "--into" || rest[j] == "-i" is j += 1 end
            else
                file = rest[j]
            end
            j += 1
        end
        if file == "" is die("usage: h# lib bind <file.hlib> [--into DIR]") end
        cmd_bind(file, into)
        return 0
    end
    eprint(unknown_subcommand(sub, "h# lib", "[OPTIONS] "))
    return 2
end


;; ── check · targets · ffi-header (native: check.rs, ffi_header.rs, the `targets` arm of main.rs) ──
fn usage_error(msg: string, usage_line: string) -> int is
    eprint("error: " + msg + "\n\n" + usage_line + "\n\nFor more information, try '--help'.\n")
    return 2
end

fn unexpected(a: string, usage_line: string) -> int is
    if starts_with(a, "-") && usage_line != "Usage: h# targets [OPTIONS]" is
        eprint("error: unexpected argument '" + a + "' found\n\n  tip: to pass '" + a + "' as a value, use '-- " + a + "'\n\n" + usage_line + "\n\nFor more information, try '--help'.\n")
    else
        eprint("error: unexpected argument '" + a + "' found\n\n" + usage_line + "\n\nFor more information, try '--help'.\n")
    end
    return 2
end

fn has_help(rest: [string]) -> bool is
    for r in rest is
        if r == "-h" || r == "--help" is return true end
    end
    return false
end

fn cmd_targets(rest: [string], info: EditionInfo) -> int is
    if has_help(rest) is
        print(cli_style::help(cli_help2::help_targets()))
        return 0
    end
    if rest.len() > 0 is return unexpected(rest[0], "Usage: h# targets [OPTIONS]") end
    banner(info)
    out_line(bold("Available cross-compilation targets:") + "\n")
    let names: [string] = target::all_named()
    let mut i: int = 0
    while i + 1 < names.len() is
        let mut pad: string = names[i]
        while pad.len() < 25 is pad = pad + " " end
        out_line("  " + cyan(pad) + "  " + names[i + 1])
        i += 2
    end
    out_line("\n" + dim("Usage: h# compile --target linux-aarch64 src/main.h#"))
    return 0
end

fn cmd_ffi_header_native(rest: [string], info: EditionInfo) -> int is
    let usage_line: string = "Usage: h# ffi-header [OPTIONS] <FILE>"
    if has_help(rest) is
        print(cli_style::help(cli_help2::help_ffi_header()))
        return 0
    end
    let mut file: string = ""
    let mut lang: string = "c"
    let mut i: int = 0
    while i < rest.len() is
        let a: string = rest[i]
        if is_opt(a, "--lang", "-l") is
            if a == "--lang" || a == "-l" is
                if i + 1 >= rest.len() is
                    eprint("error: a value is required for '--lang <LANG>' but none was supplied\n\nFor more information, try '--help'.\n")
                    return 2
                end
                lang = rest[i + 1]
                i += 1
            else
                lang = opt_value(rest, i, "--lang", "-l")
            end
        elsif starts_with(a, "-") && a != "-" is
            return unexpected(a, usage_line)
        elsif file == "" is
            file = a
        else
            return unexpected(a, usage_line)
        end
        i += 1
    end
    if file == "" is
        eprint("error: the following required arguments were not provided:\n  <FILE>\n\nUsage: h# ffi-header <FILE>\n\nFor more information, try '--help'.\n")
        return 2
    end
    banner(info)
    if !fs::exists(file) is
        eprint(red_b("Error:") + " " + file + ": No such file or directory (os error 2)\n")
        return 1
    end
    let src: string = fs::read(file)
    let r: parser::ParseResult = parser::parse(src, file)
    if parser::has_errors(r) is
        eprint(parser::render_errors(r))
        return 1
    end
    let structs: ffi::StructTable = ffi::new_struct_table()
    let mut blocks: [ast::Node] = []
    for it in r.module.kids[3].kids is
        if it.tag == "Struct" is ffi::add_struct(structs, it.text, it.kids[1]) end
        if it.tag == "Extern" is blocks.push(it) end
    end
    if blocks.len() == 0 is
        out_line(yellow_b("Note:") + " no `extern` blocks found in " + file)
        return 0
    end
    let l: string = lower(lang)
    let is_rust: bool = l == "rust" || l == "rs"
    let mut wrote: bool = false
    for b in blocks is
        if b.kids[0].text == "Python" is continue end
        wrote = true
        if is_rust is
            out_line(ffi::rust_extern_block_with_structs(b.kids[3].kids, structs))
        else
            out_line(ffi::c_header_block_with_structs(b.kids[3].kids, structs))
        end
        out_line("")
    end
    if !wrote is out_line(yellow_b("Note:") + " every `extern` block in " + file + " is `[python]` — no C/Rust header to generate") end
    return 0
end

fn ext_of(p: string) -> string is
    let mut i: int = p.len() - 1
    while i >= 0 is
        let c: int = byte_at(p, i)
        if c == 46 is return p[i + 1..p.len()] end
        if c == 47 is return "" end
        i -= 1
    end
    return ""
end

fn depth_of(p: string) -> int is
    let mut d: int = 0
    let mut i: int = 0
    while i < p.len() is
        if byte_at(p, i) == 47 is d += 1 end
        i += 1
    end
    return d
end

fn find_sources() -> [string] is
    let mut out: [string] = []
    for p in fs::walk(".") is
        let e: string = ext_of(p)
        let full: string = if starts_with(p, "./") is p else "./" + p end
        if (e == "h#" || e == "hsp" || e == "h-sharp") && !starts_with(full, "./build") && depth_of(full) <= 5 is out.push(full) end
    end
    return out
end

;; one file; returns the number of errors it contributed. `single` selects the single-file output style.
fn check_one(path: string, single: bool, year: int) -> int is
    if !fs::exists(path) is
        eprint(red_b("Error:") + " " + path + ": No such file or directory (os error 2)\n")
        return 1
    end
    let src: string = fs::read(path)
    let rec: edition::EditionRecorder = edition::new_recorder()
    let st: edition::EditionState = edition::new_state()
    let r: parser::ParseResult = parser::parse_with_default(src, path, year, rec, st)
    if parser::has_errors(r) is
        eprint(parser::render_errors(r))
        return r.errors.len()
    end
    let res: modules::Resolver = modules::new_resolver(path, [], rec, st)
    let e: modules::Expanded = modules::expand_program(res, r.module, modules::dir_of(path))
    if !e.ok is
        eprint(red_b("Error:") + " " + path + ": " + e.err + "\n")
        return 1
    end
    let m: ast::Node = ast::nd("Module", r.module.text, [r.module.kids[0], r.module.kids[1], r.module.kids[2], ast::nd("Items", "", e.items)])
    let tc: checker::TypeChecker = checker::new_checker(path)
    let mut diags: [diagnostics::Diag] = checker::check_module(tc, m)
    for fd in features::check_module_features(m, "Cpp") is
        let d: diagnostics::Diag = diagnostics::Diag { sev: "E", sp: fd.sp, file: path, msg: fd.message, hints: fd.hints }
        diags.push(d)
    end
    let n: int = diagnostics::count_errors(diags)
    if n == 0 is
        if single is out_line("  " + green("✓") + " " + path) else out_line("  " + green_b("✓") + " " + dim(path)) end
    else
        diagnostics::print_diagnostics(diags, src, path)
        if single is out_line("  " + red("✗") + " " + path + "  (" + to_string(n) + " error(s))") end
    end
    return n
end

fn cmd_check(rest: [string], info: EditionInfo) -> int is
    if has_help(rest) is
        print(cli_style::help(cli_help2::help_check()))
        return 0
    end
    let mut files: [string] = []
    for a in rest is
        if starts_with(a, "-") && a != "-" is return unexpected(a, "Usage: h# check [OPTIONS] [FILES]...") end
        files.push(a)
    end
    let single: bool = files.len() <= 1
    if files.len() == 0 is
        files = find_sources()
        if files.len() == 0 is
            eprint(red_b("Error:") + " no .h# files found\n")
            return 1
        end
    end
    let mut year: int = 0
    if info.edition != "" is year = str_to_int_cli(info.edition) end
    out_line(cyan_b("Checking:") + " " + to_string(files.len()) + " file(s)\n")
    let mut total: int = 0
    for f in files is total += check_one(f, single, year) end
    out_line("")
    if total == 0 is
        if single is out_line(green_b("✓") + " No errors found.") else out_line(green_b("✓ No errors found.")) end
        return 0
    end
    if single is
        out_line(red_b("✗") + " Found " + to_string(total) + " error(s).")
    else
        eprint(red_b("✗") + " Found " + red(to_string(total) + " error(s)") + ".\n")
    end
    return 1
end

fn str_to_int_cli(s: string) -> int is
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() is
        v = v * 10 + (byte_at(s, i) - 48)
        i += 1
    end
    return v
end

;; `argv` = the program arguments after the executable name
;; ── compile / run / test (compile.rs, run_cmd.rs) — native, no stage0 ─────────
