;; ── fmt (fmt.rs `run`) ────────────────────────────────────────────────────────
fn collect_sources() -> [string] is
    let mut out: [string] = []
    for p in fs::walk(".") is
        if (ends_with(p, ".h#") || ends_with(p, ".hsp") || ends_with(p, ".h-sharp")) && !starts_with(p, "./build") is out.push(p) end
    end
    return out
end

fn cmd_fmt(files: [string], check: bool) -> int is
    let mut targets: [string] = files
    if targets.len() == 0 is targets = collect_sources() end
    if targets.len() == 0 is
        die("no .h# files found")
    end
    let mut changed: int = 0
    let mut unchanged: int = 0
    for path in targets is
        if !fs::exists(path) is die("cannot read `" + path + "`: No such file or directory (os error 2)") end
        let src: string = fs::read(path)
        let formatted: string = fmt::format_source(src)
        if formatted == src is
            unchanged += 1
            continue
        end
        if check is
            out_line(yellow_b("would reformat:") + " " + path)
            changed += 1
            continue
        end
        fs::write(path, formatted)
        out_line(green_b("reformatted:") + " " + path)
        changed += 1
    end
    let verb: string = if check is "would reformat" else "reformatted" end
    out_line("\n" + verb + " " + to_string(changed) + " file(s), " + to_string(unchanged) + " already formatted")
    if check && changed > 0 is return 1 end
    return 0
end

;; ── new (new.rs) ──────────────────────────────────────────────────────────────
fn json_str(s: string) -> string is
    return hlib::jstr_pub(s)
end

fn cmd_new(name: string, template: string) is
    out_line(cyan_b("Creating:") + " H# project `" + name + "`")
    if fs::exists(name) is die("directory `" + name + "` already exists") end
    hlib::make_dirs(name + "/src")
    hlib::make_dirs(name + "/build")
    hlib::make_dirs(name + "/tests")
    ;; serde_json::json! keeps keys sorted
    fs::write(name + "/h#.json", "\{\n  \"dependencies\": \{},\n  \"name\": " + json_str(name) + ",\n  \"template\": " + json_str(template) + ",\n  \"version\": \"0.1.0\"\n}")
    fs::write(name + "/.gitignore", "build/\n*.c\n.cache/\ncache/\n.bit/\n")

    let is_lib: bool = template == "lib"
    let mut bit: string = "[package]\n-> name        => " + name + "\n-> version     => 0.1.0\n-> lang        => h#\n\n"
    bit += "! default edition for files without `using \"<year>\"` (only read for lang => h#)\n[edition]\n-> edition => 2026\n\n"
    bit += "[layout]\n-> src => src\n"
    if is_lib is bit += "-> hsharp-lib-entry => src/main.h#\n" end
    bit += "\n[build]\n-> link => static\n"
    if is_lib is bit += "\n[lib]\n-> output => hlib\n" end
    bit += "\n! what a bare `bit` / `bit build` does\n[default-build]\n-> profile => release\n-> emit    => " + (if is_lib is "hlib" else "bin" end) + "\n\n"
    bit += "! libraries: `bit add <name>` installs one and records it here;\n! use it in code with:  use \"bit -> <name>\"\n[dependencies]\n"
    fs::write(name + "/Bit.hk", bit)

    let mut main_src: string = cli_templates::template_app()
    let mut readme: string = cli_templates::readme_app()
    let mut test_src: string = cli_templates::test_app()
    if template == "cybersec" || template == "security" is
        main_src = cli_templates::template_cybersec()
        readme = cli_templates::readme_cybersec()
        test_src = cli_templates::test_cybersec()
    elsif template == "net" || template == "network" is
        main_src = cli_templates::template_network()
        readme = cli_templates::readme_network()
        test_src = cli_templates::test_network()
    elsif template == "lib" is
        main_src = cli_templates::template_lib()
        readme = cli_templates::readme_lib()
        test_src = cli_templates::test_lib()
    elsif template == "web" is
        main_src = cli_templates::template_web()
        readme = cli_templates::readme_web()
        test_src = cli_templates::test_web()
    elsif template == "tui" is
        main_src = cli_templates::template_tui()
        readme = cli_templates::readme_tui()
        test_src = cli_templates::test_tui()
    elsif template == "wasm" is
        main_src = cli_templates::template_wasm()
        readme = cli_templates::readme_wasm()
        test_src = cli_templates::test_wasm()
    end
    ;; every generated source states its edition right after the template's first line
    let nl: int = index_of(main_src, "\n")
    main_src = main_src[0..nl] + "\nusing \"2026\"\n\n" + main_src[nl + 1..main_src.len()]
    fs::write(name + "/src/main.h#", main_src)
    fs::write(name + "/README.md", readme)
    fs::write(name + "/tests/main_test.h#", test_src)

    out_line("\n  " + green_b("Created:") + " " + name + "/")
    out_line("  " + green("Created:") + " " + name + "/src/main.h#")
    out_line("  " + green("Created:") + " " + name + "/tests/main_test.h#")
    out_line("  " + green("Created:") + " " + name + "/README.md")
    out_line("  " + green("Created:") + " " + name + "/h#.json")
    out_line("  " + green("Created:") + " " + name + "/Bit.hk")
    out_line("\n  " + bold("Get started:"))
    out_line("    cd " + name)
    out_line("    h# run src/main.h#        # compile + run")
    out_line("    h# compile src/main.h#    # compile to native binary")
    out_line("    bit                       # build with bit (reads Bit.hk)")
    out_line("    bit check                 # syntax + type check")
    out_line("    bit add <lib>             # add a library, then: use \"bit -> <lib>\"")
end

;; ── lib inspect | verify | keygen | bind (hlib_cmd.rs) ───────────────────────────
fn open_archive(file: string) -> hlib::HlibArchive is
    match hlib::archive_open(file) is
        option::Result::Ok(a) => is return a end
        option::Result::Err(e) => is die(e) end
    end
    return hlib::HlibArchive { manifest: hlib::empty_manifest(), entries: [] }
end

fn kind_debug(k: string) -> string is
    if k == "shared_object" is return "SharedObject" end
    if k == "bytecode" is return "Bytecode" end
    if k == "ast" is return "Ast" end
    if k == "header" is return "Header" end
    return "Extra"
end

fn pad_right(s: string, w: int) -> string is
    let mut out: string = s
    while out.len() < w is out += " " end
    return out
end

fn cmd_inspect(file: string) is
    let a: hlib::HlibArchive = open_archive(file)
    let m: hlib::Manifest = a.manifest
    out_line(bold("hlib:") + " " + m.name + " v" + m.version + " (" + m.language + ")")
    out_line("  spec version:     " + to_string(m.spec_version))
    out_line("  abi version:      " + to_string(m.abi_version))
    out_line("  built by:         " + m.language + " " + m.language_version)
    if m.language == "hsharp" is out_line("  edition:          " + m.edition) end
    out_line("  created at:       " + m.created_at)
    if m.description != "" is out_line("  description:      " + m.description) end
    out_line("  signed:           " + (if m.signed is "yes" else "no" end))
    if m.signed is out_line("    public key:     " + m.sig_public_key) end
    out_line("  artifacts (" + to_string(m.artifacts.len()) + "):")
    for x in m.artifacts is
        out_line("    " + pad_right(kind_debug(x.kind), 10) + " " + pad_right(x.path, 45) + " " + to_string(x.size) + " bytes  sha256:" + x.sha256[0..16])
    end
    out_line("  exports (" + to_string(m.exports.len()) + "):")
    for e in m.exports is
        out_line("    " + e.signature + (if e.generic is "  [generic — AST only]" else "" end))
    end
end

fn cmd_verify(file: string, pubkey: string) is
    let a: hlib::HlibArchive = open_archive(file)
    match hlib::verify_checksums(a) is
        option::Result::Ok(_) => is end
        option::Result::Err(e) => is die("checksum verification failed: " + e) end
    end
    out_line(green_b("✓") + " checksums OK (" + to_string(a.manifest.artifacts.len()) + " entries)")
    if pubkey != "" is
        match hlib::verify_signature(a, pubkey) is
            option::Result::Ok(_) => is end
            option::Result::Err(e) => is die("signature verification failed: " + e) end
        end
        out_line(green_b("✓") + " signature OK (public key " + (if pubkey.len() > 16 is pubkey[0..16] else pubkey end) + "…)")
    else
        out_line(yellow_b("!") + " no --pubkey given — skipped signature verification (archive signed: " + (if a.manifest.signed is "true" else "false" end) + ")")
    end
end

fn cmd_keygen(out: string) is
    let kp: hlib::KeyPair = hlib::generate_keypair()
    fs::write(out, kp.signing_hex)
    chmod(out, 384)                       ;; 0o600
    out_line(green_b("✓") + " secret signing key written to " + out + " (keep it private!)")
    out_line("  public key (share this / commit it to your trust store):")
    out_line("  " + bold(kp.verifying_hex))
end

fn cmd_bind(file: string, into: string) is
    let a: hlib::HlibArchive = open_archive(file)
    match hlib::verify_checksums(a) is
        option::Result::Ok(_) => is end
        option::Result::Err(e) => is die("checksum verification failed: " + e) end
    end
    hlib::make_dirs(into)
    match hlib::extract_to_dir(a, into) is
        option::Result::Ok(_) => is end
        option::Result::Err(e) => is die(e) end
    end
    let m: hlib::Manifest = a.manifest
    let mut stub: string = "// Auto-generated by `h# lib bind` from " + file + "\n"
    stub += "// " + m.name + " v" + m.version + " (" + m.language + ") — do not edit by hand, re-run `h# lib bind` instead.\n\n"
    let mut so_path: string = ""
    for x in m.artifacts is
        if so_path == "" && x.kind == "shared_object" is so_path = x.path end
    end
    if so_path != "" is
        stub += "extern dynamic [rust, \"" + into + "/" + so_path + "\"] is\n"
        for e in m.exports is
            if !e.generic && e.kind == "function" is stub += "    " + e.signature + "\n" end
        end
        stub += "end\n"
    end
    let mut generic_names: [string] = []
    for e in m.exports is
        if e.generic is generic_names.push(e.name) end
    end
    if generic_names.len() > 0 is
        stub += "\n// The following exports carry unresolved type parameters and are only\n// available via the AST artifact — see " + into + "/ast/" + m.name + ".ast.json.\n"
        stub += "// H# does not yet auto-splice these into your module; for now, copy the\n// relevant source from the AST (or from the producer's own source) directly:\n// " + cli_join(generic_names, ", ") + "\n"
    end
    let stub_path: string = into + "/" + m.name + "_hlib_bind.h#"
    fs::write(stub_path, stub)
    out_line(green_b("✓") + " extracted " + to_string(m.artifacts.len()) + " artifact(s) to " + into)
    out_line("  generated binding: " + bold(stub_path))
    out_line("  use it with:       mod " + m.name + "_hlib_bind;")
end

