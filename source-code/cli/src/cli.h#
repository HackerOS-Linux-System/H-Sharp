fn quiet_on() -> bool is return env::get("HSHARP_QUIET") != "" end

fn mkdir_p(dir: string) is
    if dir != "" && dir != "." is system("mkdir -p " + sh_quote(dir)) end
end

fn parent_dir(p: string) -> string is
    let mut i: int = p.len() - 1
    while i >= 0 is
        if byte_at(p, i) == 47 is
            if i == 0 is return "/" end
            return p[0..i]
        end
        i -= 1
    end
    return ""
end

;; Rust `{:.2?}` of a Duration
fn fmt_elapsed(ms: int) -> string is
    if ms >= 1000 is
        let c: int = (ms % 1000) / 10
        let mut cs: string = to_string(c)
        if c < 10 is cs = "0" + cs end
        return to_string(ms / 1000) + "." + cs + "s"
    end
    return to_string(ms) + ".00ms"
end

fn edition_summary_of(recs: [edition::EditionRecord]) -> string is
    let mut years: [int] = []
    for r in recs is
        let mut seen: bool = false
        for y in years is
            if y == r.year is seen = true end
        end
        if !seen is years.push(r.year) end
    end
    let mut i: int = 1
    while i < years.len() is
        let cur: int = years[i]
        let mut j: int = i - 1
        while j >= 0 && years[j] > cur is
            years[j + 1] = years[j]
            j -= 1
        end
        years[j + 1] = cur
        i += 1
    end
    if years.len() == 0 is return "" end
    if years.len() == 1 is return to_string(years[0]) end
    let mut ps: [string] = []
    for y in years is ps.push(to_string(y)) end
    return cli_join(ps, " + ") + " (mixed)"
end

;; returns the process exit code (0 = built)
fn compile_file(a: CompileArgs, year: int) -> int is
    let t0: int = time::now_ms()
    let src_path: string = a.file
    let stem: string = file_stem(src_path)
    let mut out_path: string = a.output
    if out_path == "" is
        mkdir_p("build")
        out_path = "build/" + stem
    end
    mkdir_p(parent_dir(out_path))

    let mut triple: target::TargetTriple = target::host()
    if a.target != "" is
        let tl: target::TargetLookup = target::from_str(a.target)
        if !tl.found is
            eprint(red_b("Error:") + " unknown target `" + a.target + "`. Run `h# targets` to list them.\n")
            return 1
        end
        triple = tl.target
    end

    let mut kind: string = "Binary"
    if a.emit_cpp is
        kind = "Cpp"
    elsif a.emit_kind != "" is
        let kl: options::KindLookup = options::kind_from_str(a.emit_kind)
        if !kl.found is
            eprint(red_b("Error:") + " unknown --emit kind `" + a.emit_kind + "`. Valid: bin, obj, so, lib, cpp\n")
            return 1
        end
        kind = kl.kind
    end

    if a.strict_memory is env::set("HSHARP_STRICT_MEMORY", "1") end
    let optimize: bool = a.release && !a.no_opt

    let mut mm: string = ""
    if a.mem_mode != "" is
        if a.mem_mode == "default" is mm = "Default"
        elsif a.mem_mode == "safety" is mm = "Safety"
        elsif a.mem_mode == "arc" is mm = "Arc"
        elsif a.mem_mode == "arena" is mm = "Arena"
        elsif a.mem_mode == "pointers" is mm = "Pointers"
        else
            eprint(red_b("Error:") + " unknown --mem-mode `" + a.mem_mode + "`. Valid: default, safety, arc, arena, pointers\n")
            return 1
        end
    end

    let opts: options::CompileOptions = options::CompileOptions { target: triple, optimize: optimize, static_link: !a.dynamic,
        debug_info: a.debug, output: out_path, output_kind: kind, default_mem_mode: mm,
        strict_memory: a.strict_memory || env::get("HSHARP_STRICT_MEMORY") == "1", save_cpp: a.save_cpp,
        test_mode: a.test_mode, verbose: a.verbose }

    if a.verbose && a.handoff == "" is
        let mut mode: string = "g++ -O0 (debug)"
        if optimize is mode = "g++ -O2 + gc-sections + strip" end
        out_line("  " + green_b("Compiling:") + " " + src_path + " → " + out_path + target::exe_suffix(triple) + "  [" + mode + "]")
        out_line("")
    end

    if a.handoff == "" is
        return orchestrate(a, opts, year, t0, out_path, kind, triple, optimize)
    end
    return frontend_phase(a, opts, year, src_path)
end

;; ── two-process build: the frontend (parse … cppgen) runs in a child that exits and gives its memory back;
;;    this process then only drives g++ ─────────────────────────────────────────────────────────────────
fn args_of(a: CompileArgs) -> [string] is
    let mut v: [string] = ["compile", a.file]
    if a.output != "" is
        v.push("-o")
        v.push(a.output)
    end
    if a.target != "" is
        v.push("--target")
        v.push(a.target)
    end
    if a.release is v.push("--release") end
    if a.no_opt is v.push("--no-opt") end
    if a.debug is v.push("--debug") end
    if a.dynamic is v.push("--dynamic") end
    if a.emit_cpp is v.push("--emit-cpp") end
    if a.emit_kind != "" is
        v.push("--emit")
        v.push(a.emit_kind)
    end
    if a.verbose is v.push("--verbose") end
    if a.mem_mode != "" is
        v.push("--mem-mode")
        v.push(a.mem_mode)
    end
    if a.strict_memory is v.push("--strict-memory") end
    if a.save_cpp is v.push("--save-cpp") end
    if a.test_mode is v.push("--test-mode") end
    return v
end

fn meta_get(meta: [string], key: string) -> [string] is
    for line in meta is
        let parts: [string] = line.split("\t")
        if parts.len() > 0 && parts[0] == key is
            let mut out: [string] = []
            let mut i: int = 1
            while i < parts.len() is
                if parts[i] != "" is out.push(parts[i]) end
                i += 1
            end
            return out
        end
    end
    return []
end

;; "codegen: path:12:5: message" (or without the prefix) -> [path, line, col, message]; [] when it has no location
fn split_loc(err: string) -> [string] is
    let mut e: string = err
    if starts_with(e, "codegen: ") is e = e[9..e.len()] end
    let mut i: int = 0
    while i < e.len() is
        if byte_at(e, i) == 58 is
            let mut j: int = i + 1
            while j < e.len() && byte_at(e, j) >= 48 && byte_at(e, j) <= 57 is j += 1 end
            if j > i + 1 && j < e.len() && byte_at(e, j) == 58 is
                let mut k: int = j + 1
                while k < e.len() && byte_at(e, k) >= 48 && byte_at(e, k) <= 57 is k += 1 end
                if k > j + 1 && k + 1 < e.len() && byte_at(e, k) == 58 is
                    return [e[0..i], e[i + 1..j], e[j + 1..k], trim_s(e[k + 1..e.len()])]
                end
            end
        end
        i += 1
    end
    let none: [string] = []
    return none
end

;; prints a located error like a syntax error (snippet + caret); false when it cannot be located
fn print_located(err: string, title: string) -> bool is
    let parts: [string] = split_loc(err)
    if parts.len() != 4 is return false end
    if !fs::is_file(parts[0]) || !ends_with(parts[0], ".h#") is return false end   ;; never frame g++ errors in generated C++
    let line: int = to_int(parts[1])
    let col: int = to_int(parts[2])
    let pe: error::ParseError = error::new_error("Custom", parts[0], line, col, 0, line, col + 1, 0, parts[3], [])
    eprint(error::render_titled(pe, fs::read(parts[0]), title) + "\n")
    return true
end

fn frontend_phase(a: CompileArgs, opts: options::CompileOptions, year: int, src_path: string) -> int is
    if !fs::exists(src_path) is
        eprint(red_b("Error:") + " cannot read `" + src_path + "`: No such file or directory (os error 2)\n")
        return 1
    end
    let source: string = fs::read(src_path)

    let rec: edition::EditionRecorder = edition::new_recorder()
    let st: edition::EditionState = edition::new_state()
    edition::start_recording(rec)
    let r: parser::ParseResult = parser::parse_with_default(source, src_path, year, rec, st)
    if parser::has_errors(r) is
        eprint(parser::render_errors(r) + "\n")
        eprint(red_b("✗") + " parsing failed.\n")
        return 1
    end
    let res: modules::Resolver = modules::new_resolver(src_path, [], rec, st)
    let e: modules::Expanded = modules::expand_program(res, r.module, modules::dir_of(src_path))
    if !e.ok is
        eprint(red_b("Error:") + " " + e.err + "\n")
        return 1
    end
    let module: ast::Node = ast::nd("Module", r.module.text, [r.module.kids[0], r.module.kids[1], r.module.kids[2], ast::nd("Items", "", e.items)])

    let recs: [edition::EditionRecord] = edition::take_records(rec)
    if a.verbose && a.phase == "check" is
        for er in recs is
            let mut tag: string = ""
            if !er.declared is tag = "  (default)" end
            out_line("  " + dim("edition") + " " + cyan(to_string(er.year)) + "  " + dim(er.file + tag))
        end
    end
    let note: string = edition::describe_mix(recs)
    if note != "" is eprint(yellow(trim_s(note)) + "\n") end
    let ed_summary: string = edition_summary_of(recs)

    if a.phase == "check" is
        let cr: pipeline::FrontOut = pipeline::check_phase(module, source, src_path, opts)
        if cr.ok is return 0 end
        if cr.diag is return 4 end
        fs::write(a.handoff + "/err", cr.err)
        return 3
    end
    let fr: pipeline::FrontOut = pipeline::gen_phase(module, opts)
    if !fr.ok is
        if fr.diag is return 4 end
        if print_located(fr.err, "CODEGEN ERROR") is return 4 end
        fs::write(a.handoff + "/err", fr.err)
        return 3
    end
    fs::write(a.handoff + "/program.cpp", fr.cpp)
    let link: ffi_linker::LinkFlags = fr.link
    let mut meta: [string] = []
    let mut hm: string = "0"
    if fr.has_main is hm = "1" end
    meta.push("has_main\t" + hm)
    meta.push("static_libs\t" + cli_join(link.static_libs, "\t"))
    meta.push("dynamic_libs\t" + cli_join(link.dynamic_libs, "\t"))
    meta.push("rust_whole_archive_libs\t" + cli_join(link.rust_whole_archive_libs, "\t"))
    meta.push("pkg_config_args\t" + cli_join(link.pkg_config_args, "\t"))
    meta.push("rpath_hints\t" + cli_join(link.rpath_hints, "\t"))
    meta.push("python_notes\t" + cli_join(link.python_notes, "\t"))
    meta.push("diagnostics\t" + cli_join(link.diagnostics, "\t"))
    meta.push("ed_summary\t" + ed_summary)
    meta.push("link_desc\t" + ffi_linker::describe_flags(ffi_linker::collect_link_flags(r.module)))
    fs::write(a.handoff + "/meta", cli_join(meta, "\n"))
    return 0
end

fn orchestrate(a: CompileArgs, opts: options::CompileOptions, year: int, t0: int, out_path: string, kind: string, triple: target::TargetTriple, optimize: bool) -> int is
    let dir: string = env::temp_dir() + "/hsharp_fe_" + to_string(os::pid())
    system("rm -rf " + sh_quote(dir))
    mkdir_p(dir)
    let mut parts: [string] = ["HSHARP_EDITION=" + sh_quote(to_string(year)), "/proc/" + to_string(os::pid()) + "/exe"]
    if year == 0 is parts = ["/proc/" + to_string(os::pid()) + "/exe"] end
    for x in args_of(a) is parts.push(sh_quote(x)) end
    parts.push("--handoff")
    parts.push(sh_quote(dir))
    let base: string = cli_join(parts, " ")
    let t_chk: int = time::now_ms()
    let mut code: int = (system(base + " --phase check") / 256) % 256
    if a.verbose is out_line("  " + dim("front-end check:") + " " + fmt_elapsed(time::now_ms() - t_chk)) end
    let t_gen: int = time::now_ms()
    if code == 0 is code = (system(base + " --phase gen") / 256) % 256 end
    if a.verbose is out_line("  " + dim("C++ generation:") + " " + fmt_elapsed(time::now_ms() - t_gen) + "  (g++ runs next; its errors are printed in full)") end
    if code != 0 is
        if code == 3 is
            let gerr: string = fs::read(dir + "/err")
            if !print_located(gerr, "CODEGEN ERROR") is eprint(red_b("✗ Error:") + " " + gerr + "\n") end
        elsif code == 4 is
            eprint(red_b("✗") + " Compilation failed (type errors above).\n")
        end
        system("rm -rf " + sh_quote(dir))
        return 1
    end
    let meta: [string] = fs::read_lines(dir + "/meta")
    let link: ffi_linker::LinkFlags = ffi_linker::new_flags()
    link.static_libs = meta_get(meta, "static_libs")
    link.dynamic_libs = meta_get(meta, "dynamic_libs")
    link.rust_whole_archive_libs = meta_get(meta, "rust_whole_archive_libs")
    link.pkg_config_args = meta_get(meta, "pkg_config_args")
    link.rpath_hints = meta_get(meta, "rpath_hints")
    link.python_notes = meta_get(meta, "python_notes")
    link.diagnostics = meta_get(meta, "diagnostics")
    let hm: [string] = meta_get(meta, "has_main")
    let has_main: bool = hm.len() > 0 && hm[0] == "1"
    let eds: [string] = meta_get(meta, "ed_summary")
    let ld: [string] = meta_get(meta, "link_desc")
    let mut ed_summary: string = ""
    if eds.len() > 0 is ed_summary = eds[0] end
    let mut link_desc: string = ""
    if ld.len() > 0 is link_desc = ld[0] end
    let cpp: string = fs::read(dir + "/program.cpp")
    system("rm -rf " + sh_quote(dir))
    let inp: cpp_build::BuildInput = cpp_build::BuildInput { cpp: cpp, link: link, has_main: has_main || opts.test_mode,
        strict_memory: opts.strict_memory, verbose: opts.verbose }
    let be: string = cpp_build::build(inp, opts)
    if be != "" is
        eprint(red_b("✗ Error:") + " " + be + "\n")
        return 1
    end
    return report(opts, t0, out_path, kind, triple, optimize, ed_summary, link_desc)
end

fn report(opts: options::CompileOptions, t0: int, out_path: string, kind: string, triple: target::TargetTriple, optimize: bool, ed_summary: string, link_desc: string) -> int is

    if quiet_on() is return 0 end
    let mut artifact_suffix: string = ""
    let mut label: string = "Binary:"
    if kind == "Binary" is
        artifact_suffix = target::exe_suffix(triple)
    elsif kind == "Object" is
        artifact_suffix = ".o"
        label = "Object:"
    elsif kind == "SharedLib" is
        artifact_suffix = options::file_suffix(kind, triple)
        label = "SharedLib:"
    elsif kind == "StaticLib" is
        artifact_suffix = ".a"
        label = "StaticLib:"
    else
        artifact_suffix = ".cpp"
        label = "C++ source:"
    end
    let bin: string = out_path + artifact_suffix
    let elapsed: int = time::now_ms() - t0
    let mut bar: string = ""
    let mut k: int = 0
    while k < 54 is
        bar = bar + "─"
        k += 1
    end
    out_line("")
    out_line(dim(bar))
    out_line("  " + bold(pad_right(label, 10)) + " " + cyan(bin))
    out_line("  " + bold(pad_right("Target:", 10)) + " " + triple.llvm_triple)
    out_line("  " + bold(pad_right("Backend:", 10)) + " " + green("C++ (g++)"))
    if optimize is
        out_line("  " + bold(pad_right("Mode:", 10)) + " " + yellow("release (-O2)"))
    else
        out_line("  " + bold(pad_right("Mode:", 10)) + " " + dim("debug (-O0)"))
    end
    if link_desc != "" is out_line("  " + bold(pad_right("Linked:", 10)) + " " + yellow(link_desc)) end
    out_line("  " + bold(pad_right("Time:", 10)) + " " + fmt_elapsed(elapsed))
    if ed_summary != "" is out_line("  " + bold(pad_right("Edition:", 10)) + " " + cyan(ed_summary)) end
    out_line("  " + bold(pad_right("Toolchain:", 10)) + " h# " + version())
    out_line(dim(bar))
    out_line("\n  " + green_b("✓") + " Build complete!")
    return 0
end

;; compile to a temp binary, run it, forward its exit code
fn build_and_run(file: string, prog_args: [string], test_mode: bool, quiet: bool, year: int) -> int is
    if quiet is env::set("HSHARP_QUIET", "1") end
    let dir: string = env::temp_dir() + "/hsharp_run_" + to_string(os::pid())
    mkdir_p(dir)
    let out: string = dir + "/" + file_stem(file)
    let ca: CompileArgs = new_compile_args(file)
    ca.output = out
    ca.dynamic = true
    ca.test_mode = test_mode
    let rc: int = compile_file(ca, year)
    if rc != 0 is
        system("rm -rf " + sh_quote(dir))
        return rc
    end
    let exe: string = out + target::exe_suffix(target::host())
    let mut parts: [string] = [sh_quote(exe)]
    for x in prog_args is parts.push(sh_quote(x)) end
    let status: int = system(cli_join(parts, " "))
    system("rm -rf " + sh_quote(dir))
    return (status / 256) % 256
end

fn cmd_compile_native(cmd: string, rest: [string], info: EditionInfo) -> int is
    let mut year: int = 0
    if info.edition != "" is year = str_to_int_cli(info.edition) end
    if cmd == "run" is
        let mut quiet: bool = false
        let mut file: string = ""
        let mut prog: [string] = []
        let mut i: int = 0
        while i < rest.len() is
            let a: string = rest[i]
            if prog.len() > 0 is
                prog.push(a)
            elsif a == "-q" || a == "--quiet" is quiet = true
            elsif file != "" is
                prog.push(a)
            elsif a == "--" is
                i += 1
                if i < rest.len() && file == "" is file = rest[i] end
            elsif starts_with(a, "-") && a != "-" is return unexpected(a, "Usage: h# run [OPTIONS] <FILE> [ARGS]...")
            else file = a end
            i += 1
        end
        if file == "" is
            eprint("error: the following required arguments were not provided:\n  <FILE>\n\nUsage: h# run [OPTIONS] <FILE> [ARGS]...\n\nFor more information, try '--help'.\n")
            return 2
        end
        return build_and_run(file, prog, false, quiet, year)
    end
    if cmd == "test" is
        if rest.len() != 1 || starts_with(rest[0], "-") is
            eprint("error: the following required arguments were not provided:\n  <FILE>\n\nUsage: h# test <FILE>\n\nFor more information, try '--help'.\n")
            return 2
        end
        return build_and_run(rest[0], [], true, false, year)
    end
    let mut ca: CompileArgs = new_compile_args("")
    let mut i: int = 0
    while i < rest.len() is
        let a: string = rest[i]
        if is_opt(a, "--output", "-o") is
            ca.output = opt_value(rest, i, "--output", "-o")
            if a == "--output" || a == "-o" is i += 1 end
        elsif is_opt(a, "--target", "-t") is
            ca.target = opt_value(rest, i, "--target", "-t")
            if a == "--target" || a == "-t" is i += 1 end
        elsif is_opt(a, "--emit", "") is
            ca.emit_kind = opt_value(rest, i, "--emit", "")
            if a == "--emit" is i += 1 end
        elsif is_opt(a, "--mem-mode", "") is
            ca.mem_mode = opt_value(rest, i, "--mem-mode", "")
            if a == "--mem-mode" is i += 1 end
        elsif is_opt(a, "--phase", "") is
            ca.phase = opt_value(rest, i, "--phase", "")
            if a == "--phase" is i += 1 end
        elsif is_opt(a, "--handoff", "") is
            ca.handoff = opt_value(rest, i, "--handoff", "")
            if a == "--handoff" is i += 1 end
        elsif a == "--release" is ca.release = true
        elsif a == "--no-opt" is ca.no_opt = true
        elsif a == "--debug" is ca.debug = true
        elsif a == "--dynamic" is ca.dynamic = true
        elsif a == "--emit-cpp" || a == "--emit-ir" is ca.emit_cpp = true
        elsif a == "--save-cpp" is ca.save_cpp = true
        elsif a == "--test-mode" is ca.test_mode = true
        elsif a == "--strict-memory" is ca.strict_memory = true
        elsif a == "-v" || a == "--verbose" is ca.verbose = true
        elsif starts_with(a, "-") && a != "-" is return unexpected(a, "Usage: h# compile [OPTIONS] <FILE>")
        else ca.file = a end
        i += 1
    end
    if ca.file == "" is
        eprint("error: the following required arguments were not provided:\n  <FILE>\n\nUsage: h# compile [OPTIONS] <FILE>\n\nFor more information, try '--help'.\n")
        return 2
    end
    return compile_file(ca, year)
end

pub fn run(argv: [string]) -> int is
    color_init()
    ;; the global --edition flag may appear anywhere (e.g. `h# lib build x.h# --edition 2026`); for `run` only before the file,
    ;; because everything after it belongs to the program
    let mut edition_flag: string = ""
    let mut args: [string] = []
    let mut i: int = 0
    while i < argv.len() is
        let a: string = argv[i]
        if a == "--" is
            while i < argv.len() is
                args.push(argv[i])
                i += 1
            end
            break
        end
        if is_opt(a, "--edition", "") && (args.len() < 2 || (args.len() >= 1 && args[0] != "run")) is
            edition_flag = opt_value(argv, i, "--edition", "")
            if a == "--edition" is i += 1 end
        else
            args.push(a)
        end
        i += 1
    end
    if args.len() == 0 is
        eprint(usage() + "\n")
        return 2
    end
    let cmd: string = args[0]
    if cmd == "-h" || cmd == "--help" || cmd == "help" is
        out_line(usage())
        return 0
    end
    if cmd == "-V" || cmd == "--version" is
        out_line("h# " + version())
        return 0
    end
    let mut rest: [string] = []
    let mut k: int = 1
    while k < args.len() is
        rest.push(args[k])
        k += 1
    end

    ;; the default edition is resolved once, up front (flag > HSHARP_EDITION > Bit.hk > newest)
    let mut anchor: string = "."
    if (cmd == "compile" || cmd == "run" || cmd == "test" || cmd == "ffi-header" || cmd == "check" || cmd == "fmt") && rest.len() > 0 && !starts_with(rest[0], "-") is
        anchor = rest[0]
    end
    if cmd == "lib" && rest.len() > 1 && rest[0] == "build" && !starts_with(rest[1], "-") is anchor = rest[1] end
    let info: EditionInfo = resolve_edition(edition_flag, env::get("HSHARP_EDITION"), anchor)
    if info.err != "" is
        eprint(red_b("Error:") + " " + info.err + "\n")
        return 2
    end

    if cmd == "check" is return cmd_check(rest, info) end
    if cmd == "targets" is return cmd_targets(rest, info) end
    if cmd == "ffi-header" is return cmd_ffi_header_native(rest, info) end
    if cmd == "compile" || cmd == "run" || cmd == "test" is
        return cmd_compile_native(cmd, rest, info)
    end
    let known: [string] = ["new", "fmt", "lsp", "docs", "editions", "lib"]
    let mut is_known: bool = false
    for kcmd in known is
        if kcmd == cmd is is_known = true end
    end
    if !is_known is
        eprint(unknown_subcommand(cmd, "h#", "[OPTIONS] "))
        return 2
    end
    if cmd == "new" is
        let mut name: string = ""
        let mut template: string = "app"
        let mut j: int = 0
        while j < rest.len() is
            if is_opt(rest[j], "--template", "-t") is
                template = opt_value(rest, j, "--template", "-t")
                if rest[j] == "--template" || rest[j] == "-t" is j += 1 end
            else
                name = rest[j]
            end
            j += 1
        end
        if name == "" is
            eprint("error: the following required arguments were not provided:\n  <NAME>\n\nUsage: h# new <NAME>\n\nFor more information, try '--help'.\n")
            return 2
        end
        banner(info)
        cmd_new(name, template)
        return 0
    end
    if cmd == "fmt" is
        let mut files: [string] = []
        let mut check: bool = false
        for r in rest is
            if r == "--check" is check = true else files.push(r) end
        end
        banner(info)
        return cmd_fmt(files, check)
    end
    if cmd == "lsp" is return langserver::run() end
    if cmd == "docs" is
        banner(info)
        cmd_docs()
        return 0
    end
    if cmd == "editions" is
        banner(info)
        cmd_editions(info)
        return 0
    end
    if cmd == "lib" is return run_lib(rest, edition_flag, info) end
    eprint(unknown_subcommand(cmd, "h#", "[OPTIONS] "))
    return 2
end
