;; ── small helpers ─────────────────────────────────────────────────────────────
fn starts_with(s: string, p: string) -> bool is
    return s.len() >= p.len() && s[0..p.len()] == p
end

fn ends_with(s: string, p: string) -> bool is
    return s.len() >= p.len() && s[s.len() - p.len()..s.len()] == p
end

fn trim_s(s: string) -> string is
    let mut a: int = 0
    let mut e: int = s.len()
    while a < e && (byte_at(s, a) == 32 || byte_at(s, a) == 9 || byte_at(s, a) == 13) is a += 1 end
    while e > a && (byte_at(s, e - 1) == 32 || byte_at(s, e - 1) == 9 || byte_at(s, e - 1) == 13) is e -= 1 end
    return s[a..e]
end

fn index_of(s: string, needle: string) -> int is
    let n: int = needle.len()
    let mut i: int = 0
    while i + n <= s.len() is
        if s[i..i + n] == needle is return i end
        i += 1
    end
    return -1
end

fn lower(s: string) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < s.len() is
        let c: int = byte_at(s, i)
        out += str_from_byte(if c >= 65 && c <= 90 is c + 32 else c end)
        i += 1
    end
    return out
end

fn sh_quote(s: string) -> string is
    let mut out: string = "'"
    let mut i: int = 0
    while i < s.len() is
        let c: int = byte_at(s, i)
        if c == 39 is out += "'\\''" else out += str_from_byte(c) end
        i += 1
    end
    return out + "'"
end

fn dir_of(path: string) -> string is
    let mut i: int = path.len() - 1
    while i >= 0 is
        if byte_at(path, i) == 47 is return path[0..i] end
        i -= 1
    end
    return ""
end

fn file_stem(path: string) -> string is
    let mut a: int = path.len()
    while a > 0 && byte_at(path, a - 1) != 47 is a -= 1 end
    let name: string = path[a..path.len()]
    let mut e: int = name.len() - 1
    while e > 0 is
        if byte_at(name, e) == 46 is return name[0..e] end
        e -= 1
    end
    return name
end

fn out_line(s: string) is
    write(s)
end

;; ── stage0 delegation ─────────────────────────────────────────────────────────
fn stage0() -> string is
    let e: string = env::get("HSHARP_STAGE0")
    if e != "" is return e end
    let me: string = env::args()[0]
    let d: string = dir_of(me)
    ;; bin/hsharp (this binary) delegates to bin/stage0/hsharp (the Rust transpiler); never to itself
    if d != "" && fs::exists(d + "/stage0/hsharp") is return d + "/stage0/hsharp" end
    return "hsharp-stage0"
end

;; run the stage0 CLI with `args` (stdio inherited) and exit with its status
fn delegate(args: [string], edition_flag: string) is
    let mut parts: [string] = [sh_quote(stage0())]
    if edition_flag != "" is
        parts.push("--edition")
        parts.push(sh_quote(edition_flag))
    end
    for a in args is parts.push(sh_quote(a)) end
    let status: int = system(cli_join(parts, " "))
    exit((status / 256) % 256)
end

;; ── editions (edition_cmd.rs) ─────────────────────────────────────────────────
fn latest_edition() -> string is return "2026" end
fn edition_summary() -> string is
    return "baseline syntax: `is … end` blocks, `use \"std -> x\"`, `@: mode`, hlib/bit/workspace imports"
end

;; Err(message) reproduces `Edition::parse`'s message + hints
fn edition_error(raw: string) -> string is
    let t: string = trim_s(raw)
    let mut digits: bool = t.len() == 4
    let mut i: int = 0
    while i < t.len() is
        if byte_at(t, i) < 48 || byte_at(t, i) > 57 is digits = false end
        i += 1
    end
    let supported: string = "supported editions: " + latest_edition()
    if !digits is
        return "invalid edition `" + raw + "` in `using` declaration (expected a four-digit year, e.g. \"" + latest_edition() + "\")\n  hint: write it as `using \"" + latest_edition() + "\"`; " + supported
    end
    if t == latest_edition() is return "" end
    if to_int(t) > to_int(latest_edition()) is
        return "edition \"" + t + "\" is newer than this H# toolchain (v" + version() + ") understands\n  hint: upgrade H# (`hsharp --version` shows v" + version() + "), or change the file to `using \"" + latest_edition() + "\"`; this file was written for edition " + t + "; " + supported
    end
    return "edition \"" + t + "\" is no longer supported by this H# toolchain (v" + version() + ")\n  hint: migrate the file to `using \"" + latest_edition() + "\"`; " + supported
end

;; nearest directory (walking up from `start`) holding a Bit.hk / bit.hk; "" if none
fn abspath(p: string) -> string is
    let full: string = if starts_with(p, "/") is p else fs::cwd() + "/" + p end
    let mut parts: [string] = []
    for seg in string_split(full, "/") is
        if seg == "" || seg == "." is continue end
        if seg == ".." is
            if parts.len() > 0 is
                let mut kept: [string] = []
                let mut i: int = 0
                while i < parts.len() - 1 is
                    kept.push(parts[i])
                    i += 1
                end
                parts = kept
            end
            continue
        end
        parts.push(seg)
    end
    return "/" + cli_join(parts, "/")
end

fn manifest_dir(start: string) -> string is
    let mut d: string = start
    if d == "" is d = "." end
    if fs::is_file(d) is d = dir_of(d) end
    if d == "" is d = "." end
    let mut depth: int = 0
    while depth < 12 is
        if fs::exists(d + "/Bit.hk") || fs::exists(d + "/bit.hk") is return d end
        if d == "/" || d == "" is return "" end
        let p: string = if d == "." is ".." else d + "/.." end
        if !fs::is_dir(p) is return "" end
        d = p
        depth += 1
    end
    return ""
end

fn hk_unquote(v: string) -> string is
    let s: string = trim_s(v)
    if s.len() >= 2 && (byte_at(s, 0) == 34 || byte_at(s, 0) == 39) && byte_at(s, s.len() - 1) == byte_at(s, 0) is return s[1..s.len() - 1] end
    return s
end

;; value of `-> key => value` in [section] (top-level keys only), "" if absent
fn hk_get(content: string, want_section: string, want_key: string) -> string is
    let mut section: string = ""
    for raw in string_split(content, "\n") is
        let line: string = trim_s(raw)
        if line == "" || starts_with(line, "!") || starts_with(line, ";;") is continue end
        if starts_with(line, "[") && ends_with(line, "]") is
            section = lower(trim_s(line[1..line.len() - 1]))
            continue
        end
        let mut dashes: int = 0
        while dashes < line.len() && byte_at(line, dashes) == 45 is dashes += 1 end
        if dashes != 1 || dashes >= line.len() || byte_at(line, dashes) != 62 is continue end
        let rest: string = trim_s(line[dashes + 1..line.len()])
        let eq: int = index_of(rest, "=>")
        if eq < 0 is continue end
        if section == want_section && trim_s(rest[0..eq]) == want_key is
            return hk_unquote(rest[eq + 2..rest.len()])
        end
    end
    return ""
end

fn lang_is_hsharp(content: string) -> bool is
    let mut raw: string = hk_get(content, "package", "lang")
    if raw == "" is raw = hk_get(content, "project", "lang") end
    if raw == "" is raw = hk_get(content, "build", "lang") end
    if raw == "" is return false end
    for part in string_split(raw, ",") is
        let mut t: string = ""
        let l: string = lower(part)
        let mut i: int = 0
        while i < l.len() is
            let c: int = byte_at(l, i)
            if c != 32 && c != 45 && c != 95 && c != 34 && c != 39 && c != 91 && c != 93 is t += str_from_byte(c) end
            i += 1
        end
        if t == "h#" || t == "hsharp" || t == "hsh" || t == "hs#" is return true end
    end
    return false
end

;; result: edition + where it came from; error message in `err` (exit code 2 in `init`)
pub struct EditionInfo is
    pub edition: string
    pub source: string
    pub err: string
end

fn describe_source(s: string) -> string is
    if s == "flag" is return "--edition flag" end
    if s == "env" is return "HSHARP_EDITION" end
    if s == "bit" is return "Bit.hk [edition]" end
    return "newest known edition"
end

fn resolve_edition(flag: string, envv: string, anchor: string) -> EditionInfo is
    if flag != "" is
        let m: string = edition_error(flag)
        if m != "" is return EditionInfo { edition: "", source: "", err: "--edition " + flag + ": " + m } end
        return EditionInfo { edition: trim_s(flag), source: "flag", err: "" }
    end
    let ev: string = trim_s(envv)
    if ev != "" is
        let m: string = edition_error(ev)
        if m != "" is return EditionInfo { edition: "", source: "", err: "HSHARP_EDITION=" + ev + ": " + m } end
        return EditionInfo { edition: ev, source: "env", err: "" }
    end
    let d: string = manifest_dir(anchor)
    if d != "" is
        let ad: string = abspath(d)
        let mf: string = if fs::exists(ad + "/Bit.hk") is ad + "/Bit.hk" else ad + "/bit.hk" end
        let content: string = fs::read(mf)
        if lang_is_hsharp(content) is
            let raw: string = hk_get(content, "edition", "edition")
            if raw != "" is
                let m: string = edition_error(raw)
                if m != "" is
                    return EditionInfo { edition: "", source: "", err: mf + ": [edition] -> edition => " + raw + ": " + m }
                end
                return EditionInfo { edition: trim_s(raw), source: "bit", err: "" }
            end
        end
    end
    return EditionInfo { edition: latest_edition(), source: "latest", err: "" }
end

fn cmd_editions(info: EditionInfo) is
    out_line(bold("Supported H# editions:"))
    let mark: string = if latest_edition() == info.edition is "*" else " " end
    out_line("  " + mark + " " + cyan_b(latest_edition()) + "  " + green("stable") + " (latest)  " + dim(edition_summary()))
    out_line("")
    out_line("  " + bold("default for files without `using`:") + " " + cyan(info.edition) + "  " + dim("(from " + describe_source(info.source) + ")"))
    out_line(dim("  pick one per file:      using \"2026\""))
    out_line(dim("  pick one per run:       h# compile main.h# --edition 2026   (or HSHARP_EDITION=2026)"))
    out_line(dim("  pick one per project:   Bit.hk  [edition] -> edition => 2026   (needs lang => h#)"))
end

