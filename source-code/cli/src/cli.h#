;; stderr (H# has no stderr builtin; the string goes straight through libc)
fn eprint(s: string) is
    fflush(0)                              ;; keep stdout/stderr in program order
    let f: int = fdopen(2, "w")
    fputs(s, f)
    fflush(f)
end

fn version() -> string is return "0.9.0" end

;; ── terminal colours (the `colors` library through cli_style.h#; only on a terminal, never with NO_COLOR) ──
fn color_on() -> bool is
    let forced: string = env::get("HSHARP_COLOR")      ;; set by the parent `h#` for its `--phase` children
    if forced == "1" is return true end
    if forced == "0" is return false end
    ;; explicit override for a child whose stdout is a pipe / log file (bit sets it): same switch nidus honours
    let nc: string = env::get("NIDUS_COLOR")
    if nc == "always" || nc == "1" || nc == "true" || nc == "on" is return true end
    if nc == "never" || nc == "0" || nc == "false" || nc == "off" is return false end
    if env::get("NO_COLOR") != "" is return false end
    if env::get("CLICOLOR_FORCE") != "" || env::get("FORCE_COLOR") != "" is return true end
    if env::get("TERM") == "dumb" is return false end
    return isatty(1) != 0 || isatty(2) != 0
end

;; decides colour once per process; the parser's nidus error frames read HSHARP_COLOR too
fn color_init() is
    if color_on() is
        cli_style::enable()
        env::set("HSHARP_COLOR", "1")
    else
        cli_style::disable()
        env::set("HSHARP_COLOR", "0")
    end
end

