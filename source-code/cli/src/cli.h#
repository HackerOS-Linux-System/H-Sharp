fn cli_join(parts: [string], sep: string) -> string is
    let mut sb = strbuf::new()
    let mut i: int = 0
    while i < parts.len() is
        if i > 0 is sb.push(sep) end
        sb.push(parts[i])
        i += 1
    end
    return sb.build()
end

