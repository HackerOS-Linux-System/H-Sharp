use "std -> fs" from "fs"
use "std -> env" from "env"

mod types
mod run

;; ── H# playground — entry point ──────────────────────────────────────────────────────────────────────────────────
;; Replaces the Rust `wasm-bindgen` crate (lib.rs: version / editions / latest_edition / run / run_with_limit).
;; H# builds to WebAssembly itself (`bit --target wasm`, emcc under the hood), and a wasm32-emscripten module does not
;; export named functions the way wasm-bindgen does — it exposes `main`.  The playground is therefore one command with a
;; tiny, stable protocol; the host page calls it with `Module.callMain([...])` and reads ONE line of JSON from stdout:
;;
;;   hsharp-playground version               -> 0.9.0
;;   hsharp-playground editions              -> ["2026"]
;;   hsharp-playground latest-edition        -> 2026
;;   hsharp-playground run   <file> [--max-steps N]   -> RunResult JSON   (what `run` / `run_with_limit` returned)
;;   hsharp-playground check <file>                   -> RunResult JSON   (alias of `run`: there is nothing more to do)
;;
;; `<file>` is a path inside the module's virtual FS: the page does `FS.writeFile("/input.h#", source)` first.
;; The exit status is 0 whenever a JSON answer was printed (a rejected program is data, `.ok == false`, not a crash).

extern static [c] is
    fn fflush(f: int) -> int
    fn fdopen(fd: int, mode: string) -> int
    fn fputs(s: string, f: int) -> int
end

;; stderr (H# has no stderr builtin; same approach as cli.h#)
fn eprint(s: string) is
    fflush(0)
    let f: int = fdopen(2, "w")
    fputs(s, f)
    fflush(f)
end

fn usage() -> string is
    return "usage: hsharp-playground <version|editions|latest-edition|run FILE [--max-steps N]|check FILE>"
end

fn max_steps_from(args: [string]) -> int is
    let mut i: int = 3
    while i + 1 < args.len() is
        if args[i] == "--max-steps" is return str_to_int(args[i + 1]) end
        i += 1
    end
    return 0
end

fn main() is
    run::prepare_env()
    let args: [string] = env_args()
    if args.len() < 2 is
        eprint(usage() + "\n")
        exit(2)
    end
    let cmd: string = args[1]
    if cmd == "version" is
        print(run::version())
        exit(0)
    end
    if cmd == "editions" is
        print(run::editions_json())
        exit(0)
    end
    if cmd == "latest-edition" is
        print(run::latest_edition())
        exit(0)
    end
    if cmd == "run" || cmd == "check" is
        if args.len() < 3 is
            print(run::fallback_error_json("missing <file>: " + usage()))
            exit(0)
        end
        if !fs::is_file(args[2]) is
            print(run::fallback_error_json("cannot read `" + args[2] + "`: no such file in the module's file system"))
            exit(0)
        end
        let source: string = fs::read(args[2])
        print(run::run_with_limit(source, max_steps_from(args)))
        exit(0)
    end
    eprint(usage() + "\n")
    exit(2)
end
