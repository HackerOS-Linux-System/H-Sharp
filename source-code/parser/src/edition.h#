use "std -> strbuf" from "strbuf"

mod ast

pub fn toolchain_version() -> string is
    return "0.9.0"
end

pub fn latest_year() -> int is
    return 2026
end

pub fn latest() -> string is
    return "2026"
end

pub fn supported_list() -> string is
    return "2026"
end

pub fn is_known_year(y: int) -> bool is
    return y == 2026
end

;; kind: "Malformed" | "TooNew" | "Retired"
pub struct EditionError is
    pub kind: string
    pub text: string
    pub year: int
end

;; Edition::parse — `ok == true` -> year in `year`, else `err`
pub struct EditionParse is
    pub ok:   bool
    pub year: int
    pub err:  EditionError
end

fn trim_ws(s: string) -> string is
    let mut a: int = 0
    let mut b: int = s.len()
    while a < b && (byte_at(s, a) == 32 || byte_at(s, a) == 9 || byte_at(s, a) == 10 || byte_at(s, a) == 13) is a += 1 end
    while b > a && (byte_at(s, b - 1) == 32 || byte_at(s, b - 1) == 9 || byte_at(s, b - 1) == 10 || byte_at(s, b - 1) == 13) is b -= 1 end
    return s[a..b]
end

pub fn parse_edition(s: string) -> EditionParse is
    let t: string = trim_ws(s)
    let mut digits: string = t
    if t.len() > 0 && byte_at(t, 0) == 43 is digits = t[1..t.len()] end
    let mut all_digits: bool = digits.len() > 0
    let mut i: int = 0
    while i < digits.len() is
        let c: int = byte_at(digits, i)
        if c < 48 || c > 57 is all_digits = false end
        i += 1
    end
    if !all_digits || t.len() != 4 is
        return EditionParse { ok: false, year: 0, err: EditionError { kind: "Malformed", text: s, year: 0 } }
    end
    let year: int = __builtin_conv_str_to_int(digits)
    if is_known_year(year) is
        return EditionParse { ok: true, year: year, err: EditionError { kind: "", text: "", year: 0 } }
    end
    if year > latest_year() is
        return EditionParse { ok: false, year: 0, err: EditionError { kind: "TooNew", text: "", year: year } }
    end
    return EditionParse { ok: false, year: 0, err: EditionError { kind: "Retired", text: "", year: year } }
end

pub fn edition_error_message(e: EditionError) -> string is
    let v: string = toolchain_version()
    if e.kind == "Malformed" is
        return "invalid edition `{e.text}` in `using` declaration (expected a four-digit year, e.g. \"2026\")"
    end
    if e.kind == "TooNew" is
        return "edition \"{e.year}\" is newer than this H# toolchain (v{v}) understands"
    end
    return "edition \"{e.year}\" is no longer supported by this H# toolchain (v{v})"
end

pub fn edition_error_hints(e: EditionError) -> [string] is
    let v: string = toolchain_version()
    let mut h: [string] = []
    if e.kind == "Malformed" is
        h.push("write it as `using \"2026\"`")
    elsif e.kind == "TooNew" is
        h.push("upgrade H# (`hsharp --version` shows v{v}), or change the file to `using \"2026\"`")
        h.push("this file was written for edition {e.year}")
    else
        h.push("migrate the file to `using \"2026\"`")
    end
    h.push("supported editions: " + supported_list())
    return h
end

pub fn is_edition_diagnostic(message: string) -> bool is
    return message.contains("edition \"") || message.contains("`using`") || message.contains("invalid edition") || message.contains("requires edition")
end

;; `effective_edition_with`: the declared edition if it parses, else the file default, else the global default (2026)
pub fn effective_year(declared: string, has_declared: bool, file_default_year: int) -> int is
    if has_declared is
        let r: EditionParse = parse_edition(declared)
        if r.ok is return r.year end
    end
    if file_default_year > 0 is return file_default_year end
    return latest_year()
end

;; HSHARP_EDITION: Ok(0) when unset/blank, Ok(year), or the parse error
pub fn default_year_from_env() -> EditionParse is
    let v: string = env_get("HSHARP_EDITION")
    if trim_ws(v).len() == 0 is
        return EditionParse { ok: true, year: 0, err: EditionError { kind: "", text: "", year: 0 } }
    end
    return parse_edition(v)
end

;; Relation of an imported dependency's edition to the importer's: "Same" | "DependencyOlder" | "DependencyNewer"
pub fn relate(importer: int, dependency: int) -> string is
    if dependency == importer is return "Same" end
    if dependency < importer is return "DependencyOlder" end
    return "DependencyNewer"
end

pub struct EditionRecord is
    pub file:     string
    pub year:     int
    pub declared: bool
end

pub struct EditionRecorder is
    pub active:  bool
    pub records: [EditionRecord]
end

pub fn new_recorder() -> EditionRecorder is
    return EditionRecorder { active: false, records: [] }
end

pub fn start_recording(r: EditionRecorder) is
    r.active = true
    r.records = []
end

pub fn record(r: EditionRecorder, file: string, year: int, declared: bool) is
    if r.active is r.records.push(EditionRecord { file: file, year: year, declared: declared }) end
end

;; take_records: first record per file
pub fn take_records(r: EditionRecorder) -> [EditionRecord] is
    let mut out: [EditionRecord] = []
    for rec in r.records is
        let mut seen: bool = false
        for o in out is
            if o.file == rec.file is seen = true end
        end
        if !seen is out.push(rec) end
    end
    r.active = false
    r.records = []
    return out
end

;; describe_mix: "" when fewer than two distinct editions are present
pub fn describe_mix(records: [EditionRecord]) -> string is
    let mut years: [int] = []
    for r in records is
        let mut seen: bool = false
        for y in years is
            if y == r.year is seen = true end
        end
        if !seen is years.push(r.year) end
    end
    if years.len() < 2 is return "" end
    let mut s: string = "note: this build mixes H# editions (each file is compiled under its own):\n"
    for y in years is
        let mut n: int = 0
        for r in records is
            if r.year == y is n += 1 end
        end
        s += "  edition {y}: {n} file(s)\n"
    end
    return s
end


