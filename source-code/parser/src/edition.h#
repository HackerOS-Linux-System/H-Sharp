    return "Stable"
end

pub fn edition_summary(year: int) -> string is
    return "baseline syntax: `is … end` blocks, `use \"std -> x\"`, `@: mode`, hlib/bit/workspace imports"
end

pub fn std_edition() -> int is
    return 2026
end

;; DEFAULT_YEAR static -> explicit state value (0 = unset -> LATEST)
pub struct EditionState is
    pub default_year: int
end

pub fn new_state() -> EditionState is
    return EditionState { default_year: 0 }
end

pub fn default_edition(st: EditionState) -> int is
    if is_known_year(st.default_year) is return st.default_year end
    return latest_year()
end

pub fn set_default_edition(st: EditionState, year: int) is
    st.default_year = year
end

pub fn reset_default_edition(st: EditionState) is
    st.default_year = 0
end

;; init_default_from_env: sets the default from HSHARP_EDITION; Err -> `.ok == false`
pub fn init_default_from_env(st: EditionState) -> EditionParse is
    let r: EditionParse = default_year_from_env()
    if r.ok && r.year > 0 is set_default_edition(st, r.year) end
    return r
end

;; EditionFeature: "FileMemMode" | "StdImport" | "BitImport" | "HlibImport" | "WorkspaceImport"
pub fn feature_since(feature: string) -> int is
    return 2026
end

pub fn feature_name(feature: string) -> string is
    if feature == "FileMemMode" is return "file-level `@: mode` directive" end
    if feature == "StdImport" is return "`use \"std -> …\"` imports" end
    if feature == "BitImport" is return "`use \"bit -> …\"` imports" end
    if feature == "HlibImport" is return "`use \"hlib -> …\"` imports" end
    return "`use \"workspace -> …\"` imports"
end

pub fn supports(year: int, feature: string) -> bool is
    return year >= feature_since(feature)
end

pub struct FeatureViolation is
    pub feature: string
    pub year:    int
    pub sp:      ast::Sp
end

pub fn violation_message(v: FeatureViolation) -> string is
    let fname: string = feature_name(v.feature)
    let since: int = feature_since(v.feature)
    return "{fname} requires edition \"{since}\" or newer, but this file uses \"{v.year}\""
end

;; effective_edition_with(module, file_default): declared edition if it parses, else file default, else the state default
pub fn effective_edition_with(module: ast::Node, file_default_year: int, st: EditionState) -> int is
    let decl: string = module.kids[0].text
    if decl.len() > 0 is
        let r: EditionParse = parse_edition(decl)
        if r.ok is return r.year end
    end
    if file_default_year > 0 is return file_default_year end
    return default_edition(st)
end

pub fn effective_edition(module: ast::Node, st: EditionState) -> int is
    return effective_edition_with(module, 0, st)
end

fn dummy_sp() -> ast::Sp is
    return ast::Sp { sl: 1, sc: 1, so: 0, el: 1, ec: 1, eo: 0 }
end

;; check_features(module, edition) — Module = (Edition, FileMem, Imports, Items, …)
pub fn check_features(module: ast::Node, year: int) -> [FeatureViolation] is
    let mut out: [FeatureViolation] = []
    let ed: ast::Node = module.kids[0]
    let mut decl: ast::Sp = dummy_sp()
    if ed.sp is decl = ast::sp_of(ed) end
    if module.kids[1].text.len() > 0 && !supports(year, "FileMemMode") is
        out.push(FeatureViolation { feature: "FileMemMode", year: year, sp: decl })
    end
    for im in module.kids[2].kids is
        let mut f: string = ""
        if im.text == "Std" || im.text == "Core" is f = "StdImport"
        elsif im.text == "BitRepo" is f = "BitImport"
        elsif im.text == "Hlib" is f = "HlibImport"
        elsif im.text == "Workspace" is f = "WorkspaceImport" end
        if f.len() > 0 && !supports(year, f) is
            out.push(FeatureViolation { feature: f, year: year, sp: ast::sp_of(im) })
        end
    end
    return out
end

