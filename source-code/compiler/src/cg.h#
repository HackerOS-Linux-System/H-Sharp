use "std -> map" from "map"
use "std -> strbuf" from "strbuf"
use "workspace -> parser" from "lib -> *"
use "workspace -> typecheck" from "lib -> *"
mod builtins
mod builtin_syms_table

pub struct StructInfo is
    pub params: [string]
    pub fields: [ast::Node]      ;; Field nodes: text = name, kids = [B pub, type]
end

pub struct EnumInfo is
    pub params: [string]
    pub variants: [ast::Node]    ;; Variant nodes: text = name, kids = [Unit | Tuple(types) | StructV(Fields)]
end

pub struct FnSig is
    pub params: [ast::Node]      ;; Param nodes: text = name, kids = [B mut, type]
    pub ret: ast::Node           ;; type node or `None`
    pub generics: [string]
    pub is_async: bool
    pub is_method: bool
    pub method_name: string
    pub self_ty: string
    pub owner: string            ;; "" = none
end

pub struct Gen is
    pub module: ast::Node
    pub test_mode: bool
    pub structs: map::Map<string, StructInfo>
    pub enums: map::Map<string, EnumInfo>
    pub aliases: map::Map<string, ast::Node>
    pub variant_owner: map::Map<string, [string]>
    pub fns: map::Map<string, FnSig>
    pub externs: map::Map<string, ast::Node>
    pub extern_py: map::Map<string, string>
    pub extern_min: map::Map<string, int>
    pub used_builtins: map::Set<string>
    pub tparams: [string]
    pub scopes: [map::Map<string, string>]
    pub declared: map::Set<string>
    pub var_tys: [map::Map<string, ast::Node>]
    pub uniq: int
    pub cur_ret: ast::Node       ;; `None` when absent
    pub cur_mode: string
    pub arc_tracked: [string]
    pub drop_names: [string]     ;; @safety: array locals freed at scope end (drops.h#)
    pub cur_fn: string
    pub cur_fn_is_std: bool
    pub warnings: [string]
    pub mf_m: [string]           ;; method_fallbacks (m, b) pairs, kept sorted + unique
    pub mf_b: [string]
    pub err: string
    pub depth: int
    pub hand: map::Set<string>   ;; HAND_BUILTINS + EXTRA_HAND
    pub tc_ret: map::Map<string, string>
    ;; caches: the compiler never frees strings/arrays, so per-call lookups that allocate (builtin table scans,
    ;; `empty_sig()`, scanning every fn for a method name) turned into gigabytes of garbage on large programs
    pub bknown: map::Map<string, string>     ;; builtin_known(name) -> "1"/"0"
    pub bres: map::Map<string, string>       ;; resolve_builtin(name)
    pub esig: FnSig                          ;; shared empty signature (read-only)
    pub um: map::Set<string>                 ;; names of user-defined methods
    pub um_ready: bool
end

pub fn new_gen(module: ast::Node, test_mode: bool) -> Gen is
    let hand: map::Set<string> = map::Set::new()
    for n in hand_builtins() is hand.add(n) end
    for n in extra_hand() is hand.add(n) end
    let tcr: map::Map<string, string> = map::Map::new()
    for e in tc_builtins::builtin_table() is
        let parts: [string] = split_on(e, 124)
        if parts.len() == 3 is tcr.put(parts[0], parts[2]) end
    end
    return Gen { module: module, test_mode: test_mode, structs: map::Map::new(), enums: map::Map::new(), aliases: map::Map::new(),
        variant_owner: map::Map::new(), fns: map::Map::new(), externs: map::Map::new(), extern_py: map::Map::new(), extern_min: map::Map::new(),
        used_builtins: map::Set::new(), tparams: [], scopes: [], declared: map::Set::new(), var_tys: [], uniq: 0,
        cur_ret: ast::nn(), cur_mode: "Default", arc_tracked: [], drop_names: [], cur_fn: "", cur_fn_is_std: false, warnings: [],
        mf_m: [], mf_b: [], err: "", depth: 0, hand: hand, tc_ret: tcr,
        bknown: map::Map::new(), bres: map::Map::new(),
        esig: FnSig { params: [], ret: ast::nn(), generics: [], is_async: false, is_method: false, method_name: "", self_ty: "", owner: "" },
        um: map::Set::new(), um_ready: false }
end

;; ── small string helpers ──────────────────────────────────────────────────────
pub fn split_on(s: string, sep: int) -> [string] is
    let mut out: [string] = []
    let mut cur: string = ""
    let mut i: int = 0
    while i < s.len() is
        let c: int = byte_at(s, i)
        if c == sep is
            out.push(cur)
            cur = ""
        else
            cur = cur + str_from_byte(c)
        end
        i += 1
    end
    out.push(cur)
    return out
end

pub fn has_prefix(s: string, p: string) -> bool is
    return s.len() >= p.len() && s[0..p.len()] == p
end

pub fn has_suffix(s: string, p: string) -> bool is
    return s.len() >= p.len() && s[s.len() - p.len()..s.len()] == p
end

pub fn has_sub(s: string, p: string) -> bool is
    let n: int = s.len()
    let m: int = p.len()
    let mut i: int = 0
    while i + m <= n is
        if s[i..i + m] == p is return true end
        i += 1
    end
    return false
end

pub fn join_with(xs: [string], sep: string) -> string is
    let mut sb = strbuf::new()
    let mut i: int = 0
    while i < xs.len() is
        if i > 0 is sb.push(sep) end
        sb.push(xs[i])
        i += 1
    end
    return sb.build()
end

pub fn in_list(xs: [string], s: string) -> bool is
    for x in xs is
        if x == s is return true end
    end
    return false
end

pub fn is_digits(s: string) -> bool is
    if s.len() == 0 is return false end
    let mut i: int = 0
    while i < s.len() is
        let c: int = byte_at(s, i)
        if c < 48 || c > 57 is return false end
        i += 1
    end
    return true
end

pub fn is_upper_first(s: string) -> bool is
    if s.len() == 0 is return false end
    let c: int = byte_at(s, 0)
    return c >= 65 && c <= 90
end

;; the part after the last `::`
pub fn rsplit_last(s: string) -> string is
    let mut at: int = -1
    let mut i: int = 0
    while i + 1 < s.len() is
        if byte_at(s, i) == 58 && byte_at(s, i + 1) == 58 is at = i end
        i += 1
    end
    if at < 0 is return s end
    return s[at + 2..s.len()]
end

;; `rsplit_once("::")` -> found flag in `ok`
pub struct Split2 is
    pub ok: bool
    pub a: string
    pub b: string
end

pub fn rsplit_once(s: string, sep: string) -> Split2 is
    let mut at: int = -1
    let mut i: int = 0
    while i + sep.len() <= s.len() is
        if s[i..i + sep.len()] == sep is at = i end
        i += 1
    end
    if at < 0 is return Split2 { ok: false, a: s, b: "" } end
    return Split2 { ok: true, a: s[0..at], b: s[at + sep.len()..s.len()] }
end

pub fn replace_all(s: string, from: string, to: string) -> string is
    if from.len() == 0 is return s end
    let mut sb = strbuf::new()
    let mut i: int = 0
    while i < s.len() is
        if i + from.len() <= s.len() && s[i..i + from.len()] == from is
            sb.push(to)
            i += from.len()
        else
            sb.push(str_from_byte(byte_at(s, i)))
            i += 1
        end
    end
    return sb.build()
end

pub fn sort_strs(xs: [string]) -> [string] is
    let mut out: [string] = []
    for x in xs is
        out.push(x)
    end
    let mut i: int = 1
    while i < out.len() is
        let cur: string = out[i]
        let mut j: int = i - 1
        while j >= 0 && out[j] > cur is
            out[j + 1] = out[j]
            j -= 1
        end
        out[j + 1] = cur
        i += 1
    end
    return out
end

fn oct3(b: int) -> string is
    let a: int = b / 64
    let c: int = (b / 8) % 8
    let d: int = b % 8
    return to_string(a) + to_string(c) + to_string(d)
end

pub fn cpp_str_lit(s: string) -> string is
    let mut sb = strbuf::new()
    sb.push("\"")
    let mut i: int = 0
    while i < s.len() is
        let b: int = byte_at(s, i)
        if b == 34 is sb.push("\\\"")
        elsif b == 92 is sb.push("\\\\")
        elsif b == 10 is sb.push("\\n")
        elsif b == 13 is sb.push("\\r")
        elsif b == 9 is sb.push("\\t")
        elsif b >= 32 && b <= 126 && b != 63 is sb.push(str_from_byte(b))
        else sb.push("\\" + oct3(b)) end
        i += 1
    end
    sb.push("\"")
    return sb.build()
end

