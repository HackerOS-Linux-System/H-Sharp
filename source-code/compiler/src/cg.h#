    return ["alignas","alignof","and","and_eq","asm","auto","bitand","bitor","bool","break","case","catch","char",
        "class","compl","const","constexpr","const_cast","continue","decltype","default","delete","do","double",
        "dynamic_cast","else","enum","explicit","export","extern","false","float","for","friend","goto","if",
        "inline","int","long","mutable","namespace","new","noexcept","not","not_eq","nullptr","operator","or",
        "or_eq","private","protected","public","register","reinterpret_cast","return","short","signed","sizeof",
        "static","static_assert","static_cast","struct","switch","template","this","thread_local","throw","true",
        "try","typedef","typeid","typename","union","unsigned","using","virtual","void","volatile","while","xor",
        "xor_eq","NULL","EOF","stdin","stdout","stderr","errno","hs","std","main","unix","linux","major","minor",
        "assert","signbit","isnan","isinf","self_","tag","eq_","set_","Str","Any","Arr","Opt","Nil","nil"]
end

pub fn kw(n: string) -> string is
    if in_list(reserved(), n) || has_prefix(n, "hs_") || has_prefix(n, "f_") || has_prefix(n, "T_") || has_prefix(n, "Tp_") || has_prefix(n, "_") is
        let mut i: int = 0
        while i < n.len() && byte_at(n, i) == 95 is i += 1 end
        let mut r: string = replace_all(n[i..n.len()] + "_", "__", "_")
        if has_prefix(n, "_") is r = r + "u" end
        return r
    end
    return n
end

pub fn fname(n: string) -> string is return "f_" + n end
pub fn tname(n: string) -> string is return "T_" + n end

