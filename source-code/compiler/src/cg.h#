;; `x.method(args)` on a built-in receiver that is really a free builtin
pub fn method_as_builtin(m: string) -> string is
    if m == "to_upper" || m == "upper" is return "string_upper" end
    if m == "to_lower" || m == "lower" is return "string_lower" end
    if m == "trim" is return "trim" end
    if m == "trim_start" is return "string_trim_start" end
    if m == "trim_end" is return "string_trim_right" end
    if m == "split" is return "str_split" end
    if m == "replace_all" is return "string_replace_all" end
    if m == "replace" is return "string_replace" end
    if m == "chars" is return "string_chars" end
    if m == "join" is return "str_join" end
    return ""
end

;; registry symbol that really exists in the C runtime ("" when none)
pub fn registry_symbol(name: string) -> string is
    let idx: int = builtins::find(name)
    if idx < 0 is return "" end
    let s: string = builtins::spec_c_symbol(idx)
    if s == "" is return "" end
    if in_list(builtin_syms_table::rt_symbols(), s) is return s end
    return ""
end

pub fn resolve_builtin(n: string) -> string is
    if registry_symbol(n) != "" is return n end
    if has_prefix(n, "__builtin_") is
        let r: string = builtins::resolve_builtin_dunder_llvm(n)
        if r != "" is return r end
    end
    return n
end

pub fn builtin_known(g: Gen, n: string) -> bool is
    if g.bknown.has(n) is return g.bknown.get(n).unwrap_or("") == "1" end
    let r: string = resolve_builtin(n)
    let known: bool = g.hand.has(r) || registry_symbol(r) != "" || builtins::legacy_symbol(r) != ""
    if known is g.bknown.put(n, "1") else g.bknown.put(n, "0") end
    return known
end

;; cached `resolve_builtin`
pub fn resolve_builtin_c(g: Gen, n: string) -> string is
    if g.bres.has(n) is return g.bres.get(n).unwrap_or(n) end
    let r: string = resolve_builtin(n)
    g.bres.put(n, r)
    return r
end

;; is there a user-defined method called `m`? (set built once, on first use)
pub fn user_method_exists(g: Gen, m: string) -> bool is
    if !g.um_ready is
        for k in g.fns.key_list() is
            let s: FnSig = g.fns.get(k).unwrap_or(g.esig)
            if s.is_method is g.um.add(s.method_name) end
        end
        g.um_ready = true
    end
    return g.um.has(m)
end

;; ── errors ────────────────────────────────────────────────────────────────────
pub fn fail_at(g: Gen, n: ast::Node, msg: string) is
    if g.err == "" is g.err = "{n.fl}:{n.sl}:{n.sc}: {msg}" end
end

pub fn fail_raw(g: Gen, msg: string) is
    if g.err == "" is g.err = msg end
end

pub fn tmp(g: Gen, p: string) -> string is
    g.uniq += 1
    return "_{p}{g.uniq}"
end

pub fn loc(n: ast::Node) -> string is
    return cpp_str_lit("{n.fl}:{n.sl}")
end

;; ── type mapping ──────────────────────────────────────────────────────────────
pub fn tparam_has(g: Gen, n: string) -> bool is
    return in_list(g.tparams, n)
end

pub fn template_hdr(gens: [string]) -> string is
    if gens.len() == 0 is return "" end
    let mut ps: [string] = []
    for x in gens is ps.push("class Tp_" + x) end
    return "template<" + join_with(ps, ", ") + "> "
end

;; A type written without its module prefix (`SatResult<int>` inside module `job`, while the enum lives in module
;; `types` and is registered as `types_SatResult`): `rename_type` only prefixes types local to the module, so
;; resolve by unique `_Name` suffix, the same way `resolve_enum` does for variants. "" = not found / ambiguous.
pub fn resolve_type_name(g: Gen, n: string) -> string is
    if g.structs.has(n) || g.enums.has(n) is return n end
    let suffix: string = "_" + n
    let mut found: string = ""
    let mut count: int = 0
    for k in g.enums.key_list() is
        if has_suffix(k, suffix) is
            count += 1
            found = k
        end
    end
    for k in g.structs.key_list() is
        if has_suffix(k, suffix) is
            count += 1
            found = k
        end
    end
    if count == 1 is return found end
    return ""
end

pub fn ty(g: Gen, t: ast::Node) -> string is
    let tag: string = t.tag
    if tag == "Named" is return named_ty(g, t.text, 0) end
    if tag == "Generic" is
        let n: string = t.text
        if g.structs.has(n) || g.enums.has(n) is
            let mut a: [string] = []
            for x in t.kids is a.push(ty(g, x)) end
            return tname(n) + "<" + join_with(a, ", ") + ">*"
        end
        if g.aliases.has(n) is return ty(g, g.aliases.get(n).unwrap_or(ast::nn())) end
        let rn: string = resolve_type_name(g, n)
        if rn != "" && !tparam_has(g, n) is
            let mut a2: [string] = []
            for x in t.kids is a2.push(ty(g, x)) end
            return tname(rn) + "<" + join_with(a2, ", ") + ">*"
        end
        return "hs::Any"
    end
    if tag == "Array" is return "hs::Arr<" + ty(g, t.kids[0]) + ">" end
    if tag == "Tuple" is
        let mut a: [string] = []
        for x in t.kids is a.push(ty(g, x)) end
        return "std::tuple<" + join_with(a, ", ") + ">"
    end
    if tag == "Fn" is
        let mut a: [string] = []
        for x in t.kids[0].kids is a.push(ty(g, x)) end
        return "hs::Fn<" + ty(g, t.kids[1]) + "(" + join_with(a, ", ") + ")>"
    end
    if tag == "Optional" is return "hs::Opt<" + ty(g, t.kids[0]) + ">" end
    if tag == "Ref" || tag == "RefMut" is return ty(g, t.kids[0]) end
    if tag == "Void" is return "void" end
    return "hs::Any"
end

pub fn named_ty(g: Gen, n: string, depth: int) -> string is
    if n == "int" || n == "i64" || n == "i128" is return "int64_t" end
    if n == "uint" || n == "u64" || n == "u128" is return "uint64_t" end
    if n == "i8" is return "int8_t" end
    if n == "i16" is return "int16_t" end
    if n == "i32" is return "int32_t" end
    if n == "u8" is return "uint8_t" end
    if n == "u16" is return "uint16_t" end
    if n == "u32" is return "uint32_t" end
    if n == "f64" is return "double" end
    if n == "f32" is return "float" end
    if n == "bool" is return "bool" end
    if n == "string" is return "hs::Str" end
    if n == "bytes" is return "hs::Bytes" end
    if n == "any" is return "hs::Any" end
    if n == "void" is return "void" end
    if tparam_has(g, n) is return "Tp_" + n end
    if g.aliases.has(n) && depth < 8 is
        let al: ast::Node = g.aliases.get(n).unwrap_or(ast::nn())
        if al.tag == "Named" is return named_ty(g, al.text, depth + 1) end
        return ty(g, al)
    end
    if g.structs.has(n) is
        let si: StructInfo = g.structs.get(n).unwrap_or(StructInfo { params: [], fields: [] })
        if si.params.len() == 0 is return tname(n) + "*" end
        let mut a: [string] = []
        for x in si.params is a.push("hs::Any") end
        return tname(n) + "<" + join_with(a, ", ") + ">*"
    end
    if g.enums.has(n) is
        let ei: EnumInfo = g.enums.get(n).unwrap_or(EnumInfo { params: [], variants: [] })
        if ei.params.len() == 0 is return tname(n) + "*" end
        let mut a: [string] = []
        for x in ei.params is a.push("hs::Any") end
        return tname(n) + "<" + join_with(a, ", ") + ">*"
    end
    if depth < 8 && !tparam_has(g, n) is
        let rn: string = resolve_type_name(g, n)
        if rn != "" && rn != n is return named_ty(g, rn, depth + 1) end
    end
    return "hs::Any"
end

pub fn is_none(t: ast::Node) -> bool is return t.tag == "None" end

pub fn ret_ty(g: Gen, t: ast::Node) -> string is
    if is_none(t) is return "void" end
    return ty(g, t)
end

;; C ABI type of an `extern` parameter/return
pub fn c_abi_ty(t: ast::Node) -> string is
    let n: string = t.text
    if t.tag == "Void" is return "void" end
    if t.tag != "Named" is return "int64_t" end
    if n == "string" || n == "bytes" is return "const char*" end
    if n == "f64" is return "double" end
    if n == "f32" is return "float" end
    if n == "bool" || n == "i8" || n == "u8" is return "int8_t" end
    if n == "i16" || n == "u16" is return "int16_t" end
    if n == "i32" || n == "u32" is return "int32_t" end
    return "int64_t"
end

;; ── enum variants ─────────────────────────────────────────────────────────────
pub struct VarRef is
    pub ok: bool
    pub en: string
    pub idx: int
end

pub fn no_var() -> VarRef is return VarRef { ok: false, en: "", idx: 0 } end

pub fn variant_index(e: EnumInfo, name: string) -> int is
    let mut i: int = 0
    while i < e.variants.len() is
        if e.variants[i].text == name is return i end
        i += 1
    end
    return -1
end

pub fn variant_is_unit(v: ast::Node) -> bool is return v.kids[0].tag == "Unit" end

pub fn is_unit_enum_variant(g: Gen, name: string) -> VarRef is
    if !g.variant_owner.has(name) is return no_var() end
    let owners: [string] = g.variant_owner.get(name).unwrap_or([])
    for o in owners is
        let e: EnumInfo = g.enums.get(o).unwrap_or(EnumInfo { params: [], variants: [] })
        let i: int = variant_index(e, name)
        if i >= 0 && variant_is_unit(e.variants[i]) is return VarRef { ok: true, en: o, idx: i } end
    end
    return no_var()
end

;; enum named `q`, tolerating module mangling (`Option` -> `option_Option`); "" when none / ambiguous
pub fn resolve_enum(g: Gen, q: string) -> string is
    if g.enums.has(q) is return q end
    let suffix: string = "_" + q
    let mut found: string = ""
    let mut count: int = 0
    for k in g.enums.key_list() is
        if has_suffix(k, suffix) is
            count += 1
            found = k
        end
    end
    if count == 1 is return found end
    return ""
end

;; Like `resolve_enum`, but honours the module qualifier of a path (`db::InstallReason`): two modules may each define an
;; enum with the same name (`pkg/db.h#` and `libhammer/lhdb.h#` both have `InstallReason`), and the last segment alone is
;; then ambiguous. The whole qualifier, joined with `_`, is matched exactly or as a unique `_` suffix of the mangled name.
pub fn resolve_enum_qual(g: Gen, qual: string) -> string is
    let last: string = rsplit_last(qual)
    if last != qual is
        let full: string = replace_all(qual, "::", "_")
        if g.enums.has(full) is return full end
        let suffix: string = "_" + full
        let mut found: string = ""
        let mut count: int = 0
        for k in g.enums.key_list() is
            if has_suffix(k, suffix) is
                count += 1
                found = k
            end
        end
        if count == 1 is return found end
    end
    return resolve_enum(g, last)
end

pub fn find_variant(g: Gen, qual: string, has_q: bool, variant: string) -> VarRef is
    if has_q is
        let en: string = resolve_enum_qual(g, qual)
        if en != "" is
            let i: int = variant_index(g.enums.get(en).unwrap_or(EnumInfo { params: [], variants: [] }), variant)
            if i >= 0 is return VarRef { ok: true, en: en, idx: i } end
        end
    end
    if !g.variant_owner.has(variant) is return no_var() end
    let owners: [string] = g.variant_owner.get(variant).unwrap_or([])
    if owners.len() == 0 is return no_var() end
    let o: string = owners[0]
    let i: int = variant_index(g.enums.get(o).unwrap_or(EnumInfo { params: [], variants: [] }), variant)
    if i < 0 is return no_var() end
    return VarRef { ok: true, en: o, idx: i }
end

;; ── scopes ────────────────────────────────────────────────────────────────────
pub fn push_scope(g: Gen) is
    let a: map::Map<string, string> = map::Map::new()
    let b: map::Map<string, ast::Node> = map::Map::new()
    g.scopes.push(a)
    g.var_tys.push(b)
end

pub fn pop_scope(g: Gen) is
    let mut s: [map::Map<string, string>] = []
    let mut t: [map::Map<string, ast::Node>] = []
    let mut i: int = 0
    while i + 1 < g.scopes.len() is
        s.push(g.scopes[i])
        t.push(g.var_tys[i])
        i += 1
    end
    g.scopes = s
    g.var_tys = t
end

;; declare `name` (type node or `None`), returns the C++ identifier
pub fn declare(g: Gen, name: string, t: ast::Node) -> string is
    let base: string = kw(name)
    let mut c: string = base
    let mut n: int = 0
    while g.declared.has(c) is
        n += 1
        c = base + "__" + to_string(n)
    end
    g.declared.add(c)
    g.scopes[g.scopes.len() - 1].put(name, c)
    if !is_none(t) is g.var_tys[g.var_tys.len() - 1].put(name, t) end
    return c
end

;; "" when `name` is not a local
pub fn lookup(g: Gen, name: string) -> string is
    let mut i: int = g.scopes.len() - 1
    while i >= 0 is
        if g.scopes[i].has(name) is return g.scopes[i].get(name).unwrap_or("") end
        i -= 1
    end
    return ""
end

pub fn lookup_ty(g: Gen, name: string) -> ast::Node is
    let mut i: int = g.scopes.len() - 1
    while i >= 0 is
        if g.scopes[i].has(name) is
            return g.var_tys[i].get(name).unwrap_or(ast::nn())
        end
        i -= 1
    end
    return ast::nn()
end

;; ── type-expression substitution ──────────────────────────────────────────────
pub fn subst_self(t: ast::Node, self_ty: ast::Node) -> ast::Node is
    let tag: string = t.tag
    if tag == "Named" && t.text == "Self" is return self_ty end
    if tag == "Generic" || tag == "Array" || tag == "Tuple" || tag == "Optional" || tag == "Ref" || tag == "RefMut" is
        let mut ks: [ast::Node] = []
        for k in t.kids is ks.push(subst_self(k, self_ty)) end
        return clone_with(t, ks)
    end
    if tag == "Fn" is
        let mut ps: [ast::Node] = []
        for k in t.kids[0].kids is ps.push(subst_self(k, self_ty)) end
        return clone_with(t, [clone_with(t.kids[0], ps), subst_self(t.kids[1], self_ty)])
    end
    return t
end

pub fn subst_params(t: ast::Node, params: [string], args: [ast::Node]) -> ast::Node is
    let tag: string = t.tag
    if tag == "Named" is
        let mut i: int = 0
        while i < params.len() is
            if params[i] == t.text is
                if i < args.len() is return args[i] end
                return t
            end
            i += 1
        end
        return t
    end
    if tag == "Generic" || tag == "Array" || tag == "Tuple" || tag == "Optional" || tag == "Ref" || tag == "RefMut" is
        let mut ks: [ast::Node] = []
        for k in t.kids is ks.push(subst_params(k, params, args)) end
        return clone_with(t, ks)
    end
    if tag == "Fn" is
        let mut ps: [ast::Node] = []
        for k in t.kids[0].kids is ps.push(subst_params(k, params, args)) end
        return clone_with(t, [clone_with(t.kids[0], ps), subst_params(t.kids[1], params, args)])
    end
    return t
end

;; shallow copy of `n` with new kids
pub fn clone_with(n: ast::Node, ks: [ast::Node]) -> ast::Node is
    return ast::Node { tag: n.tag, text: n.text, kids: ks, sp: n.sp, sl: n.sl, sc: n.sc, so: n.so, el: n.el, ec: n.ec, eo: n.eo, ip: n.ip, fl: n.fl }
end

pub fn deep_clone(n: ast::Node) -> ast::Node is
    let mut ks: [ast::Node] = []
    for k in n.kids is ks.push(deep_clone(k)) end
    return clone_with(n, ks)
end

;; ── always_returns / yields_value (typecheck helpers mirrored by cppgen) ───────
pub fn always_returns(stmts: [ast::Node]) -> bool is
    if stmts.len() == 0 is return false end
    let last: ast::Node = stmts[stmts.len() - 1]
    if last.tag == "Return" is return true end
    if last.tag != "ExprStmt" is return false end
    let e: ast::Node = last.kids[0]
    if e.tag == "ReturnE" is return true end
    if e.tag == "If" is
        if is_none(e.kids[3]) is return false end
        if !always_returns(e.kids[1].kids) is return false end
        for el in e.kids[2].kids is
            if !always_returns(el.kids[1].kids) is return false end
        end
        return always_returns(e.kids[3].kids)
    end
    if e.tag == "Match" is
        let arms: [ast::Node] = e.kids[1].kids
        if arms.len() == 0 is return false end
        for a in arms is
            if !always_returns(a.kids[2].kids) is return false end
        end
        return true
    end
    if e.tag == "Unsafe" is return always_returns(e.kids[0].kids) end
    return false
end

fn branch_ok(b: [ast::Node]) -> bool is
    return always_returns(b) || yields_value(b)
end

pub fn yields_value(stmts: [ast::Node]) -> bool is
    if stmts.len() == 0 is return false end
    let last: ast::Node = stmts[stmts.len() - 1]
    if last.tag != "ExprStmt" is return false end
    let e: ast::Node = last.kids[0]
    let t: string = e.tag
    if t == "If" is
        if is_none(e.kids[3]) is return false end
        if !branch_ok(e.kids[1].kids) is return false end
        for el in e.kids[2].kids is
            if !branch_ok(el.kids[1].kids) is return false end
        end
        return branch_ok(e.kids[3].kids)
    end
    if t == "Match" is
        let arms: [ast::Node] = e.kids[1].kids
        if arms.len() == 0 is return false end
        for a in arms is
            if !branch_ok(a.kids[2].kids) is return false end
        end
        return true
    end
    if t == "Do" is return branch_ok(e.kids[0].kids) end
    if t == "Unsafe" is return branch_ok(e.kids[0].kids) end
    if t == "While" || t == "For" || t == "Assign" || t == "CompoundAssign" || t == "ReturnE" is return false end
    return true
end

pub fn is_stmt_expr(e: ast::Node) -> bool is
    let t: string = e.tag
    return t == "While" || t == "For" || t == "Assign" || t == "CompoundAssign" || t == "ReturnE"
end

pub fn is_value_expr(e: ast::Node) -> bool is return !is_stmt_expr(e) end

;; ── registry-backed builtin wrapper return types ──────────────────────────────
pub fn htype_cpp_text(s: string) -> string is
    if s == "Str" || s == "string" is return "hs::Str" end
    if s == "Int" || s == "int" || s == "i64" || s == "i128" || s == "Int64" is return "int64_t" end
    if s == "Uint" || s == "uint" || s == "u64" || s == "u128" is return "uint64_t" end
    if s == "I8" || s == "i8" is return "int8_t" end
    if s == "I16" || s == "i16" is return "int16_t" end
    if s == "I32" || s == "i32" is return "int32_t" end
    if s == "U8" || s == "u8" is return "uint8_t" end
    if s == "U16" || s == "u16" is return "uint16_t" end
    if s == "U32" || s == "u32" is return "uint32_t" end
    if s == "F32" || s == "HType::F32" || s == "f32" is return "float" end
    if s == "F64" || s == "HType::F64" || s == "f64" is return "double" end
    if s == "Bool" || s == "bool" is return "bool" end
    if s == "Bytes" || s == "bytes" is return "hs::Bytes" end
    if s == "Void" || s == "void" is return "void" end
    if s.len() > 2 && byte_at(s, 0) == 91 && byte_at(s, s.len() - 1) == 93 is
        return "hs::Arr<" + htype_cpp_text(s[1..s.len() - 1]) + ">"
    end
    if s.len() > 1 && byte_at(s, s.len() - 1) == 63 is
        return "hs::Opt<" + htype_cpp_text(s[0..s.len() - 1]) + ">"
    end
    return "hs::Any"
end

pub fn jc(xs: [string]) -> string is return join_with(xs, ", ") end
pub fn ja(xs: [string]) -> string is return join_with(xs, " && ") end
pub fn jsp(xs: [string]) -> string is return join_with(xs, " ") end
pub fn jcc(xs: [string]) -> string is return join_with(xs, "::") end

;; split on a multi-byte separator
pub fn split_on_str(s: string, sep: string) -> [string] is
    let mut out: [string] = []
    let mut cur: string = ""
    let mut i: int = 0
    while i < s.len() is
        if i + sep.len() <= s.len() && s[i..i + sep.len()] == sep is
            out.push(cur)
            cur = ""
            i += sep.len()
        else
            cur = cur + str_from_byte(byte_at(s, i))
            i += 1
        end
    end
    out.push(cur)
    return out
end
