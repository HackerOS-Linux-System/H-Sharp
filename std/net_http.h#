use "std -> http" from "http"

pub fn get(url: string) -> http::Response is
    return http::get_full(url)
end

;; NOT IMPLEMENTED — headers on outgoing requests aren't supported by
;; the backend yet; this currently just ignores `headers` and issues a
;; plain GET rather than silently pretending they were sent.
pub fn get_with_headers(url: string, headers: any) -> http::Response is
    return get(url)
end

pub fn post(url: string, body: string) -> http::Response is
    return http::post_full(url, body)
end

