pub fn xor_hex(a: string, b: string) -> string is
    return __builtin_hex_xor(a, b)
end

pub fn rot13(s: string) -> string is
    return caesar(s, 13)
end

;; Caesar-shift ASCII letters by `shift` positions, wrapping within
;; their case; non-letters pass through unchanged.
pub fn caesar(s: string, shift: int) -> string is
    let mut out = ""
    let mut i = 0
    while i < s.len() is
        let c = s[i..i+1]
        let code = __builtin_str_to_char_code(c)
        let mut new_code = code
        if code >= 65 && code <= 90 is
            new_code = 65 + ((code - 65 + shift) % 26 + 26) % 26
        else is
            if code >= 97 && code <= 122 is
                new_code = 97 + ((code - 97 + shift) % 26 + 26) % 26
            end
        end
        out = out + __builtin_char_code_to_str(new_code)
        i += 1
    end
    return out
end

;; FNV-1a 32-bit hash.
pub fn fnv1a(s: string) -> int is
    let mut hash: int = 2166136261
    let mut i = 0
    while i < s.len() is
        let byte = __builtin_str_to_char_code(s[i..i+1])
        hash = (hash % 16777216) ;; keep it in a well-behaved 24-bit-ish
                                   ;; range before the multiply below, so
                                   ;; this stays inside H#'s int range
                                   ;; instead of silently overflowing —
                                   ;; NOT a bitwise-correct 32-bit FNV-1a,
                                   ;; a real, documented deviation from
                                   ;; the spec.
        hash = hash ^ byte
        hash = (hash * 16777619) % 2147483647
        i += 1
    end
    return hash
end

;; Check whether `host:port` accepts a TCP connection within
;; `timeout_ms`. Real implementation via std -> tcp.
pub fn scan_port(host: string, port: int, timeout_ms: int) -> bool is
    return __builtin_tcp_scan_port(host, port, timeout_ms)
end

pub fn hex_encode(data: bytes) -> string is
    return __builtin_hex_encode_bytes(data)
end

pub fn hex_decode(s: string) -> string is
    return __builtin_hex_decode(s)
end
