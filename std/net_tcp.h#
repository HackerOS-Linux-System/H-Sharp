use "std -> tcp" from "tcp"

pub fn connect(host: string, port: int) -> tcp::TcpStream is
    return tcp::connect(host, port)
end

pub fn is_connected(stream: tcp::TcpStream) -> bool is
    return tcp::is_connected(stream)
end

pub fn send(stream: tcp::TcpStream, data: string) -> bool is
    return tcp::send(stream, data)
end

pub fn recv(stream: tcp::TcpStream, size: int) -> string is
    return tcp::recv(stream, size)
end

pub fn close(stream: tcp::TcpStream) is
    tcp::close(stream)
end

pub fn scan_port(host: string, port: int, timeout_ms: int) -> bool is
    return tcp::scan_port(host, port, timeout_ms)
end

pub fn listen(host: string, port: int) -> tcp::TcpStream is
    return tcp::listen(host, port)
end
