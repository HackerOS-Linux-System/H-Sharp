pub fn parse(raw: string) -> string is
    return json_parse(raw)
end

;; Stringify is likewise an identity function for the same reason.
pub fn stringify(val: string) -> string is
    return val
end

pub fn stringify_pretty(val: string, indent: int) -> string is
    return json_stringify_pretty(val)
end

;; Create an empty JSON object: "{}"
pub fn object() -> string is
    return json_empty_object()
end

pub fn empty_object() -> string is
    return json_empty_object()
end

;; Get a string value by key. "" if absent.
pub fn get_str(obj: string, key: string) -> string is
    return json_get_str(obj, key)
end

;; Get an integer value by key. 0 if absent or not a valid integer.
pub fn get_int(obj: string, key: string) -> int is
    return str_to_int(get_str(obj, key))
end

;; Get a float value by key. 0.0 if absent.
;; [FIXED] there is no confirmed LLVM-backed string<->float conversion
;; on this backend (`__builtin_conv_str_to_float` is interpreter-only,
;; and no LLVM-backed replacement is registered) — parsing back out is
;; therefore not reliably available. Kept as an honest 0.0 rather than
;; a conversion that might silently misparse; nothing in HCO's own
;; config/API code round-trips a float through JSON (only ever through
;; its own `.hk`-style config text, or displayed directly, never
;; re-parsed), so this gap doesn't affect it.
pub fn get_float(obj: string, key: string) -> f64 is
    return 0.0
end

;; Get a bool value by key. false if absent — matches "true"/"false"
;; text exactly (the only two values `set_bool` below ever writes).
pub fn get_bool(obj: string, key: string) -> bool is
    return get_str(obj, key) == "true"
end

;; Check if a key exists (and is non-empty — this backend's flat JSON
;; text has no real way to distinguish "absent" from "present but
;; empty string" without a real parser; every writer in this module
;; only ever omits a key by never calling `set_*` for it, so this is
;; accurate for anything actually built with `object()`/`set_*` below).
pub fn has_key(obj: string, key: string) -> bool is
    return get_str(obj, key) != ""
end

;; Set a string value by key (returns the updated JSON text — this
;; backend's flat JSON is immutable text, not a mutable structure, so
;; unlike the old tree-based `set_str` this does NOT mutate `obj` in
;; place; always use the return value: `obj = json::set_str(obj, ...)`.
pub fn set_str(obj: string, key: string, val: string) -> string is
    return json_set_str(obj, key, val)
end

pub fn set_int(obj: string, key: string, val: int) -> string is
    return json_set_str(obj, key, int_to_str(val))
end

pub fn set_bool(obj: string, key: string, val: bool) -> string is
    return json_set_str(obj, key, if val then "true" else "false")
end

pub fn set_float(obj: string, key: string, val: f64) -> string is
    return json_set_str(obj, key, to_string(val))
end

;; ── Array-shaped fields, flattened to a comma-joined string ─────────────────
;; [FIXED] there is no real JSON array support on this backend (see
;; module doc comment) — these two give HCO's config/API code a single,
;; consistent convention for list-shaped fields instead of everyone
;; inventing their own ad hoc delimiter.
pub fn set_str_array(obj: string, key: string, vals: [string]) -> string is
    return set_str(obj, key, iter_join(vals, ","))
end

pub fn get_str_array(obj: string, key: string) -> [string] is
    let raw: string = get_str(obj, key)
    if raw == "" is return [] end
    return str_split(raw, ",")
end
