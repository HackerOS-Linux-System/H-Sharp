;; Real (if simple) hostname syntax check — labels of letters/digits/
;; hyphens, 1-63 chars each, joined by dots. Doesn't verify the domain
;; actually resolves; use `resolve` for that.
pub fn is_valid_domain(domain: string) -> bool is
    if domain == "" || domain.len() > 253 is return false end
    let labels = __builtin_str_split(domain, ".")
    if labels.len() < 2 is return false end
    let mut i = 0
    while i < labels.len() is
        if !is_valid_label(labels[i]) is return false end
        i += 1
    end
    return true
end

fn is_valid_label(label: string) -> bool is
    if label.len() == 0 || label.len() > 63 is return false end
    let mut i = 0
    while i < label.len() is
        let c = label[i..i+1]
        let ok = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "-"
        if !ok is return false end
        i += 1
    end
    return true
end

pub fn cidr_contains(cidr: string, ip: string) -> bool is
    return ip::cidr_network(cidr) == ip::cidr_network(ip + "/" + cidr_prefix(cidr))
end

fn cidr_prefix(cidr: string) -> string is
    let parts = __builtin_str_split(cidr, "/")
    if parts.len() != 2 is return "32" end
    return parts[1]
end
