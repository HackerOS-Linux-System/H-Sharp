use "std -> net -> ip" from "ip"

pub fn resolve(hostname: string) -> string is
    let all = resolve_all(hostname)
    if all.len() == 0 is return "" end
    return all[0]
end

pub fn resolve_all(hostname: string) -> [string] is
    let out = __builtin_process_run("getent hosts " + hostname + " 2>/dev/null | awk '{print $1}'")
    let lines = __builtin_str_split(__builtin_str_trim(out), "\n")
    let mut result: [string] = []
    let mut i = 0
    while i < lines.len() is
        if lines[i] != "" is result.push(lines[i]) end
        i += 1
    end
    return result
end

pub fn reverse_lookup(ip: string) -> string is
    let out = __builtin_process_run("getent hosts " + ip + " 2>/dev/null | awk '{print $2}'")
    return __builtin_str_trim(out)
end

