pub fn get(key: string) -> string is
    return __builtin_env_get(key)
end

;; Get an environment variable, or `default` if it's unset/empty.
pub fn get_or(key: string, default: string) -> string is
    let v = get(key)
    if v == "" is return default end
    return v
end

;; Set an environment variable for this process (and anything it
;; spawns afterwards). Does not affect the parent shell.
pub fn set(key: string, val: string) is
    __builtin_env_set(key, val)
end

;; Remove an environment variable.
;; [FIXED] `__builtin_env_remove` is interpreter-only on the LLVM
;; (`--release`) backend, and there's no real `unsetenv`-equivalent
;; builtin to fall back to there. Setting the value to "" is not
;; identical to a true unset (the key still exists, just empty) but is
;; the closest available approximation that doesn't require new C
;; runtime code this environment has no way to verify; every caller in
;; this codebase treats "" and "unset" the same way regardless (see
;; `get_or`/`get` above, which never distinguish the two).
pub fn remove(key: string) is
    __builtin_env_set(key, "")
end

;; Command-line arguments this program was invoked with, including
;; argv[0] (the program path itself) as the first element.
pub fn args() -> [string] is
    return __builtin_env_args()
end

;; All environment variables as ["KEY=value", ...].
;; [FIXED] `__builtin_env_vars` is interpreter-only, and enumerating the
;; whole environment (walking `environ[]`) has no existing LLVM-backed
;; equivalent to build on top of — unlike `remove`/`temp_dir`/`home`
;; above, there's no already-working primitive this can be assembled
;; from. Returns empty rather than silently lying with partial data;
;; nothing in this codebase currently calls this.
pub fn vars() -> [string] is
    return []
end

;; The system temp directory (e.g. /tmp).
;; [FIXED] `__builtin_env_temp_dir` is interpreter-only, but this needs
;; no special runtime support at all: `TMPDIR` is the POSIX-standard way
;; a temp directory override is communicated, and `/tmp` is the
;; universal default when it's unset — exactly what real temp-dir
;; lookups (e.g. Rust's `std::env::temp_dir()`) do first anyway.
pub fn temp_dir() -> string is
    return get_or("TMPDIR", "/tmp")
end

;; The current user's home directory.
;; [FIXED] `__builtin_env_home` is interpreter-only, but `HOME` is the
;; POSIX-standard env var carrying exactly this, already readable
;; through the (LLVM-backed) `get()` above — no approximation needed.
pub fn home() -> string is
    return get("HOME")
end
