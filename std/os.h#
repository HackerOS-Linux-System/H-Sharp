pub fn platform() -> string is
    return __builtin_os_platform()
end

;; CPU architecture: "x86_64", "aarch64", ...
pub fn arch() -> string is
    return __builtin_os_arch()
end

;; Machine hostname (read from /etc/hostname on Linux).
pub fn hostname() -> string is
    return __builtin_os_hostname()
end

;; Current user's login name ($USER / $LOGNAME).
pub fn username() -> string is
    return __builtin_os_username()
end

;; Current user's home directory.
pub fn home_dir() -> string is
    return __builtin_os_home_dir()
end

;; System temp directory.
pub fn temp_dir() -> string is
    return __builtin_os_temp_dir()
end

;; This process's PID.
pub fn pid() -> int is
    return __builtin_os_pid()
end

;; Whether this process is running as root (uid 0).
pub fn is_root() -> bool is
    return __builtin_os_is_root()
end

;; Kernel release string (`uname -r`).
pub fn kernel_version() -> string is
    return __builtin_os_kernel_version()
end
