use "std -> collections" from "col"

pub fn parse(data: string) -> any is
    let lines = __builtin_str_split(data, "\n")
    let mut map = col::hashmap_new()
    let mut i = 0
    while i < lines.len() is
        let raw = lines[i]
        i += 1
        let line = strings_trim(raw)
        if line == "" || line[0..1] == "#" || line == "---" is continue end
        let colon = __builtin_str_index_of(line, ":")
        if colon < 0 is continue end
        let key = strings_trim(line[0..colon])
        let mut val = strings_trim(line[colon + 1..line.len()])
        val = unquote(val)
        map = col::hashmap_insert(map, key, val)
    end
    return map
end

fn unquote(s: string) -> string is
    if s.len() >= 2 is
        let first = s[0..1]
        let last = s[s.len()-1..s.len()]
        if (first == "\"" && last == "\"") || (first == "'" && last == "'") is
            return s[1..s.len()-1]
        end
    end
    return s
end

pub fn get(parsed: any, key: string) -> string is
    let v = col::hashmap_get(parsed, key)
    if v == nil is return "" end
    return v
end

pub fn get_int(parsed: any, key: string) -> int is
    return __builtin_conv_str_to_int(get(parsed, key))
end

pub fn get_bool(parsed: any, key: string) -> bool is
    let v = get(parsed, key)
    return v == "true" || v == "yes"
end

pub fn has(parsed: any, key: string) -> bool is
    return col::hashmap_contains(parsed, key)
end

;; Serialize a flat key/value hashmap back to simple `key: value` YAML.
pub fn to_string_yaml(parsed: any) -> string is
    let keys = col::hashmap_keys(parsed)
    let mut out = ""
    let mut i = 0
    while i < keys.len() is
        out = out + keys[i] + ": " + get(parsed, keys[i]) + "\n"
        i += 1
    end
    return out
end

fn strings_trim(s: string) -> string is return __builtin_str_trim(s) end
