fn octets(s: string) -> [int] is
    let parts = __builtin_str_split(s, ".")
    let mut out: [int] = []
    let mut i = 0
    while i < parts.len() is
        out.push(__builtin_conv_str_to_int(parts[i]))
        i += 1
    end
    return out
end

pub fn is_ipv4(s: string) -> bool is
    let parts = octets(s)
    if parts.len() != 4 is return false end
    let mut i = 0
    while i < parts.len() is
        if parts[i] < 0 || parts[i] > 255 is return false end
        i += 1
    end
    return true
end

