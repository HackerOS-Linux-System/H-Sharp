pub fn new_map() -> any is
    return map_new(1) ;; 1 = string keys
end

pub fn hashmap_new() -> any is
    return map_new(1)
end

;; Insert/overwrite a key. [FIXED] `map_set` mutates in place and
;; returns nothing — unlike the old value-type-flavored
;; `__builtin_hashmap_insert`, the map handle (`any`) is an opaque
;; pointer under the hood, so callers that keep the old
;; `map = hashmap_insert(map, k, v)` reassignment pattern still work
;; (the returned handle is the same one), they just no longer need to.
pub fn hashmap_insert(map: any, key: string, val: string) -> any is
    map_set(map, key, val)
    return map
end

pub fn hashmap_get(map: any, key: string) -> string is
    return map_get_str(map, key)
end

pub fn hashmap_contains(map: any, key: string) -> bool is
    return map_has(map, key)
end

pub fn hashmap_remove(map: any, key: string) -> any is
    map_remove(map, key)
    return map
end

pub fn hashmap_len(map: any) -> int is
    return map_len(map)
end

pub fn hashmap_keys(map: any) -> [any] is
    return map_keys(map)
end

;; [FIXED] there is no native "walk all values" in the underlying map
;; (only keys are ever collected — see `hsh_map_keys`'s doc comment in
;; core.c); the old `__builtin_hashmap_values` had no real backing on
;; this target either way. Reconstructed by looking each key back up.
pub fn hashmap_values(map: any) -> [string] is
    let ks: [any] = map_keys(map)
    let mut vs: [string] = []
    let mut i: int = 0
    while i < ks.len() is
        vs.push(map_get_str(map, ks[i]))
        i = i + 1
    end
    return vs
end

;; ── HashMap struct-style sugar (string -> string) ────────────────────────────

struct HashMap is
    pub _inner: any
end

impl HashMap is
    fn new() -> HashMap is
        return HashMap { _inner: new_map() }
    end

    fn insert(self, key: string, val: string) is
        map_set(self._inner, key, val)
    end

    fn get(self, key: string) -> string is
        return map_get_str(self._inner, key)
    end

    fn contains_key(self, key: string) -> bool is
        return map_has(self._inner, key)
    end

    fn remove(self, key: string) is
        map_remove(self._inner, key)
    end

    fn len(self) -> int is
        return map_len(self._inner)
    end

    fn keys(self) -> [any] is
        return map_keys(self._inner)
    end

    fn values(self) -> [string] is
        return hashmap_values(self._inner)
    end

    fn is_empty(self) -> bool is
        return self.len() == 0
    end
end

;; ── HashSet (string members), backed by the same map with a dummy value ─────

struct HashSet is
    pub _inner: any
end

impl HashSet is
    fn new() -> HashSet is
        return HashSet { _inner: map_new(1) }
    end

    fn insert(self, val: string) is
        map_set(self._inner, val, "1")
    end

    fn contains(self, val: string) -> bool is
        return map_has(self._inner, val)
    end

    fn remove(self, val: string) is
        map_remove(self._inner, val)
    end

    fn len(self) -> int is
        return map_len(self._inner)
    end

    fn is_empty(self) -> bool is
        return self.len() == 0
    end

    fn to_array(self) -> [any] is
        return map_keys(self._inner)
    end
end

;; ── Queue (FIFO) — unchanged, already plain array operations ────────────────

struct Queue is
    pub _items: [any]
end

impl Queue is
    fn new() -> Queue is
        return Queue { _items: [] }
    end

    fn push(self, val: any) is
        self._items.push(val)
    end

    fn pop(self) -> any is
        if self._items.len() == 0 is
            return nil
        end
        let val = self._items[0]
        self._items = self._items[1..self._items.len()]
        return val
    end

    fn peek(self) -> any is
        if self._items.len() == 0 is return nil end
        return self._items[0]
    end

    fn len(self) -> int is
        return self._items.len()
    end

    fn is_empty(self) -> bool is
        return self._items.len() == 0
    end
end

;; ── Stack (LIFO) — unchanged, already plain array operations ────────────────

struct Stack is
    pub _items: [any]
end

impl Stack is
    fn new() -> Stack is
        return Stack { _items: [] }
    end

    fn push(self, val: any) is
        self._items.push(val)
    end

    fn pop(self) -> any is
        if self._items.len() == 0 is return nil end
        let last = self._items.len() - 1
        let val  = self._items[last]
        self._items = self._items[0..last]
        return val
    end

    fn peek(self) -> any is
        if self._items.len() == 0 is return nil end
        return self._items[self._items.len() - 1]
    end

    fn len(self) -> int is
        return self._items.len()
    end

    fn is_empty(self) -> bool is
        return self._items.len() == 0
    end
end
