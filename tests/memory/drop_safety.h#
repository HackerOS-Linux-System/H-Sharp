@safety
fn churn(n: int) -> int is
    let tmp: [int] = [1, 2, 3]
    let mut i: int = 0
    while i < 4000 is
        tmp.push(i)
        i += 1
    end
    let mut s: int = 0
    for x in tmp is s += x end
    return s + n
end

;; escapes through `return` -> must NOT be dropped
@safety
fn keeps() -> [int] is
    let out: [int] = [7, 8, 9]
    return out
end

;; passed to a call -> must NOT be dropped
fn sink(v: [int]) -> int is return v.len() end

@safety
fn handed_over() -> int is
    let a: [int] = [1, 2]
    return sink(a)
end

fn main() is
    let mut total: int = 0
    let mut k: int = 0
    while k < 20000 is
        total += churn(k) % 7
        k += 1
    end
    let kept: [int] = keeps()
    println("total={total} kept={kept.len()} handed={handed_over()}")
end
