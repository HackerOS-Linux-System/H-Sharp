struct Box is
    pub items: [int]
end

fn consume(v: [int]) -> int is return v.len() end
fn peek(v: &[int]) -> int is return v.len() end
fn grow(v: &mut [int]) is v.push(1) end
fn pair(a: &mut [int], b: &[int]) is a.push(b.len()) end

fn m001() -> int is
    let a: [int] = [1, 2, 3]
    let b: [int] = a
    return a.len() + b.len()          ;; EXPECT M001 (a)
end

@safety
fn m001_call() -> int is
    let a: [int] = [1, 2, 3]
    let n: int = consume(a)
    return n + a.len()                ;; EXPECT M001 (a moved into consume)
end

@safety
fn borrow_ok() -> int is
    let a: [int] = [1, 2, 3]
    let n: int = peek(&a)
    grow(&mut a)
    return n + a.len()                ;; no warning: only borrowed
end

