use "std -> test" from "test"

#[test]
fn test_passing_assertions_compile_and_run_on_aot() is
    assert_eq(1 + 1, 2)
    assert_ne(1, 2)
    assert_true(true)
    assert_false(false)
    assert_contains("hello world", "world")
    assert_starts_with("hello world", "hello")
    assert_approx(0.1 + 0.2, 0.3, 0.0001)
end

#[test]
fn test_skip_does_not_fail() is
    skip("skip is a note on stderr, not a failure")
end
