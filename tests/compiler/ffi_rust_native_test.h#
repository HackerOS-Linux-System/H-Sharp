use "workspace -> parser" from "lib -> *"
use "workspace -> compiler" from "lib -> *"

fn fns_of(src: string) -> [ast::Node] is
    return parser::parse_source(src).kids[3].kids[0].kids[3].kids
end

fn gen(src: string, idx: int, st: ffi_rust_native::StructTable) -> ffi_rust_native::ShimResult is
    return ffi_rust_native::generate_shim("my-lib", fns_of(src)[idx], st)
end

fn contains(s: string, pat: string) -> bool is
    let n: int = s.len()
    let m: int = pat.len()
    let mut i: int = 0
    while i + m <= n is
        if s[i..i + m] == pat is return true end
        i += 1
    end
    return false
end

#[test]
fn test_simple_add_shim_exact_text() is
    let st: ffi_rust_native::StructTable = ffi_rust_native::new_struct_table()
    let r: ffi_rust_native::ShimResult = gen("extern static [rust, \"l\"] is\n    fn add(a: i32, b: i32) -> i32\nend\n", 0, st)
    assert_eq(r.ok, true)
    let want: string = "// Auto-generated by hsharp's ffi_rust_native shim generator. Do not edit\n// by hand — regenerated on every `hsharp compile` / `bit build` that sees\n// this `extern [rust]` block. See ffi_rust_native.rs for the generator.\nextern crate my_lib as __user;\n\nuse std::panic::{{catch_unwind, AssertUnwindSafe}};\n\n#[no_mangle]\npub extern \"C\" fn hsh_rs_shim_add(a: i32, b: i32) -> i32 {{\n    let __result = catch_unwind(AssertUnwindSafe(|| {{\n        __user::add(a, b)\n    }}));\n\n    match __result {{\n        Ok(__v) => {{\n            return __v;\n        }}\n        Err(_panic_payload) => {{\n            // A Rust panic must never unwind across this `extern \"C\"`\n            // frame into H#'s LLVM-generated code — that's undefined\n            // behavior. Convert it into H#'s sentinel failure value.\n            return Default::default();\n        }}\n    }}\n}}\n"
    assert_eq(r.text, want)
end

#[test]
fn test_string_option_result_and_slice_params() is
    let st: ffi_rust_native::StructTable = ffi_rust_native::new_struct_table()
    let src: string = "extern static [rust, \"l\"] is\n    fn greet(n: string, k: int?) -> Result<string, string>\n    fn total(d: [u8], d_len: int) -> f64\n    fn opt(f: bool?) -> string?\nend\n"
    let g: ffi_rust_native::ShimResult = gen(src, 0, st)
    assert_eq(contains(g.text, "pub extern \"C\" fn hsh_rs_shim_greet(n_ptr: *const std::os::raw::c_char, k: i64) -> *mut std::os::raw::c_char {{"), true)
    assert_eq(contains(g.text, "let k = if k == 0 as i64 {{ None }} else {{ Some(k) }};"), true)
    assert_eq(contains(g.text, "eprintln!(\"extern [rust] call returned Err: {{:?}}\", __e);"), true)
    let t: ffi_rust_native::ShimResult = gen(src, 1, st)
    assert_eq(contains(t.text, "fn hsh_rs_shim_total(d_ptr: *const u8, d_len: i64) -> f64"), true)
    assert_eq(contains(t.text, "std::slice::from_raw_parts(d_ptr, d_len as usize)"), true)
    assert_eq(contains(t.text, "return -1.0 as _;"), true)
    let o: ffi_rust_native::ShimResult = gen(src, 2, st)
    assert_eq(contains(o.text, "let f = if !f {{ None }} else {{ Some(f) }};"), true)
    assert_eq(contains(o.text, "return std::ptr::null_mut();"), true)
end

#[test]
fn test_struct_flattening_param() is
    let st: ffi_rust_native::StructTable = ffi_rust_native::new_struct_table()
    let m: ast::Node = parser::parse_source("struct P is\n    pub x: f64\n    pub n: int\n    pub s: string\n    pub ok: bool\nend\nextern static [rust, \"l\"] is\n    fn take(p: P) -> i64\nend\n")
    ffi_rust_native::add_struct(st, "P", m.kids[3].kids[0].kids[1])
    let r: ffi_rust_native::ShimResult = ffi_rust_native::generate_shim("c", m.kids[3].kids[1].kids[3].kids[0], st)
    assert_eq(r.ok, true)
    assert_eq(contains(r.text, "extern \"C\" {{ fn hsh_struct_get(s: i64, idx: i64) -> i64; }}"), true)
    assert_eq(contains(r.text, "let p_x = f64::from_bits((unsafe {{ hsh_struct_get(p, 0) }}) as u64);"), true)
    assert_eq(contains(r.text, "let p_n = unsafe {{ hsh_struct_get(p, 1) }};"), true)
    assert_eq(contains(r.text, "let p_ok = (unsafe {{ hsh_struct_get(p, 3) }}) != 0;"), true)
    assert_eq(contains(r.text, "let p = __user::P {{ x: p_x, n: p_n, s: p_s, ok: p_ok }};"), true)
    assert_eq(contains(r.text, "fn hsh_rs_shim_take(p: i64) -> i64"), true)
end

#[test]
fn test_rejections_and_free_fn() is
    let st: ffi_rust_native::StructTable = ffi_rust_native::new_struct_table()
    let src: string = "extern static [rust, \"l\"] is\n    fn a(d: [u8]) -> int\n    fn b() -> [int]\n    fn c(x: Foo) -> int\n    fn d() -> Foo\n    fn e() -> Option<[u8]>\n    fn f(r: Result<int, int>) -> int\n    fn g(o: [u8]?) -> int\nend\n"
    for i in [0, 1, 2, 3, 5, 6] is
        assert_eq(gen(src, i, st).ok, false)
    end
    assert_eq(gen(src, 0, st).err, "parameter `d` (&[u8]/Vec<T>) has no bundled length at the ABI level this shim can read on its own — H#'s `bytes`/`Array`/`Slice` are bare pointers. Add a paired `d_len: int` parameter right after it in the `extern` signature (and pass the real length at the call site) so this shim can reconstruct a slice; only element types `is_flat_primitive` recognizes (bool/ints/floats — not nested `Vec`/`String`/opaque types) are supported this way")
    assert_eq(gen(src, 5, st).err, "Result<T, E> parameters are not supported (only Result<T, String> return values are) — Results only make sense as outcomes, not inputs")
    assert_eq(ffi_rust_native::debug(ffi_rust_native::hsh_type_to_rust_native(fns_of(src)[1].kids[1])), "Vec(I64)")
    assert_eq(ffi_rust_native::error_text("x"), "extern [rust]: x")
    assert_eq(contains(ffi_rust_native::generate_free_fn(), "pub extern \"C\" fn hsh_rs_free_string(ptr: *mut std::os::raw::c_char) {{"), true)
end
