fn fns_of(src: string) -> [ast::Node] is
    return parser::parse_source(src).kids[3].kids[0].kids[3].kids
end

fn empty_path(name: string) -> ffi_cpp::CppPath is
    return ffi_cpp::CppPath { namespaces: [], has_class: false, class_name: "", fn_name: name, is_const: false }
end

#[test]
fn test_mangle_basics() is
    let p: ffi_cpp::CppPath = empty_path("add")
    assert_eq(ffi_cpp::mangle(p, [ffi_cpp::prim("i32"), ffi_cpp::prim("u64")]), "_Z3addiy")
    assert_eq(ffi_cpp::mangle(empty_path("f"), []), "_Z1fv")
    let q: ffi_cpp::CppPath = ffi_cpp::CppPath { namespaces: ["a", "bc"], has_class: true, class_name: "K", fn_name: "m", is_const: true }
    assert_eq(ffi_cpp::mangle(q, [ffi_cpp::prim("bool")]), "_ZNK1a2bc1K1mEb")
    ;; substitutions: second identical std::string is S_
    let s: ffi_cpp::CppTy = ffi_cpp::prim("string")
    assert_eq(ffi_cpp::mangle(empty_path("g"), [s, s]), "_Z1gNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEES_")
end

#[test]
fn test_type_mapping() is
    let fs0: [ast::Node] = fns_of("extern dynamic [c++, \"l\"] is\n    fn f(a: [u8], b: string?, c: &Foo, d: &mut i32, e: int, g: bytes) -> void\nend\n")
    let ps: [ast::Node] = fs0[0].kids[0].kids
    assert_eq(ffi_cpp::cpp_type_name(ffi_cpp::hsh_type_to_cpp(ps[0].kids[1])), "std::vector<uint8_t>")
    assert_eq(ffi_cpp::cpp_type_name(ffi_cpp::hsh_type_to_cpp(ps[1].kids[1])), "std::optional<std::string>")
    assert_eq(ffi_cpp::cpp_type_name(ffi_cpp::hsh_type_to_cpp(ps[2].kids[1])), "const Foo&")
    assert_eq(ffi_cpp::cpp_type_name(ffi_cpp::hsh_type_to_cpp(ps[3].kids[1])), "int32_t&")
    assert_eq(ffi_cpp::cpp_type_name(ffi_cpp::hsh_type_to_cpp(ps[4].kids[1])), "int64_t")
    ;; `bytes` is Named("bytes") in the parsed AST -> opaque, like the Rust parser output
    assert_eq(ffi_cpp::hsh_type_to_cpp(ps[5].kids[1]).kind, "opaque")
end

#[test]
fn test_unsupported_signatures_are_rejected() is
    let st: ffi_cpp::StructTable = ffi_cpp::new_struct_table()
    let fs0: [ast::Node] = fns_of("extern dynamic [c++, \"l\"] is\n    fn v(a: [u8]) -> int\n    fn o(a: [u8]?) -> int\n    fn r() -> [int]\n    fn s(x: Foo) -> int\n    fn q() -> Foo\nend\n")
    let r0: ffi_cpp::ShimResult = ffi_cpp::generate_shim(empty_path("v"), fs0[0], st)
    assert_eq(r0.ok, false)
    assert_eq(r0.err, "parameter `a` (std::vector<T>) has no bundled length at the ABI level this shim can read on its own — add a paired `a_len: int` parameter right after it in the `extern` signature (and pass the real length at the call site) so this shim can reconstruct a std::vector; only fixed-width element types (`is_flat_primitive_cpp`) are supported this way")
    assert_eq(ffi_cpp::generate_shim(empty_path("o"), fs0[1], st).ok, false)
    assert_eq(ffi_cpp::generate_shim(empty_path("r"), fs0[2], st).ok, false)
    assert_eq(ffi_cpp::generate_shim(empty_path("s"), fs0[3], st).ok, false)
    assert_eq(ffi_cpp::generate_shim(empty_path("q"), fs0[4], st).ok, false)
    assert_eq(ffi_cpp::error_text("x"), "extern [c++]: x")
end

;; End to end with the real toolchain: shims generated by this port are compiled by g++ together with a real C++
;; library whose symbols they call by their Itanium-mangled names, then the program is run.
#[test]
fn test_shims_link_against_real_cpp_symbols_and_run() is
    let src: string = "extern dynamic [c++, \"lib\"] is\n    fn add(a: i32, b: u64) -> i64\n    fn greet(name: string) -> string\n    fn find(key: string?) -> i32?\n    fn sum(data: [u8], data_len: int) -> u64\n    fn nothing() -> void\nend\n"
    let fs0: [ast::Node] = fns_of(src)
    let st: ffi_cpp::StructTable = ffi_cpp::new_struct_table()
    let mut all: string = ""
    let mut i: int = 0
    while i < fs0.len() is
        let mut p: ffi_cpp::CppPath = empty_path(fs0[i].text)
        if fs0[i].text == "greet" is
            p = ffi_cpp::CppPath { namespaces: ["util"], has_class: false, class_name: "", fn_name: "greet", is_const: false }
        end
        let r: ffi_cpp::ShimResult = ffi_cpp::generate_shim(p, fs0[i], st)
        assert_eq(r.ok, true)
        all = all + r.text + "\n"
        i += 1
    end
    fs::mkdir("/tmp/hs_cppffi")
    fs::write("/tmp/hs_cppffi/shims.cpp", all)
    fs::write("/tmp/hs_cppffi/lib.cpp", "#include <string>\n#include <vector>\n#include <optional>\nlong long add(int a, unsigned long long b) {{ return a + (long long)b; }}\nnamespace util {{ std::string greet(std::string n) {{ return \"hi \" + n; }} }}\nstd::optional<int> find(std::optional<std::string> k) {{ if (k && *k == \"a\") return 7; return std::nullopt; }}\nunsigned long long sum(std::vector<unsigned char> d) {{ unsigned long long s = 0; for (auto x : d) s += x; return s; }}\nvoid nothing() {{}}\n")
    fs::write("/tmp/hs_cppffi/main.cpp", "#include <cstdio>\n#include <cstdint>\nextern \"C\" {{ int64_t hsh_cpp_shim_add(int32_t, uint64_t); const char* hsh_cpp_shim_greet(const char*); int32_t hsh_cpp_shim_find(const char*); uint64_t hsh_cpp_shim_sum(const uint8_t*, int64_t); void hsh_cpp_shim_nothing(); }}\nint main() {{ uint8_t d[4] = {{1,2,3,4}}; printf(\"%lld\\n%s\\n%d\\n%d\\n%llu\\n\", (long long)hsh_cpp_shim_add(2, 3), hsh_cpp_shim_greet(\"bob\"), hsh_cpp_shim_find(\"a\"), hsh_cpp_shim_find(\"zz\"), (unsigned long long)hsh_cpp_shim_sum(d, 4)); hsh_cpp_shim_nothing(); return 0; }}\n")
    let code: int = run_cmd_exec("cd /tmp/hs_cppffi && g++ -std=gnu++17 -w shims.cpp lib.cpp main.cpp -o t 2>&1 && ./t > out.txt", 120)
    assert_eq(code, 0)
    assert_eq(fs::read("/tmp/hs_cppffi/out.txt"), "5\nhi bob\n7\n0\n10\n")
end
