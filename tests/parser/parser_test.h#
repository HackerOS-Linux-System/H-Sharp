use "std -> test" from "test"
use "workspace -> parser" from "lib -> *"


fn eq_s(a: string, b: string) is
    if a != b is
        test::fail("expected `{b}`, got `{a}`")
    end
end

fn ok(src: string) -> parser::ParseResult is
    let r: parser::ParseResult = parser::parse(src, "t.h#")
    if parser::has_errors(r) is
        test::fail("unexpected parse errors: " + parser::render_errors(r))
    end
    return r
end

fn first_fn(r: parser::ParseResult) -> ast::Node is
    for it in r.module.kids[3].kids is
        if it.tag == "Fn" is return it end
    end
    return ast::nn()
end

;; ── lib.rs: qualified module types ────────────────────────────────────────────
#[test]
fn test_qualified_return_type_joins_segments() is
    let r: parser::ParseResult = ok("fn build_git_info_for_prompt() -> git_info::GitInfo is\n    return git_info::git_fetch_info()\nend\n")
    let f: ast::Node = first_fn(r)
    eq_s(f.kids[3].tag, "Named")
    eq_s(f.kids[3].text, "git_info_GitInfo")
end

#[test]
fn test_qualified_return_type_joins_all_segments() is
    let r: parser::ParseResult = ok("fn f() -> a::b::Type is\n    return a::b::make()\nend\n")
    eq_s(first_fn(r).kids[3].text, "a_b_Type")
end

#[test]
fn test_unqualified_return_type_is_unaffected() is
    let r: parser::ParseResult = ok("fn f() -> GitInfo is\n    return GitInfo { branch: \"\" }\nend\n")
    eq_s(first_fn(r).kids[3].text, "GitInfo")
end

#[test]
fn test_qualified_struct_literal_joins_segments() is
    let r: parser::ParseResult = ok("fn f() -> git_info::GitInfo is\n    return git_info::GitInfo { branch: \"\", dirty: false, ahead: 0, behind: 0 }\nend\n")
    let f: ast::Node = first_fn(r)
    eq_s(f.kids[3].text, "git_info_GitInfo")
    eq_s(f.kids[4].kids[0].kids[0].tag, "StructLit")
    eq_s(f.kids[4].kids[0].kids[0].text, "git_info_GitInfo")
end

;; ── lib.rs: bit imports ───────────────────────────────────────────────────────
fn first_import(src: string) -> ast::Node is
    let r: parser::ParseResult = ok(src)
    return r.module.kids[2].kids[0]
end

#[test]
fn test_plain_bit_import() is
    let k: ast::Node = first_import("use \"bit -> mold\"\nfn main() is end\n")
    eq_s(k.text, "BitRepo")
    eq_s(k.kids[0].text, "mold")
    eq_s(k.kids[1].tag, "None")
    eq_s(k.kids[2].tag, "None")
    eq_s(k.kids[3].text, "Static")
end

#[test]
fn test_bit_import_with_alias_and_release_version() is
    let k: ast::Node = first_import("use \"bit -> tui/1.0.2\" from \"t\"\nfn main() is end\n")
    eq_s(k.kids[0].text, "tui")
    eq_s(k.kids[1].text, "1.0.2")
    eq_s(k.kids[2].text, "t")
end

#[test]
fn test_bit_import_with_tag_or_commit_version() is
    let a: ast::Node = first_import("use \"bit -> mold/v1.0\"\nfn main() is end\n")
    eq_s(a.kids[0].text, "mold")
    eq_s(a.kids[1].text, "v1.0")
    let b: ast::Node = first_import("use \"bit -> mold/a1b2c3d4e5f6\"\nfn main() is end\n")
    eq_s(b.kids[1].text, "a1b2c3d4e5f6")
end

#[test]
fn test_dynamic_bit_import() is
    let k: ast::Node = first_import("dynamic use \"bit -> mold\"\nfn main() is end\n")
    eq_s(k.kids[3].text, "Dynamic")
end

