#[test]
fn test_unterminated_multiline_comment_is_an_error_at_its_start() is
    let r: parser::ParseResult = parser::parse("fn main() is\nend\n// never closed\nfn f() is\nend\n", "t.h#")
    test::assert_true(parser::has_errors(r))
    let msg: string = parser::render_errors(r)
    test::assert_contains(msg, "unterminated block comment")
    test::assert_contains(msg, ":3:1")
end

#[test]
fn test_line_numbers_after_a_multiline_comment_are_exact() is
    let r: parser::ParseResult = parser::parse("// line 1\nline 2 \\\\\nfn main() is\n    let x: int = = 1\nend\n", "t.h#")
    test::assert_true(parser::has_errors(r))
    test::assert_contains(parser::render_errors(r), ":4:")
end

;; ── edition.rs ────────────────────────────────────────────────────────────────
#[test]
fn test_parses_known_edition() is
    test::assert_true(edition::parse_edition("2026").ok)
    test::assert_eq(edition::parse_edition(" 2026 ").year, 2026)
end

#[test]
fn test_classifies_bad_editions() is
    eq_s(edition::parse_edition("2099").err.kind, "TooNew")
    eq_s(edition::parse_edition("2015").err.kind, "Retired")
    eq_s(edition::parse_edition("26").err.kind, "Malformed")
    eq_s(edition::parse_edition("latest").err.kind, "Malformed")
    eq_s(edition::parse_edition("").err.kind, "Malformed")
end

#[test]
fn test_edition_error_messages_are_actionable() is
    let e: edition::EditionError = edition::parse_edition("2099").err
    test::assert_contains(edition::edition_error_message(e), "newer")
    let hints: [string] = edition::edition_error_hints(e)
    eq_s(hints[hints.len() - 1], "supported editions: 2026")
    let m: edition::EditionError = edition::parse_edition("abc").err
    test::assert_contains(edition::edition_error_message(m), "four-digit")
end

