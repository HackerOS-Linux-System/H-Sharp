#[test]
fn test_edition_diagnostics_are_recognised() is
    let srcs: [string] = ["using \"2099\"\n", "using \"x\"\n", "using\n", "fn a() is\nend\nusing \"2026\"\n"]
    for src in srcs is
        let r: parser::ParseResult = parser::parse(src, "t.h#")
        test::assert_true(parser::has_errors(r))
        let mut hit: bool = false
        for e in r.errors is
            if edition::is_edition_diagnostic(e.message) is hit = true end
        end
        test::assert_true(hit)
    end
    test::assert_false(edition::is_edition_diagnostic("unexpected token `end`"))
end

#[test]
fn test_features_are_all_available_in_2026() is
    let r: parser::ParseResult = ok("@: arc\nusing \"2026\"\nuse \"std -> math\"\nuse \"bit -> mylib\"\nuse \"hlib -> other\"\nfn main() is\nend\n")
    test::assert_eq(edition::check_features(r.module, 2026).len(), 0)
    let feats: [string] = ["FileMemMode", "StdImport", "BitImport", "HlibImport", "WorkspaceImport"]
    for f in feats is
        test::assert_true(edition::supports(2026, f))
        test::assert_eq(edition::feature_since(f), 2026)
    end
end

#[test]
fn test_default_override_roundtrip() is
    let st: edition::EditionState = edition::new_state()
    edition::set_default_edition(st, 2026)
    test::assert_eq(edition::default_edition(st), 2026)
    edition::reset_default_edition(st)
    test::assert_eq(edition::default_edition(st), edition::latest_year())
end

#[test]
fn test_per_file_default_applies_only_to_undeclared_files() is
    let declared: parser::ParseResult = ok("using \"2026\"\nfn a() is\nend\n")
    let bare: parser::ParseResult = parser::parse_with_default("fn a() is\nend\n", "b.h#", 2026, edition::new_recorder(), edition::new_state())
    test::assert_false(parser::has_errors(bare))
    let st: edition::EditionState = edition::new_state()
    test::assert_eq(edition::effective_edition_with(declared.module, 2026, st), 2026)
    test::assert_eq(edition::effective_edition_with(bare.module, 2026, st), 2026)
    test::assert_eq(edition::std_edition(), 2026)
end

#[test]
fn test_relation_and_recording() is
    eq_s(edition::relate(2026, 2026), "Same")
    eq_s(edition::relate(2026, 2020), "DependencyOlder")
    eq_s(edition::relate(2026, 2030), "DependencyNewer")
    let rec: edition::EditionRecorder = edition::new_recorder()
    edition::start_recording(rec)
    let r: parser::ParseResult = parser::parse_with_default("fn a() is\nend\n", "r.h#", 0, rec, edition::new_state())
    let got: [edition::EditionRecord] = edition::take_records(rec)
    test::assert_eq(got.len(), 1)
    eq_s(got[0].file, "r.h#")
    test::assert_false(got[0].declared)
end

#[test]
fn test_doc_for_line_and_error_reporter() is
    let r: parser::ParseResult = ok("/// Adds two numbers.\nfn add() is\nend\n")
    eq_s(ast::doc_for_line(r.module, 2).text, "Adds two numbers.")
    eq_s(ast::doc_for_line(r.module, 1).tag, "None")
    let rep: error::ErrorReporter = error::new_reporter()
    test::assert_false(error::reporter_has_errors(rep))
    let bad: parser::ParseResult = parser::parse("fn f( is\nend\n", "t.h#")
    for e in bad.errors is error::reporter_report(rep, e) end
    test::assert_true(error::reporter_has_errors(rep))
    test::assert_contains(error::reporter_render_all(rep, "fn f( is\nend\n"), "h#::syntax")
end
