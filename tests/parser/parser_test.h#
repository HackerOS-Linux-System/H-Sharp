;; ── lib.rs: comments ──────────────────────────────────────────────────────────
#[test]
fn test_doc_comments_before_items_are_collected_and_attached() is
    let r: parser::ParseResult = ok("/// Adds two numbers.\n/// Both are ints.\nfn add(a: int, b: int) -> int is\n    return a + b\nend\n\n/// Entry point.\nfn main() is\nend\n")
    let docs: ast::Node = r.module.kids[4]
    test::assert_eq(docs.kids.len(), 2)
    eq_s(docs.kids[0].text, "Adds two numbers.\nBoth are ints.")
    eq_s(docs.kids[0].kids[0].text, "3")
    eq_s(docs.kids[1].text, "Entry point.")
    eq_s(docs.kids[1].kids[0].text, "8")
end

#[test]
fn test_doc_comments_may_sit_on_fields_variants_and_in_bodies() is
